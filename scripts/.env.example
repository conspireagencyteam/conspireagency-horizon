# Copy to scripts/.env and fill in. scripts/.env is gitignored — never commit it.

# Your store's myshopify domain (no protocol, no trailing slash)
SHOPIFY_STORE_URL=store-name.myshopify.com

# Dev Dashboard app credentials (Client ID / Client Secret).
# The script exchanges these for a 24h Admin API token via the
# client-credentials grant — no shpat_ token needed.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Optional overrides:
# Provide a token directly to skip the client-credentials exchange.
# SHOPIFY_ADMIN_TOKEN=
# Pin the Admin API version (otherwise taken from ca-metaobjects-data.json).
# SHOPIFY_API_VERSION=2025-01
