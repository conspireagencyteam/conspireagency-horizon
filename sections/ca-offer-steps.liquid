{%- comment -%}
  ca-offer-steps.liquid - an offer told in numbered steps ("How we start" on the
  Fractional Shopify Teams page).

  Intro (eyebrow left; the offer name at display size, a subheading and a body
  paragraph on the right), then one column per "step" block: the number over a
  hairline, the step title and one line. Then a button. Steps stack below 990px.
  The offer name is a plain text setting, so renaming it is one edit.
{%- endcomment -%}

<div
  class="ca-offer spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | strip | handleize }}"{% endif %}
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    <div class="ca-intro ca-offer__intro" style="--ca-intro-start: 6;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ca-eyebrow ca-intro__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <div class="ca-intro__main ca-offer__main">
        {%- if section.settings.heading != blank -%}
          <h2 class="ca-statement ca-statement--display ca-offer__name">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ca-statement ca-statement--xl ca-offer__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="ca-offer__body">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="ca-offer__steps" style="--ca-offer-count: {{ section.blocks.size | at_most: 4 }};">
        {%- for block in section.blocks -%}
          <li class="ca-offer__step" {{ block.shopify_attributes }}>
            <p class="ca-eyebrow ca-offer__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
            {%- if block.settings.title != blank -%}
              <h3 class="ca-offer__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ca-offer__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ca-offer__cta">
        <a class="{{ section.settings.style_class }} size-style" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}>
          {{- section.settings.button_label -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-offer {
    scroll-margin-top: var(--ca-header-height, 96px);
    background-color: var(--color-background);
  }

  .ca-offer__intro {
    margin-block-end: 80px;
  }

  .ca-offer__main {
    align-items: flex-start;
  }

  .ca-offer__sub {
    text-indent: 0;
  }

  .ca-offer__body {
    font-size: var(--ca-fs-20);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--ca-soft);
  }

  .ca-offer__body > :first-child {
    margin-block-start: 0;
  }

  .ca-offer__body > :last-child {
    margin-block-end: 0;
  }

  .ca-offer__body p + p {
    margin-block-start: 1.2em;
  }

  .ca-offer__steps {
    display: grid;
    grid-template-columns: repeat(var(--ca-offer-count, 4), minmax(0, 1fr));
    gap: 48px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-offer__num {
    margin-block-end: 24px;
    padding-block-end: 16px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  .ca-offer__title {
    margin: 0 0 12px;
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ca-offer__text {
    margin: 0;
    color: var(--ca-soft);
  }

  .ca-offer__cta {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 64px;
  }

  @media screen and (max-width: 989px) {
    .ca-offer__intro {
      margin-block-end: 48px;
    }

    .ca-offer__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ca-offer__cta {
      justify-content: flex-start;
      margin-block-start: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-offer__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Offer steps",
  "tag": "section",
  "class": "ca-offer-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "Optional. Lets links jump here." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How we start" },
    { "type": "text", "id": "heading", "label": "Offer name", "default": "Month One" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a Call" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" }
      ],
      "default": "button"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Connect" },
        { "type": "text", "id": "text", "label": "Line" }
      ]
    }
  ],
  "presets": [
    { "name": "Offer steps", "category": "Conspire", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
