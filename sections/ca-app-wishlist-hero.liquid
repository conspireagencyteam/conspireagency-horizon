{%- comment -%}
  ca-app-wishlist-hero.liquid — app page hero: eyebrow, H1, lede, three CTAs
  (Install / Documentation / Watch the tour), proof line, tour thumbnail that
  links to YouTube. Dark by default; optional faint background photo.
{%- endcomment -%}
<div
  class="ca-wlhero spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id -%}
  {%- if section.settings.background_image != blank -%}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '1200, 1800, 2400', sizes: '100vw', alt: '', loading: 'eager', class: 'ca-wlhero__bg', aria-hidden: 'true' }}
  {%- endif -%}
  <div class="ca-inner ca-wlhero__grid">
    <div class="ca-wlhero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="ca-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="ca-wlhero__h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="ca-wlhero__lede">{{ section.settings.text }}</div>{%- endif -%}
      <div class="ca-wlhero__actions">
        {%- if section.settings.primary_link != blank -%}<a class="button size-style" href="{{ section.settings.primary_link }}" target="_blank" rel="noopener">{{ section.settings.primary_label }}</a>{%- endif -%}
        {%- if section.settings.secondary_link != blank -%}<a class="button-secondary size-style" href="{{ section.settings.secondary_link }}" target="_blank" rel="noopener">{{ section.settings.secondary_label }}</a>{%- endif -%}
        {%- if section.settings.tour_link != blank -%}<a class="ca-wlhero__tourlink" href="{{ section.settings.tour_link }}" target="_blank" rel="noopener">{{ section.settings.tour_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.proof != blank -%}<p class="ca-wlhero__proof">{{ section.settings.proof }}</p>{%- endif -%}
      {%- if section.settings.rating_label != blank -%}
        <p class="ca-wlhero__rating"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <a href="{{ section.settings.rating_link }}" target="_blank" rel="noopener">{{ section.settings.rating_label }}</a></p>
      {%- endif -%}
    </div>
    {%- if section.settings.tour_image != blank -%}
      <a class="ca-wlhero__tour" href="{{ section.settings.tour_link }}" target="_blank" rel="noopener" aria-label="{{ section.settings.tour_label | escape }} (opens YouTube)">
        {{ section.settings.tour_image | image_url: width: 1600 | image_tag: widths: '640, 960, 1280, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: 'B2B Wishlist Project Planner product tour', loading: 'eager' }}
        <span class="ca-wlhero__play" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-wlhero { position: relative; isolation: isolate; overflow: hidden; }
  .ca-wlhero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.18; z-index: -1; }
  .ca-wlhero__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 990px) { .ca-wlhero__grid { grid-template-columns: 6fr 6fr; gap: 64px; } }
  .ca-wlhero__h1 { font-size: var(--ca-fs-56, clamp(2.25rem, 5vw, 3.5rem)); line-height: 1.02; letter-spacing: -0.03em; margin: 14px 0 20px; }
  .ca-wlhero__lede { font-size: var(--ca-fs-20, 1.25rem); line-height: 1.5; color: var(--ca-soft); max-width: 36rem; }
  .ca-wlhero__actions { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; margin-top: 28px; }
  .ca-wlhero__tourlink { text-decoration: underline; text-underline-offset: 4px; }
  .ca-wlhero__proof { margin: 20px 0 0; font-size: 0.9rem; color: var(--ca-soft); }
  .ca-wlhero__rating { margin: 8px 0 0; font-size: 0.9rem; } .ca-wlhero__rating span { color: #f5b301; letter-spacing: 1px; }
  .ca-wlhero__tour { position: relative; display: block; border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 9; background: #000; }
  .ca-wlhero__tour img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ca-wlhero__play { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; border-radius: 50%; background: #fff; color: #0d110d; display: grid; place-items: center; box-shadow: 0 10px 30px rgb(0 0 0 / 0.3); }
{% endstylesheet %}

{% schema %}
{
  "name": "App: hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading (h1)", "default": "Help customers plan projects." },
    { "type": "richtext", "id": "text", "label": "Lede" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Install on Shopify" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Documentation" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "tour_label", "label": "Tour link label", "default": "Watch the tour" },
    { "type": "url", "id": "tour_link", "label": "Tour link (YouTube)" },
    { "type": "image_picker", "id": "tour_image", "label": "Tour thumbnail" },
    { "type": "text", "id": "proof", "label": "Proof line" },
    { "type": "text", "id": "rating_label", "label": "Rating label" },
    { "type": "url", "id": "rating_link", "label": "Rating link" },
    { "type": "image_picker", "id": "background_image", "label": "Background photo (faint)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#0d110d" },
    { "type": "color", "id": "text_color", "label": "t:settings.text", "default": "#ffffff" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "App: hero", "category": "Conspire" }]
}
{% endschema %}
