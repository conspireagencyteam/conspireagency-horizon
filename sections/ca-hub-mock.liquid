{%- comment -%}
  ca-hub-mock.liquid: "How tile and paint are bought": a copy column beside a static,
  decorative recreation of a storefront UI, in the ca-app-wholesale-mock pattern. The
  mock is aria-hidden; every meaningful statement lives in the copy column.

  Three mocks, one per section instance, sides alternating down the page:
    trade       the storefront trade application (Retail Co., Marcus Reed) and its
                outcome: approved into the Gold tier, Net 30, Shopify company created
                (B2B Onboarding & Wholesale).
    calculator  the product-page buy box: a sample button, the full-order disclosure
                with area and overage, boxes, total; a paint state (gallons from square
                feet, two coats); and the Add to Project affordance of the B2B Wishlist
                Project Planner.
    samples     the sample moment: Order a sample beside Add to cart on the product page,
                the confirmation ("Sample ordered. Ships in 2 business days."), and the
                follow-up email a week later ("How did it look in the room?") linking back
                to the product and the full order. No app name, no brand.
    checkout    a checkout in Shopify's layout and rhythm: contact, ship-to, shipping
                methods with the pallet freight quoted for the address, Net 30 payment
                terms for the trade account, the order summary, the draft-order
                invoice path (B2B Draft Order Invoices). No Shopify logo, no Shop Pay
                mark; the bar reads yourstore.com.

  Mock data is the set already in use on the live app pages (Retail Co., Marcus Reed,
  marcus@retailco.com, Portland OR, resale-certificate.pdf, Gold tier, Net 30, Pale
  Calcite Zellige Hex, Mineral Sage 4x4). No real brand, no em dash.

  Copy comes from the section settings, and an article can replace it: "Article
  metafield key" names a prefix, and custom.<key>_heading (single line),
  custom.<key>_text (rich text or multi-line) and custom.<key>_caption (single line)
  win when set. With no heading from either source the section renders nothing, so
  the shared hub template shows a mock only on an article that carries its copy.

  The optional intro row (eyebrow and statement) titles the chapter; put it on the
  first mock. custom.hub_mocks_heading on the article replaces the statement.
{%- endcomment -%}

{%- liquid
  assign variant = section.settings.variant | default: 'trade'
  assign side = section.settings.mock_side | default: 'right'

  assign heading = section.settings.heading
  assign text = section.settings.text
  assign caption = section.settings.caption
  assign key = section.settings.override_key | strip
  if key != blank and article != blank
    assign heading_key = key | append: '_heading'
    assign text_key = key | append: '_text'
    assign caption_key = key | append: '_caption'
    if article.metafields.custom[heading_key].value != blank
      assign heading = article.metafields.custom[heading_key].value
    endif
    assign text_mf = article.metafields.custom[text_key]
    if text_mf.value != blank
      if text_mf.type == 'rich_text_field'
        capture text
          echo text_mf | metafield_tag
        endcapture
      else
        assign text = text_mf.value | newline_to_br | prepend: '<p>' | append: '</p>'
      endif
    endif
    if article.metafields.custom[caption_key].value != blank
      assign caption = article.metafields.custom[caption_key].value
    endif
  endif

  assign intro_heading = section.settings.intro_heading
  if article != blank and article.metafields.custom.hub_mocks_heading.value != blank and intro_heading != blank
    assign intro_heading = article.metafields.custom.hub_mocks_heading.value
  endif
-%}

{%- if heading != blank or request.design_mode -%}
<div
  class="ca-hmock spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %} ca-hmock--{{ side }} ca-hmock--{{ variant }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- if section.settings.intro_eyebrow != blank or intro_heading != blank -%}
      {%- render 'ca-intro',
        eyebrow: section.settings.intro_eyebrow,
        heading: intro_heading,
        start: 6,
        class: 'ca-hmock__intro'
      -%}
    {%- endif -%}

    <div class="ca-hmock__row">
      <div class="ca-hmock__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ca-eyebrow ca-hmock__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="ca-hmock__heading">{{ heading }}</h2>
        {%- elsif request.design_mode -%}
          <p class="ca-hmock__empty">Add a heading, or the article's custom.{{ key | default: 'hub_mock_*' }}_heading metafield.</p>
        {%- endif -%}
        {%- if text != blank -%}
          <div class="ca-hmock__text ca-rte">{{ text }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="ca-hmock__list list-unstyled" role="list">
            {%- for block in section.blocks -%}
              <li class="ca-hmock__li" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <p class="ca-hmock__link-row">
            <a class="ca-hmock__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
          </p>
        {%- endif -%}
        {%- if caption != blank -%}
          <p class="ca-hmock__caption">{{ caption }}</p>
        {%- endif -%}
      </div>

      <div class="ca-hmock__media" aria-hidden="true">
        {%- case variant -%}

          {%- when 'calculator' -%}
            <div class="ca-hmock__stack ca-hmock__stack--calc">
              <div class="ca-mock ca-mock--pdp">
                <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">yourstore.com/products/pale-calcite-zellige-hex</span></div>
                <div class="ca-mock__body ca-mock__body--pdp">
                  <div class="ca-mock__pdp">
                    <div class="ca-mock__swatch ca-mock__swatch--calcite"></div>
                    <div class="ca-mock__pdp-copy">
                      <div class="ca-mock__kicker">Zellige · 4×4</div>
                      <div class="ca-mock__title">Pale Calcite Zellige Hex</div>
                      <div class="ca-mock__sub">$96.00 per box · In stock, ships in 2 business days</div>
                    </div>
                  </div>
                  <div class="ca-buybox">
                    <span class="ca-buybox__btn ca-buybox__btn--outline">Order sample · $8.00</span>
                    <span class="ca-buybox__btn ca-buybox__btn--solid ca-buybox__btn--summary">Full order · $41.74/sq ft <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5"/></svg></span>
                    <div class="ca-buybox__calc">
                      <div class="ca-buybox__fields">
                        <div class="ca-buybox__field"><span>Area to cover (sq ft)</span><div class="ca-buybox__input">24</div></div>
                        <div class="ca-buybox__field"><span>Overage</span><div class="ca-buybox__input ca-buybox__input--select">15%</div></div>
                      </div>
                      <div class="ca-buybox__summary">12 boxes will cover 27.6 sq ft (120 tiles)</div>
                      <div class="ca-buybox__total"><span>Total</span><strong>$1,152.00</strong></div>
                      <span class="ca-buybox__btn ca-buybox__btn--solid">Add order to cart</span>
                      <div class="ca-buybox__note">Sold by the box · 2.3 sq ft per box (10 tiles)</div>
                    </div>
                  </div>
                  <div class="ca-project">
                    <div class="ca-project__head"><span class="ca-project__heart">♡</span><span>Add to Project</span><span class="ca-project__app">B2B Wishlist Project Planner</span></div>
                    <div class="ca-project__pop">
                      <div class="ca-project__title">Create New Project</div>
                      <div class="ca-buybox__fields">
                        <div class="ca-buybox__field"><span>Project name</span><div class="ca-buybox__input">Hillside Residence</div></div>
                        <div class="ca-buybox__field"><span>Room name</span><div class="ca-buybox__input">Kitchen</div></div>
                      </div>
                      <div class="ca-project__actions"><span class="ca-mock__btn">Add to Room</span><span class="ca-project__hint">12 boxes · Pale Calcite Zellige Hex</span></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="ca-mock ca-mock--paint">
                <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">yourstore.com/products/interior-eggshell-chalk</span></div>
                <div class="ca-mock__body ca-mock__body--paint">
                  <div class="ca-mock__pdp">
                    <div class="ca-mock__swatch ca-mock__swatch--chalk"></div>
                    <div class="ca-mock__pdp-copy">
                      <div class="ca-mock__kicker">Interior eggshell</div>
                      <div class="ca-mock__title ca-mock__title--sm">Chalk</div>
                    </div>
                  </div>
                  <div class="ca-paintbox">
                    <div class="ca-paintbox__head"><span>Size</span><span>Quantity</span><span>Covers</span><span>Price</span></div>
                    <div class="ca-paintbox__row"><span>1 Quart</span><span class="ca-paintbox__step"><i>−</i><b>0</b><i>+</i></span><span>0 ft²</span><span>$0.00</span></div>
                    <div class="ca-paintbox__row"><span>1 Gallon</span><span class="ca-paintbox__step"><i>−</i><b>2</b><i>+</i></span><span>350 ft²</span><span>$148.00</span></div>
                    <div class="ca-paintbox__row"><span>5 Gallon</span><span class="ca-paintbox__step"><i>−</i><b>0</b><i>+</i></span><span>0 ft²</span><span>$0.00</span></div>
                    <div class="ca-paintbox__total"><span>Total</span><span>350 ft²</span><strong>$148.00</strong></div>
                    <div class="ca-buybox__note">Coverage estimates include two coats.</div>
                    <span class="ca-buybox__btn ca-buybox__btn--solid">Add to cart</span>
                    <span class="ca-buybox__btn ca-buybox__btn--outline">Order sample · $6.00</span>
                  </div>
                </div>
              </div>
            </div>

          {%- when 'samples' -%}
            <div class="ca-hmock__stack ca-hmock__stack--samples">
              <div class="ca-mock ca-mock--sample">
                <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">yourstore.com/products/mineral-sage-4x4</span></div>
                <div class="ca-mock__body">
                  <div class="ca-mock__pdp">
                    <div class="ca-mock__swatch ca-mock__swatch--sage"></div>
                    <div class="ca-mock__pdp-copy">
                      <div class="ca-mock__kicker">Ceramic · 4×4</div>
                      <div class="ca-mock__title">Mineral Sage 4×4</div>
                      <div class="ca-mock__sub">$72.00 per box · 10 tiles · 2.3 sq ft</div>
                    </div>
                  </div>
                  <div class="ca-buybox ca-buybox--pair">
                    <span class="ca-buybox__btn ca-buybox__btn--solid">Add to cart</span>
                    <span class="ca-buybox__btn ca-buybox__btn--outline">Order a sample · $8.00</span>
                  </div>
                  <div class="ca-cartline">
                    <span class="ca-mock__check">✓</span>
                    <div><strong>Sample ordered.</strong><span>Ships in 2 business days by parcel · free with your first full order</span></div>
                  </div>
                </div>
              </div>

              <div class="ca-mock ca-mock--followup">
                <div class="ca-mock__bar ca-mock__bar--mail"><span class="ca-mock__mailfrom">yourstore.com</span><span class="ca-mock__mailwhen">One week after delivery</span></div>
                <div class="ca-mock__body ca-mock__body--tight">
                  <div class="ca-mock__kicker">Email · automated</div>
                  <div class="ca-mock__title">How did it look in the room?</div>
                  <div class="ca-followup__item">
                    <span class="ca-mock__swatch ca-mock__swatch--sage"></span>
                    <div><strong>Mineral Sage 4×4</strong><span>Your sample arrived a week ago. When you are ready, the full order ships by pallet, quoted for your address.</span></div>
                  </div>
                  <div class="ca-mock__actions"><span class="ca-mock__btn">Order the full quantity</span><span class="ca-mock__btn ca-mock__btn--ghost">Back to the product</span></div>
                  <div class="ca-mock__sub">Sample credit applied to the full order</div>
                </div>
              </div>
            </div>

          {%- when 'checkout' -%}
            <div class="ca-mock ca-mock--checkout">
              <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">yourstore.com/checkouts/cn/…</span></div>
              <div class="ca-checkout">
                <div class="ca-checkout__main">
                  <div class="ca-checkout__store">yourstore.com</div>
                  <div class="ca-checkout__block">
                    <div class="ca-checkout__label">Contact</div>
                    <div class="ca-checkout__line"><span>marcus@retailco.com</span><em>Change</em></div>
                  </div>
                  <div class="ca-checkout__block">
                    <div class="ca-checkout__label">Ship to</div>
                    <div class="ca-checkout__line"><span>Marcus Reed, Retail Co. · 1420 SE Division St, Portland OR 97202</span><em>Change</em></div>
                  </div>
                  <div class="ca-checkout__block">
                    <div class="ca-checkout__label">Shipping method</div>
                    <div class="ca-checkout__opt is-on"><i></i><div><strong>LTL pallet freight, liftgate delivery</strong><span>Quoted for this address · 12 boxes on 1 pallet · 3 to 5 business days</span></div><b>$289.00</b></div>
                    <div class="ca-checkout__opt"><i></i><div><strong>Parcel</strong><span>Samples only</span></div><b>$12.00</b></div>
                    <div class="ca-checkout__opt"><i></i><div><strong>Warehouse pickup</strong><span>Portland, OR · ready in 2 business days</span></div><b>Free</b></div>
                  </div>
                  <div class="ca-checkout__block">
                    <div class="ca-checkout__label">Payment</div>
                    <div class="ca-checkout__opt is-on"><i></i><div><strong>Net 30 terms</strong><span>Retail Co. · Gold tier · invoice due 30 days after fulfillment</span></div></div>
                    <div class="ca-checkout__opt"><i></i><div><strong>Credit card</strong></div></div>
                  </div>
                  <span class="ca-checkout__submit">Complete order</span>
                  <div class="ca-checkout__draft">Need a quote first? <span>Save as a draft order invoice</span></div>
                </div>
                <div class="ca-checkout__side">
                  <div class="ca-checkout__item"><span class="ca-mock__swatch ca-mock__swatch--calcite ca-mock__swatch--sm"><b>12</b></span><div><strong>Pale Calcite Zellige Hex</strong><span>12 boxes · trade price</span></div><em>$1,152.00</em></div>
                  <div class="ca-checkout__item"><span class="ca-mock__swatch ca-mock__swatch--sage ca-mock__swatch--sm"><b>1</b></span><div><strong>Mineral Sage 4×4</strong><span>Sample</span></div><em>$8.00</em></div>
                  <div class="ca-checkout__sum"><span>Subtotal</span><span>$1,160.00</span></div>
                  <div class="ca-checkout__sum"><span>Shipping</span><span>$289.00</span></div>
                  <div class="ca-checkout__sum"><span>Taxes</span><span>$0.00</span></div>
                  <div class="ca-checkout__sum ca-checkout__sum--total"><span>Total</span><span><small>USD</small> $1,449.00</span></div>
                  <div class="ca-checkout__tax">Resale certificate on file · tax exempt</div>
                </div>
              </div>
            </div>

          {%- else -%}
            <div class="ca-hmock__stack ca-hmock__stack--trade">
              <div class="ca-mock ca-mock--form">
                <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">yourstore.com/pages/trade-program</span></div>
                <div class="ca-mock__body">
                  <div class="ca-mock__head">
                    <div><div class="ca-mock__kicker">Trade program</div><div class="ca-mock__title">Apply for a trade account</div></div>
                  </div>
                  <div class="ca-form">
                    <div class="ca-form__field"><span>Company name</span><div class="ca-form__input">Retail Co.</div></div>
                    <div class="ca-form__field"><span>Your name</span><div class="ca-form__input">Marcus Reed</div></div>
                    <div class="ca-form__field"><span>Work email</span><div class="ca-form__input">marcus@retailco.com</div></div>
                    <div class="ca-form__field"><span>Phone</span><div class="ca-form__input">(503) 555-0142</div></div>
                    <div class="ca-form__field"><span>Expected monthly volume</span><div class="ca-form__input ca-form__input--select">$5,000 to $10,000 a month</div></div>
                    <div class="ca-form__field"><span>Resale certificate</span><div class="ca-form__input"><span class="ca-mock__check ca-mock__check--sm">✓</span> resale-certificate.pdf</div></div>
                    <div class="ca-form__field ca-form__field--wide"><span>Ship-to address</span><div class="ca-form__input">1420 SE Division St, Portland, OR 97202</div></div>
                  </div>
                  <div class="ca-mock__actions ca-mock__actions--inline"><span class="ca-mock__btn ca-mock__btn--go">Submitted ✓</span><span class="ca-mock__thanks">Thanks, Marcus. Under review.</span></div>
                </div>
              </div>

              <div class="ca-mock ca-mock--outcome">
                <div class="ca-mock__bar"><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__dot"></span><span class="ca-mock__url">Apps · B2B Onboarding &amp; Wholesale · Applications</span></div>
                <div class="ca-mock__body ca-mock__body--tight">
                  <div class="ca-mock__head">
                    <div><div class="ca-mock__kicker">Application</div><div class="ca-mock__title ca-mock__title--sm">Retail Co.</div><div class="ca-mock__sub">Marcus Reed · marcus@retailco.com</div></div>
                    <span class="ca-mock__pill">Approved · Gold tier</span>
                  </div>
                  <div class="ca-mock__result"><span class="ca-mock__check">✓</span><div><strong>Shopify company created</strong><span>Contact and location added · catalog: Gold tier · payment terms: Net 30</span></div></div>
                </div>
              </div>
            </div>
        {%- endcase -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .ca-hmock { background-color: var(--color-background); }

  .ca-hmock__intro { margin-block-end: 72px; }

  .ca-hmock__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: center;
  }

  .ca-hmock__copy { grid-column: 1 / span 5; }
  .ca-hmock__media { grid-column: 7 / span 6; min-width: 0; }
  .ca-hmock--left .ca-hmock__copy { grid-column: 8 / span 5; order: 2; }
  .ca-hmock--left .ca-hmock__media { grid-column: 1 / span 6; order: 1; }

  .ca-hmock__eyebrow { margin-block-end: 24px; }

  .ca-hmock__heading {
    margin: 0 0 24px;
    font-size: var(--ca-fs-48);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .ca-hmock__text { color: var(--ca-soft); }

  .ca-hmock__list {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
  }

  .ca-hmock__li {
    position: relative;
    padding-inline-start: 22px;
    font-size: var(--ca-fs-18);
    letter-spacing: -0.02em;
  }

  .ca-hmock__li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: currentColor;
  }

  .ca-hmock__link-row { margin: 28px 0 0; }
  .ca-hmock__link { color: inherit; text-underline-offset: 0.15em; }
  .ca-hmock__caption { margin: 24px 0 0; font-size: 0.9375rem; line-height: 1.5; color: var(--ca-muted); }
  .ca-hmock__empty { color: var(--ca-muted); }

  /* ── Stacked mocks (a second card overlaps the first) ───────────────── */
  .ca-hmock__stack { position: relative; }
  .ca-hmock__stack--trade { padding-block-end: 120px; padding-inline-end: 6%; }
  .ca-hmock__stack--trade .ca-mock--outcome { position: absolute; right: 0; bottom: 0; width: 58%; z-index: 2; }
  .ca-hmock__stack--calc { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .ca-hmock__stack--calc .ca-mock--paint { margin-block-start: 56px; }

  /* ── Decorative mock chrome (shared vocabulary with ca-app-wholesale-mock) ─ */
  .ca-hmock .ca-mock {
    container-type: inline-size;
    --mock-bg: #ffffff;
    --mock-ink: #0d110d;
    --mock-soft: rgb(13 17 13 / 0.62);
    --mock-line: rgb(13 17 13 / 0.12);
    --mock-tint: #f2f2f2;
    border: 1px solid var(--mock-line);
    border-radius: 14px;
    background: var(--mock-bg);
    color: var(--mock-ink);
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    box-shadow: 0 30px 60px -30px rgb(13 17 13 / 0.35);
    overflow: hidden;
  }

  .ca-hmock .ca-mock__bar { display: flex; align-items: center; gap: 6px; padding: 12px 16px; background: var(--mock-tint); border-bottom: 1px solid var(--mock-line); }
  .ca-hmock .ca-mock__dot { width: 9px; height: 9px; border-radius: 999px; background: var(--mock-line); }
  .ca-hmock .ca-mock__url { margin-inline-start: 10px; font-size: 12px; color: var(--mock-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-hmock .ca-mock__body { padding: 22px 24px 24px; display: grid; gap: 18px; }
  .ca-hmock .ca-mock__body--tight { padding: 18px 20px 20px; gap: 14px; }
  .ca-hmock .ca-mock__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .ca-hmock .ca-mock__kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); }
  .ca-hmock .ca-mock__title { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; margin-top: 4px; }
  .ca-hmock .ca-mock__title--sm { font-size: 16px; }
  .ca-hmock .ca-mock__sub { font-size: 12px; color: var(--mock-soft); margin-top: 3px; }
  .ca-hmock .ca-mock__pill { flex: none; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: var(--mock-ink); color: #fff; white-space: nowrap; }
  .ca-hmock .ca-mock__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .ca-hmock .ca-mock__actions--inline { flex-direction: column; align-items: flex-start; gap: 10px; }
  .ca-hmock .ca-mock__btn { display: inline-block; padding: 9px 14px; border-radius: 999px; background: var(--mock-ink); color: #fff; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .ca-hmock .ca-mock__btn--go { background: #1f7a4d; }
  .ca-hmock .ca-mock__thanks { font-size: 13px; color: var(--mock-soft); }
  .ca-hmock .ca-mock__result { display: flex; gap: 12px; align-items: center; padding: 14px 16px; border-radius: 10px; background: #e6f4ea; color: #0f5132; }
  .ca-hmock .ca-mock__result div { display: grid; }
  .ca-hmock .ca-mock__result span { font-size: 12px; opacity: 0.85; }
  .ca-hmock .ca-mock__check { flex: none; width: 28px; height: 28px; border-radius: 999px; background: #0f5132; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
  .ca-hmock .ca-mock__check--sm { width: 18px; height: 18px; font-size: 11px; vertical-align: -3px; }

  /* Trade application form */
  .ca-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
  .ca-form__field { display: grid; gap: 6px; min-width: 0; }
  .ca-form__field--wide { grid-column: 1 / -1; }
  .ca-form__field > span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); white-space: nowrap; }
  .ca-form__input { height: 40px; display: flex; align-items: center; padding: 0 12px; border: 1.5px solid var(--mock-line); border-radius: 8px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-form__input--select::after, .ca-buybox__input--select::after { content: "▾"; margin-inline-start: auto; color: var(--mock-soft); font-size: 11px; }

  /* Product page + tile buy box (the Gable & Oak theme block, recreated) */
  .ca-mock__pdp { display: flex; gap: 14px; align-items: center; }
  .ca-mock__swatch { flex: none; width: 56px; height: 56px; border-radius: 8px; background: #d9d4c7; }
  .ca-mock__swatch--calcite { background: linear-gradient(135deg, #e9e3d6, #cfc6b3); }
  .ca-mock__swatch--sage { background: linear-gradient(135deg, #b9c4b0, #8a9a84); }
  .ca-mock__swatch--chalk { background: linear-gradient(135deg, #f4f1ea, #e3ded2); }
  .ca-mock__swatch--sm { width: 40px; height: 40px; position: relative; }
  .ca-mock__swatch--sm b { position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--mock-soft); color: #fff; font-size: 10px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; }
  .ca-mock__pdp-copy { min-width: 0; }
  .ca-mock__pdp-copy .ca-mock__title { margin-top: 2px; }

  .ca-buybox { display: grid; gap: 8px; }
  .ca-buybox__btn { display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; padding: 0 18px; font-size: 13px; font-weight: 500; text-align: center; white-space: nowrap; }
  .ca-buybox__btn--outline { border: 1px solid var(--mock-ink); color: var(--mock-ink); background: transparent; }
  .ca-buybox__btn--solid { background: var(--mock-ink); color: #fff; }
  .ca-buybox__btn--summary { justify-content: space-between; }
  .ca-buybox__calc { display: grid; gap: 12px; padding: 14px; border: 1px solid var(--mock-line); border-top: 0; }
  .ca-buybox__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ca-buybox__field { display: grid; gap: 5px; min-width: 0; }
  .ca-buybox__field > span { font-size: 11px; color: var(--mock-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-buybox__input { height: 38px; display: flex; align-items: center; padding: 0 12px; border: 1px solid var(--mock-line); font-size: 13px; }
  .ca-buybox__summary { font-size: 12px; color: var(--mock-soft); }
  .ca-buybox__total { display: flex; justify-content: space-between; align-items: baseline; padding-block-start: 10px; border-top: 1px solid var(--mock-line); font-size: 13px; }
  .ca-buybox__total strong { font-size: 16px; font-weight: 600; }
  .ca-buybox__note { font-size: 11px; color: var(--mock-soft); }

  /* Add to Project (B2B Wishlist Project Planner) */
  .ca-project { display: grid; gap: 10px; padding-block-start: 14px; border-top: 1px solid var(--mock-line); }
  .ca-project__head { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
  .ca-project__heart { font-size: 15px; }
  .ca-project__app { margin-inline-start: auto; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); white-space: nowrap; }
  .ca-project__pop { display: grid; gap: 10px; padding: 12px; border: 1px solid var(--mock-line); border-radius: 10px; background: var(--mock-tint); }
  .ca-project__title { font-size: 12px; font-weight: 600; }
  .ca-project__pop .ca-buybox__input { background: #fff; border-radius: 8px; }
  .ca-project__actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .ca-project__hint { font-size: 11px; color: var(--mock-soft); }

  /* Samples: product page with the sample in the cart, and the follow-up email */
  .ca-hmock__stack--samples { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .ca-hmock__stack--samples .ca-mock--followup { margin-block-start: 72px; }
  .ca-buybox--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ca-hmock .ca-mock__btn--ghost { background: transparent; color: var(--mock-ink); border: 1px solid var(--mock-line); }
  .ca-cartline { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 10px; background: #e6f4ea; color: #0f5132; font-size: 12px; min-width: 0; }
  .ca-cartline div { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .ca-cartline strong { font-weight: 600; }
  .ca-cartline div span { font-size: 11px; opacity: 0.85; }
  .ca-hmock .ca-mock__bar--mail { justify-content: space-between; font-size: 12px; }
  .ca-mock__mailfrom { font-weight: 600; }
  .ca-mock__mailwhen { color: var(--mock-soft); }
  .ca-followup__item { display: flex; gap: 12px; align-items: center; padding: 12px; border: 1px solid var(--mock-line); border-radius: 10px; min-width: 0; }
  .ca-followup__item div { display: grid; gap: 3px; min-width: 0; }
  .ca-followup__item strong { font-weight: 600; }
  .ca-followup__item span:not(.ca-mock__swatch) { font-size: 12px; color: var(--mock-soft); }

  /* Paint buy box */
  .ca-mock__body--paint { gap: 14px; padding: 16px 14px 18px; }
  .ca-paintbox { display: grid; gap: 8px; font-size: 12px; }
  .ca-paintbox__head, .ca-paintbox__row, .ca-paintbox__total { display: grid; grid-template-columns: 1.1fr 1.2fr 0.9fr 0.9fr; gap: 8px; align-items: center; }
  .ca-paintbox__head { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); padding-block-end: 6px; border-bottom: 1px solid var(--mock-line); }
  .ca-paintbox__row { padding-block: 4px; }
  .ca-paintbox__row > span:nth-child(3), .ca-paintbox__row > span:nth-child(4), .ca-paintbox__head > span:nth-child(3), .ca-paintbox__head > span:nth-child(4), .ca-paintbox__total > :nth-child(2), .ca-paintbox__total > :nth-child(3) { text-align: right; }
  .ca-paintbox__step { display: inline-flex; align-items: center; justify-content: space-between; height: 28px; border: 1px solid var(--mock-line); }
  .ca-paintbox__step i { font-style: normal; width: 20px; text-align: center; color: var(--mock-soft); }
  .ca-paintbox__step b { font-weight: 500; }
  .ca-paintbox__total { grid-template-columns: 1.1fr 1.2fr 0.9fr 0.9fr; padding-block-start: 8px; border-top: 1px solid var(--mock-line); }
  .ca-paintbox__total > span:first-child { grid-column: 1 / span 2; }
  .ca-paintbox__total strong { font-weight: 600; font-size: 14px; }
  .ca-paintbox .ca-buybox__btn { height: 38px; font-size: 12px; }

  /* Checkout */
  .ca-checkout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .ca-checkout__main { container-type: inline-size; min-width: 0; padding: 22px 24px 24px; display: grid; gap: 18px; align-content: start; }
  .ca-checkout__side { container-type: inline-size; min-width: 0; padding: 22px 22px 24px; display: grid; gap: 12px; align-content: start; background: var(--mock-tint); border-inline-start: 1px solid var(--mock-line); }
  .ca-checkout__store { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .ca-checkout__block { display: grid; gap: 8px; min-width: 0; }
  .ca-checkout__label { font-size: 13px; font-weight: 600; }
  .ca-checkout__line { display: flex; justify-content: space-between; gap: 12px; min-width: 0; overflow: hidden; padding: 10px 12px; border: 1px solid var(--mock-line); border-radius: 8px; font-size: 12px; }
  .ca-checkout__line span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ca-checkout__line em { font-style: normal; color: var(--mock-soft); text-decoration: underline; flex: none; }
  .ca-checkout__opt { display: flex; align-items: center; gap: 10px; min-width: 0; overflow: hidden; padding: 10px 12px; border: 1px solid var(--mock-line); border-radius: 8px; font-size: 12px; }
  .ca-checkout__opt + .ca-checkout__opt { margin-block-start: -2px; }
  .ca-checkout__opt.is-on { border-color: var(--mock-ink); background: rgb(13 17 13 / 0.03); }
  .ca-checkout__opt i { flex: none; width: 16px; height: 16px; border-radius: 999px; border: 1.5px solid var(--mock-line); }
  .ca-checkout__opt.is-on i { border: 5px solid var(--mock-ink); }
  .ca-checkout__opt div { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .ca-checkout__opt strong { font-weight: 600; }
  .ca-checkout__opt span { font-size: 11px; color: var(--mock-soft); }
  .ca-checkout__opt b { flex: none; font-weight: 600; }
  .ca-checkout__submit { display: flex; align-items: center; justify-content: center; height: 44px; border-radius: 8px; background: var(--mock-ink); color: #fff; font-size: 13px; font-weight: 600; }
  .ca-checkout__draft { font-size: 11px; color: var(--mock-soft); text-align: center; }
  .ca-checkout__draft span { text-decoration: underline; color: var(--mock-ink); }
  .ca-checkout__item { display: flex; align-items: center; gap: 12px; font-size: 12px; min-width: 0; }
  .ca-checkout__item div { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .ca-checkout__item strong { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-checkout__item span { font-size: 11px; color: var(--mock-soft); }
  .ca-checkout__item em { font-style: normal; font-weight: 500; flex: none; }
  .ca-checkout__sum { display: flex; justify-content: space-between; font-size: 12px; color: var(--mock-soft); }
  .ca-checkout__item + .ca-checkout__sum { margin-block-start: 8px; padding-block-start: 12px; border-top: 1px solid var(--mock-line); }
  .ca-checkout__sum--total { margin-block-start: 4px; padding-block-start: 10px; border-top: 1px solid var(--mock-line); color: var(--mock-ink); font-size: 15px; font-weight: 600; }
  .ca-checkout__sum--total small { font-size: 10px; font-weight: 500; color: var(--mock-soft); margin-inline-end: 4px; }
  .ca-checkout__tax { font-size: 11px; color: var(--mock-soft); }

  @media screen and (max-width: 989px) {
    .ca-hmock__intro { margin-block-end: 48px; }
    .ca-hmock__row { gap: 40px 24px; }
    .ca-hmock__copy, .ca-hmock__media,
    .ca-hmock--left .ca-hmock__copy, .ca-hmock--left .ca-hmock__media { grid-column: 1 / -1; order: initial; }
    .ca-hmock__heading { font-size: var(--ca-fs-36); }
    .ca-hmock .ca-mock { font-size: 13px; }
    .ca-hmock .ca-mock__body { padding: 18px 16px 20px; }
    .ca-hmock__stack--trade { padding-block-end: 0; padding-inline-end: 0; display: grid; gap: 16px; }
    .ca-hmock__stack--trade .ca-mock--outcome { position: static; width: auto; }
    .ca-hmock__stack--calc, .ca-hmock__stack--samples { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .ca-hmock__stack--samples .ca-mock--followup { margin-block-start: 0; }
    .ca-hmock__stack--calc .ca-mock--paint { margin-block-start: 0; }
    .ca-form { grid-template-columns: minmax(0, 1fr); }
    .ca-form__field--wide { grid-column: auto; }
  }

  @media screen and (max-width: 749px) {
    .ca-checkout { grid-template-columns: minmax(0, 1fr); }
    .ca-checkout__side { border-inline-start: 0; border-top: 1px solid var(--mock-line); }
    .ca-checkout__main, .ca-checkout__side { padding: 18px 16px 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vertical hub UI mock",
  "tag": "section",
  "class": "ca-hmock-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "A copy column beside a static recreation of a storefront UI. The mock is decorative; say everything that matters in the copy. An article replaces the copy through custom.<key>_heading, custom.<key>_text and custom.<key>_caption when the metafield key below is set." },
    {
      "type": "select",
      "id": "variant",
      "label": "Mock",
      "options": [
        { "value": "trade", "label": "Trade application and approval" },
        { "value": "calculator", "label": "Product page buy box with Add to Project" },
        { "value": "samples", "label": "Sample order and the follow-up" },
        { "value": "checkout", "label": "Checkout with pallet freight and Net 30" }
      ],
      "default": "trade"
    },
    {
      "type": "select",
      "id": "mock_side",
      "label": "Mock position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Chapter intro (optional, on the first mock)" },
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow" },
    { "type": "inline_richtext", "id": "intro_heading", "label": "Intro statement", "info": "Bold the words to emphasise; the rest is shown muted. custom.hub_mocks_heading on the article replaces it." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "App link label", "info": "Name the app as ours and link its page, for example B2B Onboarding & Wholesale." },
    { "type": "url", "id": "link_url", "label": "App link" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "override_key", "label": "Article metafield key", "info": "A prefix: hub_mock_trade reads custom.hub_mock_trade_heading, _text and _caption from the article when set." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet",
      "settings": [{ "type": "text", "id": "label", "label": "Label" }]
    }
  ],
  "presets": [{ "name": "Vertical hub UI mock", "category": "Conspire" }]
}
{% endschema %}
