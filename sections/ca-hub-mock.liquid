{% stylesheet %}
  .ca-hmock { background-color: var(--color-background); }

  .ca-hmock__intro { margin-block-end: 72px; }

  .ca-hmock__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 48px 24px;
    align-items: center;
  }

  .ca-hmock__copy { grid-column: 1 / span 5; }
  .ca-hmock__media { grid-column: 7 / span 6; min-width: 0; }
  .ca-hmock--left .ca-hmock__copy { grid-column: 8 / span 5; order: 2; }
  .ca-hmock--left .ca-hmock__media { grid-column: 1 / span 6; order: 1; }

  .ca-hmock__eyebrow { margin-block-end: 24px; }

  .ca-hmock__heading {
    margin: 0 0 24px;
    font-size: var(--ca-fs-48);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .ca-hmock__text { color: var(--ca-soft); }

  .ca-hmock__list {
    display: grid;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
  }

  .ca-hmock__li {
    position: relative;
    padding-inline-start: 22px;
    font-size: var(--ca-fs-18);
    letter-spacing: -0.02em;
  }

  .ca-hmock__li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: currentColor;
  }

  .ca-hmock__link-row { margin: 28px 0 0; }
  .ca-hmock__link { color: inherit; text-underline-offset: 0.15em; }
  .ca-hmock__caption { margin: 24px 0 0; font-size: 0.9375rem; line-height: 1.5; color: var(--ca-muted); }
  .ca-hmock__empty { color: var(--ca-muted); }

  /* ── Stacked mocks (a second card overlaps the first) ───────────────── */
  .ca-hmock__stack { position: relative; }
  .ca-hmock__stack--trade { padding-block-end: 120px; padding-inline-end: 6%; }
  .ca-hmock__stack--trade .ca-mock--outcome { position: absolute; right: 0; bottom: 0; width: 58%; z-index: 2; }
  .ca-hmock__stack--calc { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .ca-hmock__stack--calc .ca-mock--paint { margin-block-start: 56px; }

  /* ── Decorative mock chrome (shared vocabulary with ca-app-wholesale-mock) ─ */
  .ca-hmock .ca-mock {
    container-type: inline-size;
    --mock-bg: #ffffff;
    --mock-ink: #0d110d;
    --mock-soft: rgb(13 17 13 / 0.62);
    --mock-line: rgb(13 17 13 / 0.12);
    --mock-tint: #f2f2f2;
    border: 1px solid var(--mock-line);
    border-radius: 14px;
    background: var(--mock-bg);
    color: var(--mock-ink);
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    box-shadow: 0 30px 60px -30px rgb(13 17 13 / 0.35);
    overflow: hidden;
  }

  .ca-hmock .ca-mock__bar { display: flex; align-items: center; gap: 6px; padding: 12px 16px; background: var(--mock-tint); border-bottom: 1px solid var(--mock-line); }
  .ca-hmock .ca-mock__dot { width: 9px; height: 9px; border-radius: 999px; background: var(--mock-line); }
  .ca-hmock .ca-mock__url { margin-inline-start: 10px; font-size: 12px; color: var(--mock-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-hmock .ca-mock__body { padding: 22px 24px 24px; display: grid; gap: 18px; }
  .ca-hmock .ca-mock__body--tight { padding: 18px 20px 20px; gap: 14px; }
  .ca-hmock .ca-mock__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .ca-hmock .ca-mock__kicker { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); }
  .ca-hmock .ca-mock__title { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; margin-top: 4px; }
  .ca-hmock .ca-mock__title--sm { font-size: 16px; }
  .ca-hmock .ca-mock__sub { font-size: 12px; color: var(--mock-soft); margin-top: 3px; }
  .ca-hmock .ca-mock__pill { flex: none; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; background: var(--mock-ink); color: #fff; white-space: nowrap; }
  .ca-hmock .ca-mock__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .ca-hmock .ca-mock__actions--inline { flex-direction: column; align-items: flex-start; gap: 10px; }
  .ca-hmock .ca-mock__btn { display: inline-block; padding: 9px 14px; border-radius: 999px; background: var(--mock-ink); color: #fff; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .ca-hmock .ca-mock__btn--go { background: #1f7a4d; }
  .ca-hmock .ca-mock__thanks { font-size: 13px; color: var(--mock-soft); }
  .ca-hmock .ca-mock__result { display: flex; gap: 12px; align-items: center; padding: 14px 16px; border-radius: 10px; background: #e6f4ea; color: #0f5132; }
  .ca-hmock .ca-mock__result div { display: grid; }
  .ca-hmock .ca-mock__result span { font-size: 12px; opacity: 0.85; }
  .ca-hmock .ca-mock__check { flex: none; width: 28px; height: 28px; border-radius: 999px; background: #0f5132; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
  .ca-hmock .ca-mock__check--sm { width: 18px; height: 18px; font-size: 11px; vertical-align: -3px; }

  /* Trade application form */
  .ca-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
  .ca-form__field { display: grid; gap: 6px; min-width: 0; }
  .ca-form__field--wide { grid-column: 1 / -1; }
  .ca-form__field > span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); white-space: nowrap; }
  .ca-form__input { height: 40px; display: flex; align-items: center; padding: 0 12px; border: 1.5px solid var(--mock-line); border-radius: 8px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-form__input--select::after, .ca-buybox__input--select::after { content: "▾"; margin-inline-start: auto; color: var(--mock-soft); font-size: 11px; }

  /* Product page + tile buy box (the Gable & Oak theme block, recreated) */
  .ca-mock__pdp { display: flex; gap: 14px; align-items: center; }
  .ca-mock__swatch { flex: none; width: 56px; height: 56px; border-radius: 8px; background: #d9d4c7; }
  .ca-mock__swatch--calcite { background: linear-gradient(135deg, #e9e3d6, #cfc6b3); }
  .ca-mock__swatch--sage { background: linear-gradient(135deg, #b9c4b0, #8a9a84); }
  .ca-mock__swatch--chalk { background: linear-gradient(135deg, #f4f1ea, #e3ded2); }
  .ca-mock__swatch--sm { width: 40px; height: 40px; position: relative; }
  .ca-mock__swatch--sm b { position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--mock-soft); color: #fff; font-size: 10px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; }
  .ca-mock__pdp-copy { min-width: 0; }
  .ca-mock__pdp-copy .ca-mock__title { margin-top: 2px; }

  .ca-buybox { display: grid; gap: 8px; }
  .ca-buybox__btn { display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; padding: 0 18px; font-size: 13px; font-weight: 500; text-align: center; white-space: nowrap; }
  .ca-buybox__btn--outline { border: 1px solid var(--mock-ink); color: var(--mock-ink); background: transparent; }
  .ca-buybox__btn--solid { background: var(--mock-ink); color: #fff; }
  .ca-buybox__btn--summary { justify-content: space-between; }
  .ca-buybox__calc { display: grid; gap: 12px; padding: 14px; border: 1px solid var(--mock-line); border-top: 0; }
  .ca-buybox__fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ca-buybox__field { display: grid; gap: 5px; min-width: 0; }
  .ca-buybox__field > span { font-size: 11px; color: var(--mock-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-buybox__input { height: 38px; display: flex; align-items: center; padding: 0 12px; border: 1px solid var(--mock-line); font-size: 13px; }
  .ca-buybox__summary { font-size: 12px; color: var(--mock-soft); }
  .ca-buybox__total { display: flex; justify-content: space-between; align-items: baseline; padding-block-start: 10px; border-top: 1px solid var(--mock-line); font-size: 13px; }
  .ca-buybox__total strong { font-size: 16px; font-weight: 600; }
  .ca-buybox__note { font-size: 11px; color: var(--mock-soft); }

  /* Add to Project (B2B Wishlist Project Planner) */
  .ca-project { display: grid; gap: 10px; padding-block-start: 14px; border-top: 1px solid var(--mock-line); }
  .ca-project__head { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
  .ca-project__heart { font-size: 15px; }
  .ca-project__app { margin-inline-start: auto; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); white-space: nowrap; }
  .ca-project__pop { display: grid; gap: 10px; padding: 12px; border: 1px solid var(--mock-line); border-radius: 10px; background: var(--mock-tint); }
  .ca-project__title { font-size: 12px; font-weight: 600; }
  .ca-project__pop .ca-buybox__input { background: #fff; border-radius: 8px; }
  .ca-project__actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .ca-project__hint { font-size: 11px; color: var(--mock-soft); }

  /* Samples: product page with the sample in the cart, and the follow-up email */
  .ca-hmock__stack--samples { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .ca-hmock__stack--samples .ca-mock--followup { margin-block-start: 72px; }
  .ca-buybox--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .ca-hmock .ca-mock__btn--ghost { background: transparent; color: var(--mock-ink); border: 1px solid var(--mock-line); }
  .ca-cartline { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 10px; background: #e6f4ea; color: #0f5132; font-size: 12px; min-width: 0; }
  .ca-cartline div { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .ca-cartline strong { font-weight: 600; }
  .ca-cartline div span { font-size: 11px; opacity: 0.85; }
  .ca-hmock .ca-mock__bar--mail { justify-content: space-between; font-size: 12px; }
  .ca-mock__mailfrom { font-weight: 600; }
  .ca-mock__mailwhen { color: var(--mock-soft); }
  .ca-followup__item { display: flex; gap: 12px; align-items: center; padding: 12px; border: 1px solid var(--mock-line); border-radius: 10px; min-width: 0; }
  .ca-followup__item div { display: grid; gap: 3px; min-width: 0; }
  .ca-followup__item strong { font-weight: 600; }
  .ca-followup__item span:not(.ca-mock__swatch) { font-size: 12px; color: var(--mock-soft); }

  /* Paint buy box */
  .ca-mock__body--paint { gap: 14px; padding: 16px 14px 18px; }
  .ca-paintbox { display: grid; gap: 8px; font-size: 12px; }
  .ca-paintbox__head, .ca-paintbox__row, .ca-paintbox__total { display: grid; grid-template-columns: 1.1fr 1.2fr 0.9fr 0.9fr; gap: 8px; align-items: center; }
  .ca-paintbox__head { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); padding-block-end: 6px; border-bottom: 1px solid var(--mock-line); }
  .ca-paintbox__row { padding-block: 4px; }
  .ca-paintbox__row > span:nth-child(3), .ca-paintbox__row > span:nth-child(4), .ca-paintbox__head > span:nth-child(3), .ca-paintbox__head > span:nth-child(4), .ca-paintbox__total > :nth-child(2), .ca-paintbox__total > :nth-child(3) { text-align: right; }
  .ca-paintbox__step { display: inline-flex; align-items: center; justify-content: space-between; height: 28px; border: 1px solid var(--mock-line); }
  .ca-paintbox__step i { font-style: normal; width: 20px; text-align: center; color: var(--mock-soft); }
  .ca-paintbox__step b { font-weight: 500; }
  .ca-paintbox__total { grid-template-columns: 1.1fr 1.2fr 0.9fr 0.9fr; padding-block-start: 8px; border-top: 1px solid var(--mock-line); }
  .ca-paintbox__total > span:first-child { grid-column: 1 / span 2; }
  .ca-paintbox__total strong { font-weight: 600; font-size: 14px; }
  .ca-paintbox .ca-buybox__btn { height: 38px; font-size: 12px; }

  /* Checkout */
  .ca-checkout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  .ca-checkout__main { container-type: inline-size; min-width: 0; padding: 22px 24px 24px; display: grid; gap: 18px; align-content: start; }
  .ca-checkout__side { container-type: inline-size; min-width: 0; padding: 22px 22px 24px; display: grid; gap: 12px; align-content: start; background: var(--mock-tint); border-inline-start: 1px solid var(--mock-line); }
  .ca-checkout__store { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
  .ca-checkout__block { display: grid; gap: 8px; min-width: 0; }
  .ca-checkout__label { font-size: 13px; font-weight: 600; }
  .ca-checkout__line { display: flex; justify-content: space-between; gap: 12px; min-width: 0; overflow: hidden; padding: 10px 12px; border: 1px solid var(--mock-line); border-radius: 8px; font-size: 12px; }
  .ca-checkout__line span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ca-checkout__line em { font-style: normal; color: var(--mock-soft); text-decoration: underline; flex: none; }
  .ca-checkout__opt { display: flex; align-items: center; gap: 10px; min-width: 0; overflow: hidden; padding: 10px 12px; border: 1px solid var(--mock-line); border-radius: 8px; font-size: 12px; }
  .ca-checkout__opt + .ca-checkout__opt { margin-block-start: -2px; }
  .ca-checkout__opt.is-on { border-color: var(--mock-ink); background: rgb(13 17 13 / 0.03); }
  .ca-checkout__opt i { flex: none; width: 16px; height: 16px; border-radius: 999px; border: 1.5px solid var(--mock-line); }
  .ca-checkout__opt.is-on i { border: 5px solid var(--mock-ink); }
  .ca-checkout__opt div { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .ca-checkout__opt strong { font-weight: 600; }
  .ca-checkout__opt span { font-size: 11px; color: var(--mock-soft); }
  .ca-checkout__opt b { flex: none; font-weight: 600; }
  .ca-checkout__submit { display: flex; align-items: center; justify-content: center; height: 44px; border-radius: 8px; background: var(--mock-ink); color: #fff; font-size: 13px; font-weight: 600; }
  .ca-checkout__draft { font-size: 11px; color: var(--mock-soft); text-align: center; }
  .ca-checkout__draft span { text-decoration: underline; color: var(--mock-ink); }
  .ca-checkout__item { display: flex; align-items: center; gap: 12px; font-size: 12px; min-width: 0; }
  .ca-checkout__item div { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .ca-checkout__item strong { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-checkout__item span { font-size: 11px; color: var(--mock-soft); }
  .ca-checkout__item em { font-style: normal; font-weight: 500; flex: none; }
  .ca-checkout__sum { display: flex; justify-content: space-between; font-size: 12px; color: var(--mock-soft); }
  .ca-checkout__item + .ca-checkout__sum { margin-block-start: 8px; padding-block-start: 12px; border-top: 1px solid var(--mock-line); }
  .ca-checkout__sum--total { margin-block-start: 4px; padding-block-start: 10px; border-top: 1px solid var(--mock-line); color: var(--mock-ink); font-size: 15px; font-weight: 600; }
  .ca-checkout__sum--total small { font-size: 10px; font-weight: 500; color: var(--mock-soft); margin-inline-end: 4px; }
  .ca-checkout__tax { font-size: 11px; color: var(--mock-soft); }

  /* Wholesale mocks: shared swatches, facts, avatar */
  .ca-mock__swatch--mug { background: linear-gradient(135deg, #f6f4ee, #dedad0); }
  .ca-mock__swatch--oak { background: linear-gradient(135deg, #d6b98f, #a9834f); }
  .ca-mock__swatch--linen { background: linear-gradient(135deg, #ece4d4, #d3c7b0); }
  .ca-mock__swatch--charcoal { background: linear-gradient(135deg, #5b5f5d, #353836); }
  .ca-mock__swatch--xs { width: 34px; height: 34px; border-radius: 6px; }
  .ca-acct__avatar { flex: none; width: 30px; height: 30px; border-radius: 999px; background: var(--mock-ink); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: 0; display: inline-flex; align-items: center; justify-content: center; }
  .ca-acct__fact { display: grid; gap: 4px; min-width: 0; }
  .ca-acct__fact > span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); white-space: nowrap; }
  .ca-acct__fact > b { font-size: 13px; font-weight: 500; }

  /* Company account (customer account page) */
  .ca-hmock__stack--company { padding-block-end: 104px; padding-inline-start: 6%; }
  .ca-hmock__stack--company .ca-mock--orders { position: absolute; left: 0; bottom: 0; width: 56%; z-index: 2; }
  .ca-acct { display: grid; gap: 18px; padding: 0 24px 72px; }
  .ca-acct__bar { display: flex; align-items: center; gap: 10px; min-width: 0; margin-inline: -24px; padding: 12px 24px; border-bottom: 1px solid var(--mock-line); }
  .ca-acct__who { flex: 1; min-width: 0; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-acct__loc { flex: none; display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border: 1px solid var(--mock-line); border-radius: 8px; font-size: 12px; white-space: nowrap; }
  .ca-acct__loc small { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); }
  .ca-acct__loc::after { content: "▾"; color: var(--mock-soft); font-size: 11px; }
  .ca-acct__card { display: grid; gap: 16px; padding: 18px; border: 1px solid var(--mock-line); border-radius: 12px; }
  .ca-acct__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  .ca-acct__facts .ca-acct__fact { padding-block: 11px; border-top: 1px solid var(--mock-line); }
  .ca-acct__prices { display: grid; gap: 10px; }
  .ca-acct__label { font-size: 13px; font-weight: 600; }
  .ca-acct__price { display: flex; align-items: center; gap: 12px; min-width: 0; font-size: 13px; }
  .ca-acct__price + .ca-acct__price { padding-block-start: 10px; border-top: 1px solid var(--mock-line); }
  .ca-acct__price div, .ca-acct__order div { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .ca-acct__price strong, .ca-acct__order strong { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-acct__price div span, .ca-acct__order div span { font-size: 11px; color: var(--mock-soft); }
  .ca-acct__price s { flex: none; font-size: 12px; color: var(--mock-soft); }
  .ca-acct__price em, .ca-acct__order em { flex: none; font-style: normal; font-weight: 600; }
  .ca-acct__order { display: flex; align-items: center; gap: 12px; min-width: 0; font-size: 13px; }
  .ca-acct__order + .ca-acct__order { padding-block-start: 12px; border-top: 1px solid var(--mock-line); }
  .ca-acct__reorder { flex: none; padding: 6px 12px; border: 1px solid var(--mock-ink); border-radius: 8px; font-size: 12px; font-weight: 600; white-space: nowrap; }

  /* Quick order table */
  .ca-hmock__stack--quick { padding-block-end: 180px; padding-inline-end: 6%; }
  .ca-hmock__stack--quick .ca-mock--project { position: absolute; right: 0; bottom: 0; width: 58%; z-index: 2; }
  .ca-hmock .ca-mock__body--quick { padding-block-end: 76px; }
  .ca-mock--project .ca-project__head > span { white-space: nowrap; }
  .ca-qo__reorder { flex: none; font-size: 12px; text-decoration: underline; text-underline-offset: 0.15em; white-space: nowrap; }
  .ca-qo { display: grid; font-size: 12px; }
  .ca-qo__row { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(0, 0.85fr) minmax(0, 0.9fr) minmax(0, 0.95fr) 70px minmax(0, 0.95fr); gap: 8px; align-items: center; padding-block: 9px; border-top: 1px solid var(--mock-line); }
  .ca-qo__row > span { min-width: 0; white-space: nowrap; }
  .ca-qo__row > span:nth-child(3), .ca-qo__row > span:nth-child(4), .ca-qo__row > span:last-child { text-align: right; }
  .ca-qo__row > span:last-child { font-weight: 600; }
  .ca-qo__row--head { padding-block: 0 8px; border-top: 0; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); }
  .ca-qo__row--head > span:last-child { font-weight: inherit; }
  .ca-qo__row > span:nth-child(2) { color: var(--mock-soft); }
  .ca-qo__product { display: flex; align-items: center; gap: 10px; }
  .ca-qo__product > span { display: grid; gap: 2px; min-width: 0; }
  .ca-qo__product strong { font-weight: 600; white-space: normal; }
  .ca-qo__product small { display: none; font-size: 11px; color: var(--mock-soft); white-space: normal; }
  .ca-qo__row.is-zero { color: var(--mock-soft); }
  .ca-qo__row.is-zero .ca-mock__swatch, .ca-qo__row.is-zero .ca-paintbox__step { opacity: 0.45; }
  .ca-qo__row.is-zero strong, .ca-qo__row.is-zero > span:last-child { font-weight: 400; }
  .ca-qo .ca-paintbox__step { background: #fff; }
  .ca-qo__foot { display: grid; gap: 14px; padding-block-start: 16px; border-top: 1px solid var(--mock-ink); }
  .ca-qo__sum { display: flex; justify-content: space-between; align-items: center; gap: 8px 16px; flex-wrap: wrap; font-size: 14px; }
  .ca-qo__sum strong { font-weight: 600; }
  .ca-qo__sum span { font-size: 12px; color: #0f5132; white-space: nowrap; }
  .ca-qo__sum i { font-style: normal; }
  .ca-qo__actions { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 10px; }

  /* Quote (customer account: quotes and invoices) */
  .ca-hq { display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.5fr); }
  .ca-hq__list { min-width: 0; padding: 22px 16px 24px; display: grid; gap: 8px; align-content: start; background: var(--mock-tint); border-inline-end: 1px solid var(--mock-line); }
  .ca-hq__listtitle { font-size: 13px; font-weight: 600; margin-block-end: 6px; }
  .ca-hq__doc { display: grid; gap: 6px; min-width: 0; padding: 10px 12px; border: 1px solid var(--mock-line); border-radius: 8px; background: #fff; font-size: 12px; }
  .ca-hq__doc.is-on { border-color: var(--mock-ink); box-shadow: inset 3px 0 0 var(--mock-ink); }
  .ca-hq__doc div { display: grid; gap: 2px; min-width: 0; }
  .ca-hq__doc strong { font-weight: 600; }
  .ca-hq__doc span { font-size: 11px; color: var(--mock-soft); }
  .ca-hq__doc em { font-style: normal; font-weight: 600; }
  .ca-hq__open { min-width: 0; padding: 22px 24px 24px; display: grid; gap: 16px; align-content: start; }
  .ca-hmock .ca-mock__pill--wait { background: #fff4d6; color: #6b4e00; }
  .ca-hq__meta { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; padding: 12px 14px; border-radius: 10px; background: var(--mock-tint); }
  .ca-hq__lines { display: grid; font-size: 12px; }
  .ca-hq__line { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 0.75fr) minmax(0, 1fr) minmax(0, 1fr); gap: 10px; padding-block: 8px; border-top: 1px solid var(--mock-line); }
  .ca-hq__line > span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-hq__line > span:not(:first-child) { text-align: right; }
  .ca-hq__line > span:last-child { font-weight: 600; }
  .ca-hq__line--head { padding-block: 0 8px; border-top: 0; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mock-soft); }
  .ca-hq__line--head > span:last-child { font-weight: inherit; }
  .ca-hq__sums { display: grid; gap: 6px; padding-block-start: 12px; border-top: 1px solid var(--mock-line); }
  .ca-hq__note { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 1px solid var(--mock-line); border-radius: 10px; font-size: 12px; min-width: 0; }
  .ca-hq__note div { display: grid; gap: 3px; min-width: 0; }
  .ca-hq__note strong { font-weight: 600; }
  .ca-hq__note div span { color: var(--mock-soft); }
  .ca-hq__actions { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 10px; }
  .ca-checkout__submit--ghost { background: transparent; color: var(--mock-ink); border: 1px solid var(--mock-ink); }

  /* Narrow cards (phones, and the half-width column on small desktops) */
  @container (max-width: 540px) {
    .ca-qo__row { grid-template-columns: minmax(0, 1fr) 76px minmax(0, 0.5fr); }
    .ca-qo__row > span:nth-child(2), .ca-qo__row > span:nth-child(3), .ca-qo__row > span:nth-child(4) { display: none; }
    .ca-qo__product small { display: block; }
    .ca-hq { grid-template-columns: minmax(0, 1fr); }
    .ca-hq__list { border-inline-end: 0; border-bottom: 1px solid var(--mock-line); padding: 18px 16px; }
    .ca-hq__doc { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .ca-hq__open { padding: 18px 16px 20px; }
  }
  @container (max-width: 400px) {
    .ca-acct__facts, .ca-hq__meta { grid-template-columns: minmax(0, 1fr); }
    .ca-acct__loc small { display: none; }
    .ca-qo__actions, .ca-hq__actions { grid-template-columns: minmax(0, 1fr); }
    .ca-hmock .ca-mock__head { flex-wrap: wrap; }
  }

  @media screen and (max-width: 989px) {
    .ca-hmock__intro { margin-block-end: 48px; }
    .ca-hmock__row { gap: 40px 24px; }
    .ca-hmock__copy, .ca-hmock__media,
    .ca-hmock--left .ca-hmock__copy, .ca-hmock--left .ca-hmock__media { grid-column: 1 / -1; order: initial; }
    .ca-hmock__heading { font-size: var(--ca-fs-36); }
    .ca-hmock .ca-mock { font-size: 13px; }
    .ca-hmock .ca-mock__body { padding: 18px 16px 20px; }
    .ca-hmock__stack--trade { padding-block-end: 0; padding-inline-end: 0; display: grid; gap: 16px; }
    .ca-hmock__stack--trade .ca-mock--outcome { position: static; width: auto; }
    .ca-hmock__stack--company, .ca-hmock__stack--quick { padding: 0; display: grid; gap: 16px; }
    .ca-hmock__stack--company .ca-mock--orders, .ca-hmock__stack--quick .ca-mock--project { position: static; width: auto; }
    .ca-acct { padding: 0 16px 20px; }
    .ca-acct__bar { margin-inline: -16px; padding-inline: 16px; }
    .ca-hmock .ca-mock__body--quick { padding-block-end: 20px; }
    .ca-hmock__stack--calc, .ca-hmock__stack--samples { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .ca-hmock__stack--samples .ca-mock--followup { margin-block-start: 0; }
    .ca-hmock__stack--calc .ca-mock--paint { margin-block-start: 0; }
    .ca-form { grid-template-columns: minmax(0, 1fr); }
    .ca-form__field--wide { grid-column: auto; }
  }

  @media screen and (max-width: 749px) {
    .ca-checkout { grid-template-columns: minmax(0, 1fr); }
    .ca-checkout__side { border-inline-start: 0; border-top: 1px solid var(--mock-line); }
    .ca-checkout__main, .ca-checkout__side { padding: 18px 16px 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vertical hub UI mock",
  "tag": "section",
  "class": "ca-hmock-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "A copy column beside a static recreation of a storefront UI. The mock is decorative; say everything that matters in the copy. An article replaces the copy through custom.<key>_heading, custom.<key>_text and custom.<key>_caption when the metafield key below is set." },
    {
      "type": "select",
      "id": "variant",
      "label": "Mock",
      "options": [
        { "value": "trade", "label": "Trade application and approval" },
        { "value": "calculator", "label": "Product page buy box with Add to Project" },
        { "value": "samples", "label": "Sample order and the follow-up" },
        { "value": "checkout", "label": "Checkout with pallet freight and Net 30" },
        { "value": "company", "label": "B2B company account: price list, terms, locations" },
        { "value": "quickorder", "label": "Quick order table with Add to Project" },
        { "value": "quote", "label": "Quote open in the customer account" }
      ],
      "default": "trade"
    },
    {
      "type": "select",
      "id": "mock_side",
      "label": "Mock position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "header", "content": "Chapter intro (optional, on the first mock)" },
    { "type": "text", "id": "intro_eyebrow", "label": "Intro eyebrow" },
    { "type": "inline_richtext", "id": "intro_heading", "label": "Intro statement", "info": "Bold the words to emphasise; the rest is shown muted. custom.hub_mocks_heading on the article replaces it, and custom.hub_mocks_eyebrow replaces the intro eyebrow." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "App link label", "info": "Name the app as ours and link its page, for example B2B Onboarding & Wholesale." },
    { "type": "url", "id": "link_url", "label": "App link" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "override_key", "label": "Article metafield key", "info": "A prefix: hub_mock_trade reads custom.hub_mock_trade_heading, _text, _caption, _eyebrow and _points (a list that replaces the bullets) from the article when set." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet",
      "settings": [{ "type": "text", "id": "label", "label": "Label" }]
    }
  ],
  "presets": [{ "name": "Vertical hub UI mock", "category": "Conspire" }]
}
{% endschema %}
