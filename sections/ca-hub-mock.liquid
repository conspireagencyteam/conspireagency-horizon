                    <div class="ca-hq__line"><span>Stoneware Mug, Sage</span><span>4</span><span>$129.60</span><span>$518.40</span></div>
                    <div class="ca-hq__line"><span>Oak Serving Board</span><span>3</span><span>$162.00</span><span>$486.00</span></div>
                    <div class="ca-hq__line"><span>Linen Napkin, Charcoal</span><span>2</span><span>$288.00</span><span>$576.00</span></div>
                  </div>
                  <div class="ca-hq__sums">
