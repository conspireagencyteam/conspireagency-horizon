                    <div class="ca-qo__actions"><span class="ca-buybox__btn ca-buybox__btn--solid">Add 15 cases to cart</span><span class="ca-buybox__btn ca-buybox__btn--outline"><span class="ca-project__heart">♡</span> Add to Project</span></div>
