{%- comment -%}
  ca-booking.liquid — Conspire Agency booking / scheduling block
  (Conspire v2.0, Figma 97-489).

  Layout: heading (top-left) + eyebrow (top-right), then two columns —
    LEFT  : a dark rounded panel with a top-down "spiral staircase" photo
            montage (section "photo" blocks, image_picker each). Tiles are
            arranged along a spiral seen from above and continuously CLIMB the
            spiral toward the viewer — emerging small/blurred/dark near the
            centre (deep down the well), then winding outward while growing,
            sharpening and brightening until they reach the front rim and fade,
            cycling seamlessly. Depth is faked with per-phase scale, z-index,
            blur and opacity.
    RIGHT : a Calendly inline embed (matches the live site).

  Calendly is lazy-loaded by the <ca-calendly> element at the bottom of this file.

  The copy over the montage can come from the article: the two "Article metafield
  key" settings name custom.* metafields (single or multi-line text) that replace the
  panel heading and text when set, so one template can end every vertical hub page in
  the page's own words (docs/VERTICAL-HUBS.md).

  After a booking: Calendly's iframe announces it (postMessage
  calendly.event_scheduled) and the section then says what to expect on the call,
  over the montage on wide screens and under the calendar on narrow ones. The
  words wait in a <template>, so nothing is on the page until then. Shown only
  when "Show what to expect after someone books" is on; ?ca_booked=1 on the page
  address shows it either way, to read the words without booking.
{%- endcomment -%}

{%- liquid
  assign photos = section.blocks
  assign photo_count = photos.size
  assign montage_bg = section.settings.montage_background | default: '#0d110d'

  assign panel_heading = section.settings.panel_heading
  assign panel_text = section.settings.panel_text
  if article != blank
    assign heading_key = section.settings.panel_heading_key | strip
    if heading_key != blank and article.metafields.custom[heading_key].value != blank
      assign panel_heading = article.metafields.custom[heading_key].value
    endif
    assign text_key = section.settings.panel_text_key | strip
    if text_key != blank and article.metafields.custom[text_key].value != blank
      assign panel_text = article.metafields.custom[text_key].value
    endif
  endif

  assign booked_video_id = section.settings.booked_video_id | strip
  assign booked_now = false
  if request.design_mode and section.settings.booked_preview
    assign booked_now = true
  endif
  assign booked_announce = section.settings.booked_eyebrow | append: '. ' | append: section.settings.booked_heading | strip_html | strip
-%}

{%- capture booked_panel -%}
  <div
    class="ca-booking__booked{% if booked_now %} is-in{% endif %}"
    style="--ca-montage-bg: {{ montage_bg }};"
    data-announce="{{ booked_announce | escape }}"
  >
    <div class="ca-booking__booked-inner{% if booked_video_id != blank %} ca-booking__booked-inner--video{% endif %}">
      <div class="ca-booking__booked-copy">
        {%- if section.settings.booked_eyebrow != blank -%}
          <p class="ca-eyebrow">{{ section.settings.booked_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.booked_heading != blank -%}
          <h3 class="ca-statement ca-statement--xl ca-booking__booked-heading">{{ section.settings.booked_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.booked_text != blank -%}
          <div class="ca-booking__booked-text">{{ section.settings.booked_text }}</div>
        {%- endif -%}
      </div>
      {%- if booked_video_id != blank -%}
        <div class="ca-booking__booked-video">
          {%- if section.settings.booked_video_caption != blank -%}
            <p class="ca-booking__booked-caption">{{ section.settings.booked_video_caption }}</p>
          {%- endif -%}
          {% render 'ca-estimate-video', id: booked_video_id, title: section.settings.booked_video_title %}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

<div
  id="book-a-call"
  class="ca-booking spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.booked_enabled %}data-booked-enabled{% endif %}
  {% if booked_now %}data-booked="1"{% endif %}
>
  {% render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  %}
  <div class="ca-inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="ca-booking__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ca-booking__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="ca-eyebrow ca-booking__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ca-booking__grid">
      {%- comment -%} LEFT — top-down spiral-staircase photo montage {%- endcomment -%}
      <div class="ca-booking__montage" style="--ca-montage-bg: {{ montage_bg }};">
        {%- if photo_count > 0 -%}
          {%- comment -%}
            SPIRAL MATH (all computed in Liquid → passed as CSS custom props so
            it is stable for ANY photo-block count).

            Every tile shares ONE spiral trajectory keyframe (ca-booking-climb)
            that carries it from the centre of the well (phase 0: small, dark,
            blurred, low z) out to the front rim (phase 1: large, bright, sharp,
            high z) then fades it out so the loop wraps seamlessly. Every tile
            follows the SAME path (angle 0→720° = two turns, radius + scale grow
            outward); they differ only in WHEN they are along it:

              --ca-delay   : a NEGATIVE animation-delay = -(index/count)·duration
                             so the tiles are evenly distributed in time along
                             the one spiral — small/blurred near the centre,
                             large/sharp at the rim — reading as a continuous
                             climb. (--ca-a/--ca-r/--ca-s are the static snapshot
                             used only for the reduced-motion fallback.)
          {%- endcomment -%}
          {%- assign climb_dur = 26 -%}
          {%- comment -%} Duplicate the photo blocks until there are at least 32
            tiles, so the spiral stays long/full even with only a few photos. {%- endcomment -%}
          {%- assign min_tiles = 32 -%}
          {%- assign total_tiles = photo_count -%}
          {%- if photo_count < min_tiles -%}
            {%- assign reps = min_tiles | plus: photo_count | minus: 1 | divided_by: photo_count -%}
            {%- assign total_tiles = photo_count | times: reps -%}
          {%- endif -%}
          <div class="ca-booking__spiral" style="--ca-spiral-count: {{ total_tiles }}; --ca-climb-dur: {{ climb_dur }}s;">
            {%- for i in (1..total_tiles) -%}
              {%- assign idx = forloop.index0 -%}
              {%- assign block_index = idx | modulo: photo_count -%}
              {%- assign block = photos[block_index] -%}
              {%- comment -%} phase each tile evenly in TIME along the ONE shared spiral {%- endcomment -%}
              {%- assign delay_ms = idx | times: climb_dur | times: 1000 | divided_by: total_tiles -%}
              {%- assign delay = 0 | minus: delay_ms -%}
              {%- comment -%} static snapshot for reduced-motion: angle 0→720°, radius+scale grow outward (per-mille) {%- endcomment -%}
              {%- assign a_deg = idx | times: 720 | divided_by: total_tiles -%}
              {%- assign r_pm = idx | times: idx | times: 820 | divided_by: total_tiles | divided_by: total_tiles | plus: 180 -%}
              {%- assign s_pm = idx | times: 650 | divided_by: total_tiles | plus: 350 -%}
              {%- assign tilt_seed = idx | modulo: 5 -%}
              {%- assign tilt = tilt_seed | times: 4 | minus: 8 -%}
              <div
                class="ca-booking__tile"
                style="--ca-delay: {{ delay }}ms; --ca-tilt: {{ tilt }}deg; --ca-a: {{ a_deg }}deg; --ca-r: {{ r_pm }}; --ca-s: {{ s_pm }};"
                {% if idx < photo_count %}{{ block.shopify_attributes }}{% endif %}
              >
                {%- if block.settings.image != blank -%}
                  {% render 'image',
                    image: block.settings.image,
                    width: 240,
                    class: 'ca-booking__photo',
                    alt_text_fallback: 'Conspire project'
                  %}
                {%- else -%}
                  <span class="ca-booking__photo ca-booking__photo--placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- elsif request.design_mode -%}
          <p class="ca-booking__empty">Add <strong>Photo</strong> blocks to build the spiral montage.</p>
        {%- endif -%}

        {%- comment -%} Optional copy centred over the montage (Figma 315:1891) {%- endcomment -%}
        {%- if panel_heading != blank or panel_text != blank or section.settings.panel_button_label != blank -%}
          <div class="ca-booking__overlay ca-invert">
            {%- if panel_heading != blank -%}
              <p class="ca-booking__overlay-heading">{{ panel_heading }}</p>
            {%- endif -%}
            {%- if panel_text != blank -%}
              <p class="ca-booking__overlay-text">{{ panel_text | newline_to_br }}</p>
            {%- endif -%}
            {%- if section.settings.panel_button_label != blank -%}
              {%- if section.settings.panel_button_link != blank -%}
                <a class="button size-style ca-booking__overlay-button" href="{{ section.settings.panel_button_link }}">
                  {{- section.settings.panel_button_label -}}
                </a>
              {%- else -%}
                <button type="button" class="button size-style ca-booking__overlay-button">
                  {{- section.settings.panel_button_label -}}
                </button>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT — Calendly inline embed {%- endcomment -%}
      <div class="ca-booking__calendar" style="--ca-booking-h: {{ section.settings.calendly_height | default: 700 }}px;">
        {%- if section.settings.calendly_url != blank -%}
          {%- comment -%}
            Lazy: the Calendly iframe is ~3 MB of JS and CSS, so it is only
            created once this section is within a screen of the viewport (see
            <ca-calendly> below). The iframe is created by Calendly's widget.js,
            so a title attribute can't be set here.
          {%- endcomment -%}
          <ca-calendly
            class="ca-booking__embed"
            data-url="{{ section.settings.calendly_url }}"
            style="min-width:320px;height:{{ section.settings.calendly_height | default: 700 }}px;"
          >
            <a class="ca-booking__fallback" href="{{ section.settings.calendly_url }}" target="_blank" rel="noopener">Open the scheduler</a>
          </ca-calendly>
        {%- elsif request.design_mode -%}
          <p class="ca-booking__empty">Add a <strong>Calendly URL</strong> in this section's settings.</p>
        {%- endif -%}
      </div>

      {%- comment -%} AFTER A BOOKING: what to expect on the call (see the header comment) {%- endcomment -%}
      {%- if booked_now -%}
        {{ booked_panel }}
      {%- else -%}
        <template data-ca-booked>{{ booked_panel }}</template>
      {%- endif -%}
    </div>
    <p class="visually-hidden" role="status" data-ca-booked-status></p>
  </div>
</div>

{% stylesheet %}
  .ca-booking {
    background-color: var(--color-background);
    /* "Book a call" buttons link to #book-a-call; keep the panel clear of the sticky header. */
    scroll-margin-block-start: 80px;
  }

  /* Copy over the montage: always light-on-dark, whatever the section colours. */
  .ca-booking__overlay {
    --color-foreground: #ffffff;
    --color-foreground-rgb: 255 255 255;
    --color-background: var(--ca-montage-bg, #0d110d);
    position: absolute;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 24px;
    text-align: center;
    color: #ffffff;
    pointer-events: none;
  }

  .ca-booking__overlay > * {
    pointer-events: auto;
  }

  .ca-booking__overlay-heading {
    margin: 0;
    font-size: var(--ca-fs-48);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ca-booking__overlay-text {
    max-width: 440px;
    margin: 0;
    color: rgb(255 255 255 / 0.8);
  }

  .ca-booking__head {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: end;
    margin-block-end: 48px;
  }

  .ca-booking__heading {
    margin: 0;
    text-indent: 8vw;
  }

  .ca-booking__eyebrow {
    justify-self: end;
    text-align: end;
    margin: 0;
  }

  /* Column split mirrors the Figma frame: montage panel 904px, calendar
     432px, 24px gutter → ~2.09 : 1. */
  .ca-booking__grid {
    display: grid;
    grid-template-columns: 1fr 432px;
    gap: 24px;
    align-items: stretch;
  }

  /* ---- LEFT: dark panel + top-down spiral-staircase montage ------------ */
  .ca-booking__montage {
    position: relative;
    overflow: hidden;
    background-color: var(--ca-montage-bg, #0d110d);
    display: grid;
    place-items: center;
    /* soft vignette darkening toward the centre of the well so tiles reaching
       the middle read as receding "down" the spiral staircase. */
    isolation: isolate;
  }

  .ca-booking__montage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 60;
    background: radial-gradient(
      circle at 50% 50%,
      rgb(0 0 0 / 0.55) 0%,
      rgb(0 0 0 / 0.28) 24%,
      rgb(0 0 0 / 0) 52%
    );
  }

  /* The spiral is a centred square stage. Every tile is absolutely centred and
     shares ONE climb trajectory; individual tiles carry a base angular offset
     (--ca-spin) and a negative time offset (--ca-delay) so they populate the
     spiral evenly and ascend it continuously. */
  .ca-booking__spiral {
    position: relative;
    width: 300%;
    height: 300%;
    /* mirror the whole stage to flip the spiral's winding direction to match
       Figma; the photos are un-mirrored below so images stay correct.
       --ca-spiral-orient rotates the spiral so the start (where tiles emerge)
       sits up-and-right; --ca-spiral-x / --ca-spiral-y nudge the whole spiral in
       screen space (negative x = left, positive y = down) so the first visible
       item reads as centred. Tweak all three to taste. */
    transform:
      translate(var(--ca-spiral-x, -60px), var(--ca-spiral-y, 60px))
      rotate(var(--ca-spiral-orient, 90deg))
      scaleX(-1);
    /* absolute max radius (the front rim). % would resolve against the tile,
       not the stage, so use absolute units. */
    --ca-spiral-radius: 600px;
  }

  .ca-booking__tile {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(82px, 20%, 132px);
    aspect-ratio: 1 / 1;
    margin: calc(clamp(82px, 20%, 132px) / -2);
    transform-origin: center;
    /* The climb keyframe drives rotation (winding around the well), outward
       translate (radius grows with phase → the log-spiral feel), scale
       and z-index. --ca-tilt is a fixed lean carried through in each waypoint.
       Because scale is animated on the tile itself, and the trajectory ends
       where it began (radius 0), the loop wraps seamlessly. */
    animation:
      ca-booking-climb var(--ca-climb-dur, 26s) linear infinite,
      ca-booking-fade var(--ca-climb-dur, 26s) linear infinite;
    animation-delay: var(--ca-delay, 0s), var(--ca-delay, 0s);
    will-change: transform, opacity;
  }

  .ca-booking__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
    /* scaleX(-1) un-mirrors the image against the mirrored stage. */
    transform: scaleX(-1) rotate(var(--ca-tilt, 0deg));
    /* blur is animated separately so it can peak deep in the well (centre) and
       clear as the tile rises to the front. */
    animation: ca-booking-focus var(--ca-climb-dur, 26s) linear infinite;
    animation-delay: var(--ca-delay, 0s);
    will-change: filter;
  }

  .ca-booking__photo--placeholder {
    background: rgb(255 255 255 / 0.08);
    animation: ca-booking-focus var(--ca-climb-dur, 26s) linear infinite;
    animation-delay: var(--ca-delay, 0s);
  }

  /* CLIMB — the spiral trajectory, seen from the top. Phase 0 = bottom of the
     well (centre, tiny, transparent, behind everything); phase ~0.85 = front
     rim (full radius, largest, brightest, in front); then it fades out and
     snaps back to the centre for the next tile. The rotate() term advances a
     full turn across the loop so tiles WIND around the spiral as they rise, and
     --ca-spin gives each tile a different starting bearing. */
  @keyframes ca-booking-climb {
    0%    { transform: rotate(0deg)   translate(calc(var(--ca-spiral-radius) * 0.18)) rotate(0deg)    scale(0); z-index: 1; }
    12.5% { transform: rotate(90deg)  translate(calc(var(--ca-spiral-radius) * 0.24)) rotate(-90deg)  scale(0.125); z-index: 2; }
    25%   { transform: rotate(180deg) translate(calc(var(--ca-spiral-radius) * 0.33)) rotate(-180deg) scale(0.25); z-index: 3; }
    37.5% { transform: rotate(270deg) translate(calc(var(--ca-spiral-radius) * 0.40)) rotate(-270deg) scale(0.375); z-index: 4; }
    50%   { transform: rotate(360deg) translate(calc(var(--ca-spiral-radius) * 0.48)) rotate(-360deg) scale(0.5); z-index: 5; }
    62.5% { transform: rotate(450deg) translate(calc(var(--ca-spiral-radius) * 0.56)) rotate(-450deg) scale(0.625); z-index: 6; }
    75%   { transform: rotate(540deg) translate(calc(var(--ca-spiral-radius) * 0.641)) rotate(-540deg) scale(0.75); z-index: 7; }
    87.5% { transform: rotate(630deg) translate(calc(var(--ca-spiral-radius) * 0.808)) rotate(-630deg) scale(0.875); z-index: 8; }
    100%  { transform: rotate(720deg) translate(calc(var(--ca-spiral-radius) * 1)) rotate(-720deg) scale(1); z-index: 9; }
  }

  /* OPACITY — isolated so the fade-out point is easy to tune. Change the 80%
     stop to move where each image disappears along its climb. */
  @keyframes ca-booking-fade {
    0%   { opacity: 0; }
    10%  { opacity: 1; }
    92%  { opacity: 1; }
    95%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* FOCUS — blurred deep in the well, sharp at the front rim, softening again
     as it flies past the near edge. Kept on the inner photo so it composes with
     the tile's transform without smearing the z-index sort. */
  @keyframes ca-booking-focus {
    0% { filter: blur(20px) brightness(0.6); }
    45% { filter: blur(0) brightness(0.9); }
    100% { filter: blur(0) brightness(1); }
  }

  /* ---- RIGHT: Calendly ------------------------------------------------- */
  .ca-booking__calendar {
    overflow: hidden;
    /* White so the box reads as a full-height panel beside the montage. Calendly's
       current embed draws a content-height card on a transparent background, so
       without this the section background shows under the calendar. */
    background-color: var(--ca-booking-calendar-bg, #fff);
    /* Calendly's resize option sets the embed's height to the scheduler's content
       (including a ~20px loading state), so the column keeps its own minimum
       height — the montage row never collapses — and centres the embed. */
    min-height: var(--ca-booking-h, 700px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ca-booking__empty {
    padding: 40px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text, 0.6));
  }

  .ca-booking__embed {
    display: block;
    width: 100%;
  }

  .ca-booking__fallback {
    display: inline-block;
    margin: 40px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text, 0.6));
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- AFTER A BOOKING: what to expect on the call ---------------------- */
  /* Shares the montage's grid cell on wide screens (a scrim over the spiral,
     which keeps moving behind it) and takes its own row under the calendar on
     narrow ones. Always light-on-dark, whatever the section colours. */
  .ca-booking__montage,
  .ca-booking__booked {
    grid-column: 1;
    grid-row: 1;
  }

  .ca-booking__calendar {
    grid-column: 2;
    grid-row: 1;
  }

  .ca-booking__booked {
    --color-foreground: #ffffff;
    --color-foreground-rgb: 255 255 255;
    --color-background: var(--ca-montage-bg, #0d110d);
    /* The theme's link hover reads --color-rgb, which the section's own text
       colour sets (dark): without this a hovered link goes dark on dark. */
    --color-rgb: 255 255 255;
    position: relative;
    /* Above the montage only (its tiles are isolated inside it). Kept under the
       sticky header and the partner ribbon, which sit at layer 12. */
    z-index: 1;
    /* Clear of the sticky header when the preview scrolls to it. */
    scroll-margin-block-start: 96px;
    container-type: inline-size;
    display: flex;
    align-items: center;
    padding: 48px;
    color: #ffffff;
    background-color: color-mix(in srgb, var(--ca-montage-bg, #0d110d) 88%, transparent);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .ca-booking__booked.is-in {
    opacity: 1;
  }

  .ca-booking__booked-inner {
    display: grid;
    gap: 32px;
    width: 100%;
    max-width: 560px;
  }

  .ca-booking__booked-heading {
    margin-block-start: 16px;
    text-indent: 0;
  }

  /* Each paragraph is one short line of the list, ruled above and below. */
  .ca-booking__booked-text {
    margin-block-start: 28px;
  }

  .ca-booking__booked-text p {
    margin: 0;
    padding-block: 14px;
    border-block-start: 1px solid rgb(255 255 255 / 0.16);
    color: rgb(255 255 255 / 0.82);
    line-height: 1.45;
  }

  .ca-booking__booked-text p:last-child {
    border-block-end: 1px solid rgb(255 255 255 / 0.16);
  }

  .ca-booking__booked-text a {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 3px;
  }

  .ca-booking__booked-text a:hover {
    color: rgb(255 255 255 / 0.7);
  }

  .ca-booking__booked-video {
    max-width: 360px;
  }

  /* The poster's play pill, sized for this smaller frame. */
  .ca-booking__booked-video .ca-estimate__video-play {
    inset-block-end: 12px;
    inset-inline-start: 12px;
    padding: 8px 14px 8px 10px;
    font-size: 0.875rem;
  }

  .ca-booking__booked-caption {
    margin: 0 0 12px;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @container (min-width: 800px) {
    .ca-booking__booked-inner--video {
      max-width: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
      gap: 48px;
      align-items: center;
    }

    .ca-booking__booked-inner--video .ca-booking__booked-video {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-booking__tile,
    .ca-booking__photo,
    .ca-booking__photo--placeholder {
      animation: none !important;
    }

    /* With motion disabled, freeze the tiles into a static top-down spiral
       spread (using their base spin bearing) so the panel still reads as a
       spiral montage rather than a single stack in the centre. */
    .ca-booking__tile {
      transform:
        rotate(var(--ca-a, 0deg))
        translate(calc(var(--ca-spiral-radius) * var(--ca-r, 500) / 1000))
        rotate(calc(-1 * var(--ca-a, 0deg)))
        scale(calc(var(--ca-s, 700) / 1000));
      opacity: 1;
    }

    .ca-booking__photo {
      filter: none;
    }

    .ca-booking__booked {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-booking__head {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-block-end: 32px;
    }

    .ca-booking__eyebrow {
      justify-self: start;
      text-align: start;
    }

    .ca-booking__grid {
      grid-template-columns: 1fr;
      grid-template-rows: 300px 1fr;
      gap: 24px;
    }

    .ca-booking__spiral {
      --ca-spiral-radius: 300px;
    }

    /* smaller tiles to suit the reduced mobile radius (margin = -½ width to keep
       each tile centred on the spiral). */
    .ca-booking__tile {
      width: 64px;
      margin: -32px;
    }

    .ca-booking__calendar {
      grid-column: 1;
      grid-row: 2;
    }

    /* Its own row under the calendar: the 300px montage row is too short for it. */
    .ca-booking__booked {
      grid-row: 3;
      padding: 32px 24px;
      background-color: var(--ca-montage-bg, #0d110d);
      backdrop-filter: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Defers Calendly's widget.js and the inline iframe until the booking block
  // is within ~a screen of the viewport, instead of on every page load.
  class CaCalendly extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      if (!('IntersectionObserver' in window) || (window.Shopify && window.Shopify.designMode)) {
        this.load();
        return;
      }
      this._io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        this._io.disconnect();
        this.load();
      }, { rootMargin: '600px 0px' });
      this._io.observe(this);
    }

    disconnectedCallback() {
      this._io?.disconnect();
    }

    load() {
      if (this.dataset.ready) return;
      this.dataset.ready = '1';
      const init = () => {
        if (!window.Calendly) return;
        this.replaceChildren();
        // resize: the iframe follows the scheduler's content height instead of
        // a fixed 700px, so it can be centred in the column (see .ca-booking__embed).
        const url = window.caFirstTouchUrl ? window.caFirstTouchUrl(this.dataset.url) : this.dataset.url;
        window.Calendly.initInlineWidget({ url, parentElement: this, resize: true });
      };
      if (window.Calendly) return init();
      let script = document.querySelector('script[data-ca-calendly]');
      if (!script) {
        script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.dataset.caCalendly = '1';
        document.head.appendChild(script);
      }
      script.addEventListener('load', init, { once: true });
    }
  }
  if (!customElements.get('ca-calendly')) customElements.define('ca-calendly', CaCalendly);

  // After a booking the section says what to expect on the call. The words wait
  // in a <template> inside the grid; showing them is a clone, once per section.
  function caBookingShowBooked(root, reveal) {
    if (!root || root.dataset.booked) return;
    const tpl = root.querySelector('template[data-ca-booked]');
    const grid = root.querySelector('.ca-booking__grid');
    if (!tpl || !grid) return;
    root.dataset.booked = '1';
    grid.appendChild(tpl.content.cloneNode(true));
    const panel = grid.querySelector('.ca-booking__booked');
    if (!panel) return;
    const status = root.querySelector('[data-ca-booked-status]');
    if (status) status.textContent = panel.dataset.announce || '';
    // A beat later, so the fade starts from the hidden state (a timer, not a
    // frame callback: frames do not run while the tab is in the background).
    setTimeout(() => panel.classList.add('is-in'), 40);
    if (reveal) {
      // The preview only: bring it into view once the page has settled, and once
      // more after the calendar has loaded (Calendly's embed pulls the scroll to itself).
      const show = () => {
        const top = panel.getBoundingClientRect().top;
        if (top < 0 || top > window.innerHeight * 0.5) panel.scrollIntoView({ block: 'start' });
      };
      const go = () => [800, 4500].forEach((ms) => setTimeout(show, ms));
      if (document.readyState === 'complete') go();
      else window.addEventListener('load', go, { once: true });
    }
  }

  // Calendly announces a booking from its iframe. Only the section that holds
  // that iframe answers, and only when the setting is on.
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com' || !e.data || e.data.event !== 'calendly.event_scheduled') return;
    document.querySelectorAll('.ca-booking[data-booked-enabled]').forEach((root) => {
      const own = Array.from(root.querySelectorAll('iframe')).some((frame) => frame.contentWindow === e.source);
      if (own) caBookingShowBooked(root, false);
    });
  });

  // ?ca_booked=1 shows it without a booking, setting on or off, to read the words.
  if (new URLSearchParams(window.location.search).has('ca_booked')) {
    const preview = () => document.querySelectorAll('.ca-booking').forEach((root, i) => caBookingShowBooked(root, i === 0));
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', preview, { once: true });
    else preview();
  }
{% endjavascript %}

