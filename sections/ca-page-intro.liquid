{%- comment -%}
  ca-page-intro.liquid — eyebrow + large statement, optional button
  (Conspire v2.0: page heroes such as Our Work 315:1652 and Careers 474:1218,
  and mid-page statements such as Shopify migrations 396:187).

  The statement is rich text, so it can run to several paragraphs; bold marks
  the emphasised words and the rest drops back. Set the heading level to H1
  when this is the first section on a page. With "Allow transparent header" on
  it also works under the overlaid header like the homepage hero does.
{%- endcomment -%}

{%- liquid
  assign tag = section.settings.heading_tag | default: 'div'
  assign transparent = section.settings.allow_transparent_header
-%}

{%- if transparent and section.settings.text_color != blank -%}
  {%- style -%}
    .ca-header { --ca-header-transparent-text: {{ section.settings.text_color }}; }
  {%- endstyle -%}
{%- endif -%}

<div
  class="ca-pintro spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}{% if transparent %} ca-allow-transparent-header ca-under-header{% endif %}{% if section.settings.rule %} ca-pintro--rule{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- render 'ca-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      tag: tag,
      start: section.settings.column_start,
      size: section.settings.size,
      button_label: section.settings.button_label,
      button_link: section.settings.button_link,
      button_class: section.settings.style_class
    -%}
  </div>
</div>

{% stylesheet %}
  .ca-pintro {
    background-color: var(--color-background);
  }

  .ca-pintro--rule .ca-inner::after {
    content: "";
    display: block;
    margin-block-start: 80px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page intro",
  "tag": "section",
  "class": "ca-pintro-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shopify services" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Statement",
      "info": "Bold the words to emphasise. The rest is shown muted.",
      "default": "<p>We build Shopify stores for brands that are ready to scale.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1 (page title)" },
        { "value": "h2", "label": "H2" },
        { "value": "div", "label": "None (plain text)" }
      ],
      "default": "div"
    },
    {
      "type": "select",
      "id": "column_start",
      "label": "Statement width",
      "options": [
        { "value": "5", "label": "Wide (8 of 12 columns)" },
        { "value": "6", "label": "Medium (7 of 12 columns)" },
        { "value": "7", "label": "Half" }
      ],
      "default": "5"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Statement size",
      "options": [
        { "value": "display", "label": "Display (page title)" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Medium" }
      ],
      "default": "lg"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" }
      ],
      "default": "button"
    },
    { "type": "checkbox", "id": "rule", "label": "Hairline under the section", "default": false },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "Run under a transparent header",
      "info": "For a dark first section: the header sits on top of it and takes the text color below.",
      "default": false
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Page intro", "category": "Conspire" }]
}
{% endschema %}
