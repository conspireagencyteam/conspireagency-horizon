{%- comment -%}
  ca-hub-outcomes.liquid — "What changes": three short statements, each an outcome for
  the brand, not a service (Conspire v2.0 art direction; the value cards layout with
  numbered eyebrows over hairlines).

  Items come from the article's custom.hub_outcomes metafield (a list of single line
  text, one statement per entry), falling back to the "Statements" setting (one per
  line). Renders nothing when there are no items, except an editor hint.
{%- endcomment -%}

{%- liquid
  assign items = article.metafields.custom.hub_outcomes.value
  if items == blank and section.settings.items != blank
    assign items = section.settings.items | newline_to_br | split: '<br />'
  endif

  assign count = 0
  for item in items
    assign item_text = item | strip
    if item_text != blank
      assign count = count | plus: 1
    endif
  endfor
-%}

{%- if count > 0 or request.design_mode -%}
  <div
    class="ca-outcomes spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- render 'contrast-override',
      background_color: section.settings.background_color,
      text_color: section.settings.text_color,
      section_id: section.id
    -%}
    <div class="ca-inner">
      {%- if section.settings.heading != blank -%}
        {%- render 'ca-intro',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          start: 6,
          class: 'ca-outcomes__intro'
        -%}
      {%- elsif section.settings.eyebrow != blank -%}
        <h2 class="ca-eyebrow ca-outcomes__eyebrow">{{ section.settings.eyebrow }}</h2>
      {%- endif -%}

      {%- if count > 0 -%}
        <ol class="ca-outcomes__grid" style="--ca-outcomes-count: {{ count | at_most: 4 }};">
          {%- assign n = 0 -%}
          {%- for item in items -%}
            {%- assign item_text = item | strip -%}
            {%- if item_text != blank -%}
              {%- assign n = n | plus: 1 -%}
              <li class="ca-outcome">
                {%- if section.settings.numbered -%}
                  {%- assign num = n | prepend: '0' | slice: -2, 2 -%}
                  <p class="ca-eyebrow ca-outcome__num" aria-hidden="true">{{ num }}</p>
                {%- endif -%}
                <p class="ca-outcome__text">{{ item_text }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- else -%}
        <p class="ca-outcomes__empty">Add the article's <strong>custom.hub_outcomes</strong> metafield, or statements in this section's settings.</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ca-outcomes {
    background-color: var(--color-background);
  }

  .ca-outcomes__intro {
    margin-block-end: 80px;
  }

  .ca-outcomes__eyebrow {
    margin: 0 0 40px;
    padding-block-end: 24px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  .ca-outcomes__grid {
    display: grid;
    grid-template-columns: repeat(var(--ca-outcomes-count, 3), minmax(0, 1fr));
    gap: 48px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-outcome {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .ca-outcome__num {
    padding-block-end: 16px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  /* A statement runs to 30 words, so it sits on the 24px tier: a column reads as
     one thought, not a headline. */
  .ca-outcome__text {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: var(--ca-fs-24);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .ca-outcomes__empty {
    padding-block: 40px;
    color: var(--ca-muted);
  }

  @media screen and (max-width: 989px) {
    .ca-outcomes__intro {
      margin-block-end: 48px;
    }

    .ca-outcomes__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vertical hub outcomes",
  "tag": "section",
  "class": "ca-outcomes-section",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "paragraph", "content": "Statements come from the article's custom.hub_outcomes metafield (a list, one outcome per entry). The Statements field below is the fallback." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What changes" },
    { "type": "inline_richtext", "id": "heading", "label": "Statement", "info": "Optional. Bold the words to emphasise; the rest is shown muted." },
    { "type": "textarea", "id": "items", "label": "Statements (fallback)", "info": "One per line, three outcomes for the brand. Used when the article has no custom.hub_outcomes metafield." },
    { "type": "checkbox", "id": "numbered", "label": "Number the statements", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Vertical hub outcomes", "category": "Conspire" }]
}
{% endschema %}
