{%- comment -%}
  ca-app-features.liquid — generic icon feature grid for app pages (shared).
  Each "feature" block: icon (inline SVG markup, or an asset filename such as
  ca-app-icon-cart.svg), h3 title, one-line text. 2 columns on mobile, 3–4 on desktop.
{%- endcomment -%}
<div
  class="ca-appfeat spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}; --ca-appfeat-cols: {{ section.settings.columns }};"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | escape }}"{% endif %}
>
  {%- render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id -%}
  <div class="ca-inner">
    {%- render 'ca-intro', eyebrow: section.settings.eyebrow, heading: section.settings.heading, start: 5, class: 'ca-appfeat__intro' -%}
    {%- if section.settings.intro != blank -%}<p class="ca-appfeat__lede">{{ section.settings.intro }}</p>{%- endif -%}
    <ul class="ca-appfeat__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="ca-appfeat__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_svg != blank -%}
            <span class="ca-appfeat__icon" aria-hidden="true">{{ block.settings.icon_svg }}</span>
          {%- elsif block.settings.icon_asset != blank -%}
            <span class="ca-appfeat__icon" aria-hidden="true">{{ block.settings.icon_asset | inline_asset_content }}</span>
          {%- endif -%}
          <h3 class="ca-appfeat__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="ca-appfeat__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="ca-appfeat__link" href="{{ block.settings.link }}"{% if block.settings.link contains '//' %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.link_label | default: 'Read the guide' }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .ca-appfeat__intro { margin-bottom: 24px; }
  .ca-appfeat__link { display: inline-block; margin-top: 10px; font-size: 0.875rem; color: var(--ca-soft); text-underline-offset: 4px; }
  .ca-appfeat__link:hover { color: rgb(var(--color-foreground-rgb)); }
  .ca-appfeat__lede { font-size: var(--ca-fs-20, 1.25rem); line-height: 1.5; color: var(--ca-soft); max-width: 46rem; margin: 0 0 40px; }
  .ca-appfeat__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 20px; border-top: 1px solid var(--ca-hairline-strong); padding-top: 32px; }
  @media (min-width: 750px) { .ca-appfeat__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 32px; } }
  @media (min-width: 1200px) { .ca-appfeat__grid { grid-template-columns: repeat(var(--ca-appfeat-cols, 4), minmax(0, 1fr)); } }
  .ca-appfeat__icon { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 10px; border: 1px solid var(--ca-hairline-strong); margin-bottom: 14px; }
  .ca-appfeat__icon svg { width: 22px; height: 22px; }
  .ca-appfeat__title { font-size: var(--ca-fs-20, 1.25rem); line-height: 1.25; margin: 0 0 8px; letter-spacing: -0.01em; }
  .ca-appfeat__text { margin: 0; line-height: 1.5; color: var(--ca-soft); font-size: 0.95rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "App: feature grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Features" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading (h2)", "default": "Everything customers need" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Optional, e.g. features (for #features links)" },
    { "type": "textarea", "id": "intro", "label": "Intro line" },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon_asset", "label": "Icon asset filename", "info": "e.g. ca-app-icon-cart.svg (in assets)" },
        { "type": "html", "id": "icon_svg", "label": "Inline SVG (overrides asset)" },
        { "type": "text", "id": "title", "label": "Title (h3)", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the guide" }
      ]
    }
  ],
  "presets": [{ "name": "App: feature grid", "category": "Conspire", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
