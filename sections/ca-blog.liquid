{%- comment -%}
  ca-blog.liquid — Conspire Agency homepage blog block (Figma ccmuKMyD8c4709qOwluhGu, node 278-2164).

  Dark section. Eyebrow (80% foreground) over a 20% hairline, then a row of
  three article cards: image (staggered desktop heights 514 / 411 / 300 on a
  448 column), H5 title (24px / 1.1), uppercase date at 60%. The "View All"
  pill sits in the third column, pinned to the bottom-right of the row.

  Source:
    "recent"   → pulls the latest posts from a chosen blog.
    "selected" → up to 6 hand-picked articles.

  Fallback images: fallback_image_1..3 (Figma card art, uploaded to Files as
  blog-fallback-N.jpg) are cycled by card index when an article has no
  featured image.

  Mobile: single column, images render at their natural aspect ratio (no
  crop); desktop crops with object-fit: cover to the Figma ratios.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.source
  assign button_label = section.settings.button_label | default: 'View All'
  assign style_class = section.settings.style_class | default: 'button-secondary'

  assign view_all = section.settings.view_all_link
  if view_all == blank and source == 'recent'
    assign view_all = blogs[section.settings.blog].url
  endif

  comment
    Build one list of article handles so both sources share a single card loop.
    (article.handle is "blog-handle/article-handle", which articles[] accepts.)
  endcomment
  assign handle_list = ''
  if source == 'selected'
    for i in (1..6)
      assign key = 'article_' | append: i
      assign picked = section.settings[key]
      if picked != blank
        assign handle_list = handle_list | append: picked.handle | append: ','
      endif
    endfor
  else
    for a in blogs[section.settings.blog].articles limit: section.settings.post_limit
      assign handle_list = handle_list | append: a.handle | append: ','
    endfor
  endif
  assign handles = handle_list | split: ','
  assign card_count = handles.size
  assign row_count = card_count | plus: 2 | divided_by: 3
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<div
  class="ca-blog spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="ca-inner ca-blog__inner">
    {%- if style_class == 'button-custom' -%}
      {%- render 'button-custom-styles', block_settings: section.settings, block_id: section.id -%}
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <h2 class="ca-eyebrow ca-blog__eyebrow">{{ section.settings.eyebrow }}</h2>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="ca-blog__grid" style="--ca-blog-rows: {{ row_count }};">
        {%- for handle in handles -%}
          {%- liquid
            assign article = articles[handle]
            if article == blank
              continue
            endif

            assign slot = forloop.index0 | modulo: 3 | plus: 1
            assign fallback_key = 'fallback_image_' | append: slot
            assign img = article.image
            assign alt = article.image.alt | default: article.title
            if img == blank
              assign img = section.settings[fallback_key]
              assign alt = ''
            endif

            if forloop.first
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
          -%}
          <a class="ca-blog-card" href="{{ article.url }}">
            <div class="ca-blog-card__media">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 1600
                  | image_tag:
                    loading: loading,
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: '(min-width: 750px) calc((min(100vw, 1440px) - 128px) / 3), calc(100vw - 32px)',
                    class: 'ca-blog-card__img',
                    alt: alt
                }}
              {%- endif -%}
            </div>
            <div class="ca-blog-card__body">
              <h3 class="ca-blog-card__title">{{ article.title }}</h3>
              {%- if article.published_at != blank -%}
                <p class="ca-blog-card__date">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %d, %Y' }}</time>
                </p>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}

        {%- if view_all != blank -%}
          <div class="ca-blog__foot">
            <a class="{{ style_class }} size-style ca-blog__more{% if style_class == 'button-custom' %} button-custom--{{ section.id }}{% endif %}" href="{{ view_all }}">{{ button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="ca-blog__empty">
        {%- if source == 'selected' -%}
          Pick <strong>articles</strong> in this section's settings to populate the blog block.
        {%- else -%}
          Choose a <strong>blog</strong> with published articles in this section's settings.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Eyebrow: Figma Text/Body/White/80% over Border/White/20% hairline, 24px apart, 40px to the grid. */
  .ca-blog__eyebrow {
    margin-block-end: 40px;
    padding-block-end: 24px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .ca-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  .ca-blog-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: inherit;
    text-decoration: none;
  }

  .ca-blog-card__media {
    aspect-ratio: 448 / 411;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
  }

  /* Desktop: staggered image heights per Figma card frames (448 col). */
  .ca-blog-card:nth-child(3n + 1) .ca-blog-card__media {
    aspect-ratio: 448 / 514;
  }

  .ca-blog-card:nth-child(3n + 2) .ca-blog-card__media {
    aspect-ratio: 448 / 411;
  }

  .ca-blog-card:nth-child(3n) .ca-blog-card__media {
    aspect-ratio: 448 / 300;
  }

  .ca-blog-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ca-blog-card:hover .ca-blog-card__img {
    transform: scale(1.03);
  }

  .ca-blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Figma Headings/H5: 24px / 1.1 / -0.03em (theme h4 token is the 24px tier). */
  .ca-blog-card__title {
    margin: 0;
    font-family: var(--font-h4--family);
    font-weight: var(--font-h4--weight, 400);
    font-size: var(--font-h4--size, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition: opacity 0.2s ease;
  }

  .ca-blog-card:hover .ca-blog-card__title {
    opacity: 0.8;
  }

  /* Figma Texts/Labels/Normal at Text/Labels/White/60%. */
  .ca-blog-card__date {
    margin: 0;
    font-size: var(--font-h6--size, 1rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* "View All" shares the last cell of the third column, pinned bottom-right. */
  .ca-blog__foot {
    grid-column: 3;
    grid-row: var(--ca-blog-rows, 1);
    align-self: end;
    justify-self: end;
    display: flex;
  }

  /* The column-3 card that precedes the foot shares its cell (explicit placement, or
     auto-placement would push it to the next row) and reserves room under its text
     so the pill never overlaps. */
  .ca-blog-card:nth-child(3n):nth-last-child(2) {
    grid-column: 3;
    grid-row: var(--ca-blog-rows, 1);
    padding-block-end: 72px;
  }

  .ca-blog__empty {
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  @media screen and (max-width: 749px) {
    .ca-blog__eyebrow {
      margin-block-end: 32px;
    }

    .ca-blog__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    /* Mobile: single column, no side-by-side comparison — show the image uncropped
       at its natural aspect ratio. */
    .ca-blog-card:nth-child(3n + 1) .ca-blog-card__media,
    .ca-blog-card:nth-child(3n + 2) .ca-blog-card__media,
    .ca-blog-card:nth-child(3n) .ca-blog-card__media {
      aspect-ratio: auto;
    }

    .ca-blog-card__img {
      height: auto;
      object-fit: unset;
    }

    .ca-blog-card:nth-child(3n):nth-last-child(2) {
      grid-column: 1;
      grid-row: auto;
      padding-block-end: 0;
    }

    .ca-blog__foot {
      grid-column: 1;
      grid-row: auto;
      align-self: auto;
      justify-self: stretch;
      margin-block-start: 8px;
    }

    /* Specificity must beat `a.button-custom.size-style` in ca-custom.css, which
       centres the content; full-width needs the chip flush-right so the circle
       sits under the absolutely-positioned arrow (else a bare dark dot shows). */
    .ca-blog__foot a.ca-blog__more.size-style {
      width: 100%;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "ca-blog-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Scale & Shopify Blog"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "recent", "label": "Recent posts" },
        { "value": "selected", "label": "Selected posts" }
      ],
      "default": "recent"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.source == 'recent' }}"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "article",
      "id": "article_4",
      "label": "Article 4"
    },
    {
      "type": "article",
      "id": "article_5",
      "label": "Article 5"
    },
    {
      "type": "article",
      "id": "article_6",
      "label": "Article 6"
    },
    {
      "type": "header",
      "content": "Fallback images",
      "info": "Used when an article has no featured image. Cycled by card position (1st, 2nd, 3rd column)."
    },
    {
      "type": "image_picker",
      "id": "fallback_image_1",
      "label": "Fallback image 1"
    },
    {
      "type": "image_picker",
      "id": "fallback_image_2",
      "label": "Fallback image 2"
    },
    {
      "type": "image_picker",
      "id": "fallback_image_3",
      "label": "Fallback image 3"
    },
    {
      "type": "header",
      "content": "View All button"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" },
        { "value": "button-custom", "label": "t:options.custom" }
      ],
      "default": "button-secondary"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ section.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ section.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ section.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0d110d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f6f7f6"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Blog",
      "category": "Conspire",
      "settings": {
        "eyebrow": "Scale & Shopify Blog",
        "source": "recent",
        "post_limit": 3,
        "button_label": "View All",
        "style_class": "button-secondary",
        "background_color": "#0d110d",
        "text_color": "#f6f7f6",
        "padding-block-start": 80,
        "padding-block-end": 80
      }
    }
  ]
}
{% endschema %}
