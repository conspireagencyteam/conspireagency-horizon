{%- comment -%}
  ca-article-header.liquid — article title block (Conspire v2.0: blog article
  443:148 + 443:155, career post 474:775).

  Date on the left, the title at display size on the right, optional job pills
  under the title (career posts).

  Hero media (right column, visible without scrolling): the article video when
  there is one, otherwise the featured image. With media the layout becomes
  two columns, date, a smaller title and the article summary on the left,
  media on the right, like the case study hero. The summary is the article
  excerpt, the same text as the meta description and the BlogPosting
  description, so the page says on screen what the search snippet promised.
  Without media it is the Figma layout.
    - Video: the video pipeline writes article metafields on every publish
      (namespace custom: video_youtube_id, video_url, video_thumbnail_url,
      video_title, video_description, video_upload_date, video_duration). The
      header reads video_youtube_id, video_thumbnail_url and video_title and
      renders a click-to-play poster (<ca-lite-video>): the YouTube iframe only
      exists after a click, so the header costs one image. Older posts without
      the metafield fall back to the first YouTube embed in the body
      (snippets/ca-article-video.liquid). Either way ca-article-body drops the
      first body embed ("hoist_video") so the video is not shown twice; once
      the pipeline stops inserting the iframe that is a no-op.
    - Image: the article's custom.banner_video metafield when set (case study
      style loop), otherwise the article image.

  Band: a decorative full-width image strip under the header (the stock image
  from the design, 443:155) that breaks up the dark header and the white
  article. Picked in the editor; it is decoration, not the article image.

  Runs under a transparent site header (allow_transparent_header), like the
  case study hero: the section is first on the page, so the header turns
  solid once scrolled.
{%- endcomment -%}

{%- liquid
  assign date_text = article.published_at | date: section.settings.date_format
  if section.settings.date_prefix != blank
    assign date_text = section.settings.date_prefix | append: ' ' | append: date_text
  endif
  assign transparent = section.settings.allow_transparent_header

  assign yt_embed = ''
  assign yt_id = ''
  assign yt_title = article.title
  assign yt_poster = ''
  if section.settings.show_video
    assign yt_id = article.metafields.custom.video_youtube_id.value | strip
    if yt_id != blank
      if article.metafields.custom.video_title != blank
        assign yt_title = article.metafields.custom.video_title.value
      endif
      if article.metafields.custom.video_thumbnail_url != blank
        assign yt_poster = article.metafields.custom.video_thumbnail_url.value
      endif
    else
      capture yt_embed
        render 'ca-article-video', article: article
      endcapture
      if yt_embed != blank
        assign yt_id = yt_embed | split: 'embed/' | slice: 1, 1 | first | split: '"' | first | split: "'" | first | split: '?' | first | split: '&' | first | split: '/' | first | strip
        if yt_embed contains 'title="'
          assign yt_title = yt_embed | split: 'title="' | slice: 1, 1 | first | split: '"' | first
        endif
      endif
    endif
  endif
  if yt_id != blank and yt_poster == blank
    assign yt_poster = 'https://i.ytimg.com/vi/' | append: yt_id | append: '/maxresdefault.jpg'
  endif

  assign banner_video = ''
  assign image = ''
  if yt_id == blank and section.settings.show_media
    assign banner_video = article.metafields.custom.banner_video.value
    if banner_video == blank
      assign image = article.image
    endif
  endif

  assign has_media = false
  if yt_id != blank or banner_video != blank or image != blank
    assign has_media = true
  endif

  assign summary = ''
  if has_media and section.settings.show_summary
    assign summary = article.excerpt | strip_html | strip
  endif

  assign band = section.settings.band_image
-%}

{%- if transparent and section.settings.text_color != blank -%}
  {%- style -%}
    .ca-header { --ca-header-transparent-text: {{ section.settings.text_color }}; }
    .ca-header { --ca-header-transparent-bg: {{ section.settings.background_color | default: '#ffffff' }}; }
  {%- endstyle -%}
{%- endif -%}

<div
  class="ca-ahead color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}{% if transparent %} ca-allow-transparent-header{% endif %}{% if has_media %} ca-ahead--media{% endif %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-ahead__top spacing-style{% if transparent %} ca-under-header{% endif %}" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="ca-inner ca-ahead__grid">
      {%- if section.settings.show_date -%}
        <p class="ca-eyebrow ca-ahead__date">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ date_text }}</time>
        </p>
      {%- endif -%}
      <div class="ca-ahead__main">
        <h1 class="ca-statement ca-statement--display ca-ahead__title">{{ article.title }}</h1>
        {%- if summary != blank -%}
          <p class="ca-ahead__summary">{{ summary }}</p>
        {%- endif -%}
        {%- if section.settings.show_job_details -%}
          {%- render 'ca-job-pills', article: article, country_suffix: section.settings.country_suffix, class: 'ca-ahead__pills' -%}
        {%- endif -%}
      </div>

      {%- if has_media -%}
        <div class="ca-ahead__media">
          {%- if yt_id != blank -%}
            <ca-lite-video class="ca-ahead__yt" data-video-id="{{ yt_id | escape }}" data-title="{{ yt_title | escape }}">
              <button type="button" class="ca-ahead__poster" aria-label="Play video: {{ yt_title | escape }}" data-yt-play>
                {%- comment -%} maxresdefault is missing for some uploads; fall back to the always-present hqdefault. {%- endcomment -%}
                <img
                  src="{{ yt_poster | escape }}"
                  width="1280" height="720" alt="" loading="eager" fetchpriority="high"
                  onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ yt_id | escape }}/hqdefault.jpg'"
                >
                <span class="ca-ahead__play" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3.5v17l14-8.5z"/></svg></span>
                <span class="ca-ahead__label" aria-hidden="true">Watch the video</span>
              </button>
            </ca-lite-video>
          {%- elsif banner_video != blank -%}
            <div class="ca-ahead__poster ca-ahead__poster--static">
              {{ banner_video | video_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ca-ahead__video' | replace: '<img ', '<img alt="" ' }}
            </div>
          {%- else -%}
            <div class="ca-ahead__poster ca-ahead__poster--static">
              {{ image | image_url: width: 1400 | image_tag: class: 'ca-ahead__img', alt: image.alt | default: article.title, widths: '700, 1000, 1400', sizes: '(min-width: 990px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if band != blank -%}
    <div class="ca-ahead__band" aria-hidden="true">
      {%- comment -%} Eager: the band sits at the fold, and lazy loading flashed the dark background before the image arrived. Same file on every article, so it caches. {%- endcomment -%}
      {{ band | image_url: width: 2880 | image_tag: class: 'ca-ahead__band-img', alt: '', widths: '750, 1100, 1440, 2000, 2880', sizes: '100vw', loading: 'eager', fetchpriority: 'low' }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ca-ahead {
    background-color: var(--color-background);
  }

  .ca-ahead__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }

  .ca-ahead__date {
    grid-column: 1 / span 4;
    padding-block-start: 6px;
  }

  .ca-ahead__main {
    grid-column: 5 / -1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ca-ahead__title {
    margin: 0;
    text-wrap: pretty;
  }

  .ca-ahead__pills {
    justify-content: flex-end;
  }

  /* Two columns when there is hero media: date over a smaller title on the
     left, the video or image on the right, in view without scrolling. */
  .ca-ahead--media .ca-ahead__grid {
    /* Rows size to the date and title, not to the media that spans them,
       so the title sits under the date instead of drifting to mid-height. */
    grid-template-rows: auto 1fr;
  }

  .ca-ahead--media .ca-ahead__date {
    grid-column: 1 / span 6;
    grid-row: 1;
    padding-block-start: 0;
    margin-block-end: 8px;
  }

  .ca-ahead--media .ca-ahead__main {
    grid-column: 1 / span 6;
    grid-row: 2;
    padding-inline-end: 24px;
  }

  .ca-ahead--media .ca-ahead__title {
    font-size: clamp(2.25rem, 3.9vw, 3.5rem);
    line-height: 1.02;
  }

  .ca-ahead--media .ca-ahead__pills {
    justify-content: flex-start;
  }

  .ca-ahead__summary {
    margin: 4px 0 0;
    max-width: 48ch;
    font-size: var(--ca-fs-20);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ca-soft);
    text-wrap: pretty;
  }

  .ca-ahead__media {
    grid-column: 7 / -1;
    grid-row: 1 / span 2;
    min-width: 0;
  }

  .ca-ahead__yt {
    display: block;
    width: 100%;
  }

  .ca-ahead__poster {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    border-radius: 12px;
    background: #000;
    color: inherit;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }

  button.ca-ahead__poster {
    cursor: pointer;
  }

  .ca-ahead__poster img,
  .ca-ahead__poster video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  button.ca-ahead__poster img {
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  button.ca-ahead__poster:hover img {
    opacity: 1;
  }

  .ca-ahead__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    color: #0d110d;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35), 0 0 0 4px rgb(255 255 255 / 0.4);
    transition: transform 0.2s;
  }

  .ca-ahead__play svg {
    margin-inline-start: 3px;
  }

  button.ca-ahead__poster:hover .ca-ahead__play {
    transform: scale(1.05);
  }

  .ca-ahead__label {
    position: absolute;
    inset-inline-start: 16px;
    inset-block-end: 16px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(13, 17, 13, 0.82);
    color: #fff;
    font-size: 0.875rem;
    letter-spacing: -0.02em;
    backdrop-filter: blur(6px);
  }

  .ca-ahead__yt iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
    background: #000;
  }

  /* Decorative band between the header and the article. */
  .ca-ahead__band {
    width: 100%;
    height: min(12vw, 160px);
    overflow: hidden;
  }

  .ca-ahead__band-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .ca-ahead__date,
    .ca-ahead__main,
    .ca-ahead--media .ca-ahead__date,
    .ca-ahead--media .ca-ahead__main,
    .ca-ahead__media {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .ca-ahead--media .ca-ahead__main {
      padding-inline-end: 0;
    }

    .ca-ahead__media {
      margin-block-start: 8px;
    }

    .ca-ahead__pills {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-ahead__band {
      height: 20vw;
    }

    .ca-ahead__play {
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button.ca-ahead__poster img,
    .ca-ahead__play {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Click-to-play YouTube poster: the iframe is created on demand so the page
  // never loads the player until someone asks for it.
  if (!customElements.get('ca-lite-video')) {
    customElements.define(
      'ca-lite-video',
      class extends HTMLElement {
        connectedCallback() {
          this.querySelectorAll('[data-yt-play]').forEach((b) => b.addEventListener('click', () => this.play()));
        }
        play() {
          const id = this.dataset.videoId;
          if (!id) return;
          const iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
          iframe.title = this.dataset.title || 'Video';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          this.replaceChildren(iframe);
          iframe.focus();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Article header",
  "tag": "section",
  "class": "ca-ahead-section",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "text", "id": "date_prefix", "label": "Date prefix", "info": "For example Posted" },
    {
      "type": "select",
      "id": "date_format",
      "label": "Date format",
      "options": [
        { "value": "%b %d, %Y", "label": "Feb 23, 2026" },
        { "value": "%B %d, %Y", "label": "February 23, 2026" }
      ],
      "default": "%b %d, %Y"
    },
    { "type": "checkbox", "id": "show_job_details", "label": "Show job detail pills (career posts)", "default": false },
    { "type": "text", "id": "country_suffix", "label": "Text after the country pill", "default": "Applicants Only" },
    { "type": "header", "content": "Hero media" },
    { "type": "checkbox", "id": "show_video", "label": "Show the article video", "info": "Click-to-play, beside the title. Reads the Video YouTube ID metafield, or the first YouTube embed in the body. Keep \"Leave out the first YouTube embed\" on in the Article body section so it is not shown twice.", "default": true },
    { "type": "checkbox", "id": "show_media", "label": "Show the featured image when there is no video", "info": "Uses the article's Banner Video metafield when set, otherwise the article image.", "default": true },
    { "type": "checkbox", "id": "show_summary", "label": "Show the article summary under the title", "info": "The article's excerpt, beside the hero media. Same text as the meta description.", "default": true },
    { "type": "image_picker", "id": "band_image", "label": "Decorative band", "info": "Full-width image strip under the header. Decoration only; leave empty for none." },
    { "type": "header", "content": "Site header" },
    { "type": "checkbox", "id": "allow_transparent_header", "label": "Run under a transparent header", "info": "The site header takes this section's colors until the page scrolls.", "default": false },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Article header", "category": "Conspire" }]
}
{% endschema %}
