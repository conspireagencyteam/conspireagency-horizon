{%- comment -%}
  ca-careers-list.liquid — open positions (Conspire v2.0, Figma 474:1226).

  Eyebrow over a hairline, then one row per article of the blog this template
  is used on (the Careers blog): title on the left; job pills, a short excerpt
  and a button on the right. Pills come from the article's custom.work_*
  metafields (see ca-job-pills).
{%- endcomment -%}

{%- liquid
  assign source_blog = section.settings.blog | default: blog
  assign words = section.settings.excerpt_words | default: 28
-%}

<div
  class="ca-jobs spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- if section.settings.eyebrow != blank -%}
      <h2 class="ca-eyebrow ca-jobs__eyebrow">{{ section.settings.eyebrow }}</h2>
    {%- endif -%}

    {%- if source_blog.articles.size > 0 -%}
      <ul class="ca-jobs__list">
        {%- for article in source_blog.articles -%}
          {%- liquid
            assign excerpt = article.excerpt | strip_html | strip
            if excerpt == blank
              assign excerpt = article.content | strip_html | strip | truncatewords: words
            endif
          -%}
          <li class="ca-jobs__row">
            <h3 class="ca-jobs__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <div class="ca-jobs__detail">
              {%- render 'ca-job-pills', article: article, country_suffix: section.settings.country_suffix -%}
              {%- if excerpt != blank -%}
                <p class="ca-jobs__excerpt">{{ excerpt }}</p>
              {%- endif -%}
              <a class="{{ section.settings.style_class }} size-style" href="{{ article.url }}">
                {{- section.settings.button_label }}<span class="ca-sr-only">: {{ article.title }}</span>
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="ca-jobs__empty">{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-jobs {
    background-color: var(--color-background);
  }

  .ca-jobs__eyebrow {
    margin: 0;
    padding-block-end: 24px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  .ca-jobs__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-jobs__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 24px;
    padding-block: 40px;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  .ca-jobs__title {
    grid-column: 1 / span 6;
    margin: 0;
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ca-jobs__title a {
    color: inherit;
    text-decoration: none;
  }

  .ca-jobs__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .ca-jobs__detail {
    grid-column: 7 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .ca-jobs__excerpt {
    margin: 0;
    color: var(--ca-soft);
  }

  .ca-jobs__empty {
    margin: 0;
    padding-block: 40px;
    font-size: var(--ca-fs-24);
    letter-spacing: -0.03em;
    color: var(--ca-muted);
  }

  @media screen and (max-width: 989px) {
    .ca-jobs__title,
    .ca-jobs__detail {
      grid-column: 1 / -1;
    }

    .ca-jobs__row {
      padding-block: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Careers list",
  "tag": "section",
  "class": "ca-jobs-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Open positions" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Leave empty on the Careers blog template to list that blog's posts." },
    { "type": "text", "id": "country_suffix", "label": "Text after the country pill", "default": "Only" },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt length (words)", "info": "Used when the post has no excerpt.", "min": 10, "max": 60, "step": 2, "default": 28 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Position" },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" }
      ],
      "default": "button"
    },
    { "type": "text", "id": "empty_text", "label": "Text when there are no posts", "default": "No open positions right now. Check back soon." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Careers list", "category": "Conspire" }]
}
{% endschema %}
