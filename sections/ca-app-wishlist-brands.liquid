{%- comment -%}
  ca-app-wishlist-brands.liquid — "Powering projects in beautiful stores": a row
  of store photos, each linking to the merchant (name + category under the photo).
{%- endcomment -%}
<div
  class="ca-wlbrands spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id -%}
  <div class="ca-inner">
    {%- render 'ca-intro', eyebrow: section.settings.eyebrow, heading: section.settings.heading, start: 5, class: 'ca-wlbrands__intro' -%}
    <ca-app-scroller class="ca-wlbrands__scroller" data-item-label="Store" tabindex="0" aria-label="{{ section.settings.heading | strip_html | escape }}">
      <div class="ca-wlbrands__viewport" ref="viewport">
    <ul class="ca-wlbrands__row" role="list" ref="track">
      {%- for block in section.blocks -%}
        <li class="ca-wlbrands__card" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="ca-wlbrands__link">{%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.name, loading: 'lazy', class: 'ca-wlbrands__img' }}
            {%- endif -%}
            <span class="ca-wlbrands__name">{{ block.settings.name }}</span>
            {%- if block.settings.category != blank -%}<span class="ca-wlbrands__cat">{{ block.settings.category }}</span>{%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
      </div>
      {%- render 'ca-app-scroller-controls', label: 'store' -%}
    </ca-app-scroller>
    {%- if section.settings.footnote != blank -%}<p class="ca-wlbrands__note">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</div>

<script src="{{ 'ca-app-scroller.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .ca-wlbrands__intro { margin-bottom: 40px; }
  .ca-wlbrands__scroller { --ca-app-scroller-item: 62vw; }
  .ca-wlbrands__row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  @media (min-width: 990px) { .ca-wlbrands__row { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; } }
  .ca-wlbrands__link { display: block; color: inherit; text-decoration: none; }
  .ca-wlbrands__img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; margin-bottom: 12px; transition: transform 0.4s ease; }
  .ca-wlbrands__link { overflow: hidden; }
  .ca-wlbrands__link:hover .ca-wlbrands__img { transform: scale(1.03); }
  .ca-wlbrands__link:hover .ca-wlbrands__name { text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .ca-wlbrands__img { transition: none; } .ca-wlbrands__link:hover .ca-wlbrands__img { transform: none; } }
  .ca-wlbrands__name { display: block; font-weight: 600; line-height: 1.3; }
  .ca-wlbrands__cat { display: block; color: var(--ca-soft); font-size: 0.9rem; }
  .ca-wlbrands__note { margin: 32px 0 0; color: var(--ca-soft); font-size: 0.95rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "App: store photos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted by merchants" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading (h2)", "default": "Powering projects in beautiful stores" },
    { "type": "text", "id": "footnote", "label": "Footnote" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Store name", "default": "Store" },
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "App: store photos", "category": "Conspire", "blocks": [{ "type": "store" }, { "type": "store" }, { "type": "store" }] }]
}
{% endschema %}
