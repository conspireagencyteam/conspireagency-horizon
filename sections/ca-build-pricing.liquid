{%- comment -%}
  ca-build-pricing.liquid — "Pricing, scoped line by line"
  (Conspire v2.0, Figma 396:726 / 429:2660).

  Intro (eyebrow, two-tone statement, button), three price points (start, where
  most builds land, full scope), then a full-bleed glowing bar chart that peaks
  under the middle price, with the timeline range along its baseline.

  The chart is decorative (aria-hidden) and CSS only: the same row of bars is
  drawn twice, once heavily blurred for the glow and once nearly crisp for the
  vertical striations. Bars rise when the section scrolls into view.
{%- endcomment -%}

{%- liquid
  assign accent = section.settings.accent_color | default: '#ff4d00'
  assign heights = '16,22,22,34,34,47,51,65,74,85,87,98,93,98,90,93,89,88,79,80,68,67,56,55,49,47,37,38,27,28,19,21,18,19,12,17' | split: ','
-%}

<div
  class="ca-bprice spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %} --ca-bprice-accent: {{ accent.red }} {{ accent.green }} {{ accent.blue }};"
  data-ca-bprice
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- render 'ca-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      start: 6,
      button_label: section.settings.button_label,
      button_link: section.settings.button_link,
      class: 'ca-bprice__intro'
    -%}

    <dl class="ca-bprice__stats">
      <div class="ca-bprice__stat">
        <dd class="ca-bprice__amount">{{ section.settings.min_amount }}</dd>
        <dt class="ca-eyebrow">{{ section.settings.min_caption }}</dt>
      </div>
      <div class="ca-bprice__stat ca-bprice__stat--mid">
        <dd class="ca-bprice__amount">{{ section.settings.mid_amount }}</dd>
        <dt class="ca-eyebrow">{{ section.settings.mid_caption }}</dt>
      </div>
      <div class="ca-bprice__stat ca-bprice__stat--max">
        <dd class="ca-bprice__amount">{{ section.settings.max_amount }}</dd>
        <dt class="ca-eyebrow">{{ section.settings.max_caption }}</dt>
      </div>
    </dl>
  </div>

  <div class="ca-bprice__chart">
    <div class="ca-bprice__bars ca-bprice__bars--glow" aria-hidden="true">
      {%- for h in heights -%}
        <span style="--h: {{ h }}; --i: {{ forloop.index0 }};"></span>
      {%- endfor -%}
    </div>
    <div class="ca-bprice__bars ca-bprice__bars--lines" aria-hidden="true">
      {%- for h in heights -%}
        <span style="--h: {{ h }}; --i: {{ forloop.index0 }};"></span>
      {%- endfor -%}
    </div>
    {%- if section.settings.axis_start != blank or section.settings.axis_end != blank -%}
      <div class="ca-inner ca-bprice__axis">
        <p class="ca-eyebrow">
          <span class="ca-sr-only">Timeline: </span>{{ section.settings.axis_start }}
          <span class="ca-sr-only"> to </span>
        </p>
        <p class="ca-eyebrow">{{ section.settings.axis_end }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var el = document.querySelector('#shopify-section-{{ section.id }} [data-ca-bprice]');
    if (!el) return;
    if (!('IntersectionObserver' in window)) {
      el.classList.add('is-inview');
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            el.classList.add('is-inview');
            io.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );
    io.observe(el);
  })();
</script>

{% stylesheet %}
  .ca-bprice {
    background-color: var(--color-background);
    overflow: hidden;
  }

  .ca-bprice__intro {
    margin-block-end: 120px;
  }

  .ca-bprice__stats {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: end;
    margin: 0;
  }

  .ca-bprice__stat {
    grid-column: 1 / span 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ca-bprice__stat--mid {
    grid-column: 4 / span 6;
    padding-inline-start: 20px;
  }

  .ca-bprice__stat--max {
    grid-column: 10 / -1;
    align-items: flex-end;
    text-align: end;
  }

  .ca-bprice__amount {
    margin: 0;
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ca-bprice__stat--mid .ca-bprice__amount {
    font-size: var(--ca-fs-48);
  }

  .ca-bprice__stat .ca-eyebrow {
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  /* Chart */
  .ca-bprice__chart {
    position: relative;
    height: clamp(300px, 35vw, 500px);
    margin-block-start: 24px;
    overflow: clip;
  }

  .ca-bprice__bars {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
  }

  .ca-bprice__bars span {
    flex: 1 1 0;
    height: calc(var(--h) * 1%);
    transform: scaleY(0.12);
    transform-origin: 50% 100%;
    transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 18ms);
  }

  .ca-bprice.is-inview .ca-bprice__bars span {
    transform: scaleY(1);
  }

  .ca-bprice__bars--glow {
    filter: blur(28px);
    opacity: 0.95;
  }

  .ca-bprice__bars--glow span {
    background: linear-gradient(
      to top,
      rgb(var(--ca-bprice-accent) / 1) 0%,
      rgb(var(--ca-bprice-accent) / 0.75) 45%,
      rgb(var(--ca-bprice-accent) / 0) 100%
    );
  }

  .ca-bprice__bars--lines {
    filter: blur(3px);
    mix-blend-mode: screen;
  }

  .ca-bprice__bars--lines span {
    margin-inline: 1px;
    background: linear-gradient(
      to top,
      rgb(var(--ca-bprice-accent) / 0.5) 0%,
      rgb(var(--ca-bprice-accent) / 0.22) 55%,
      rgb(var(--ca-bprice-accent) / 0) 100%
    );
  }

  /* Fade the foot of the chart back into the section. */
  .ca-bprice__chart::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 56px;
    background: linear-gradient(to top, var(--color-background) 0%, rgb(var(--color-background-rgb) / 0.85) 45%, rgb(var(--color-background-rgb) / 0));
    pointer-events: none;
  }

  .ca-bprice__axis {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 72px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .ca-bprice__axis::after {
    content: "";
    position: absolute;
    inset-inline: var(--page-margin, 24px);
    inset-block-end: -16px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
  }

  .ca-bprice__axis .ca-eyebrow {
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-bprice__bars span {
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 989px) {
    .ca-bprice__intro {
      margin-block-end: 64px;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-bprice__stats {
      column-gap: 12px;
    }

    .ca-bprice__stat {
      grid-column: 1 / span 3;
    }

    .ca-bprice__stat--mid {
      grid-column: 4 / span 5;
      padding-inline-start: 0;
    }

    .ca-bprice__stat--max {
      grid-column: 9 / -1;
    }

    .ca-bprice__amount {
      font-size: 1.375rem;
    }

    .ca-bprice__stat--mid .ca-bprice__amount {
      font-size: 1.75rem;
    }

    .ca-bprice__stat .ca-eyebrow {
      font-size: 0.6875rem;
    }

    .ca-bprice__bars--glow {
      filter: blur(16px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Build pricing",
  "tag": "section",
  "class": "ca-bprice-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pricing, scoped line by line" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Statement",
      "info": "Bold the words to emphasise. The rest is shown muted.",
      "default": "Every Conspire Build is scoped <strong>line by line: page templates, migration, app development, integrations.</strong>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Schedule a Call" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Price points" },
    { "type": "text", "id": "min_amount", "label": "Starting amount", "default": "$15k" },
    { "type": "text", "id": "min_caption", "label": "Starting caption", "default": "Starting point" },
    { "type": "text", "id": "mid_amount", "label": "Middle amount", "default": "$25-45k" },
    { "type": "text", "id": "mid_caption", "label": "Middle caption", "default": "Where most builds land" },
    { "type": "text", "id": "max_amount", "label": "Top amount", "default": "$100k+" },
    { "type": "text", "id": "max_caption", "label": "Top caption", "default": "Full scope" },
    { "type": "header", "content": "Chart" },
    { "type": "text", "id": "axis_start", "label": "Timeline start", "default": "8 weeks" },
    { "type": "text", "id": "axis_end", "label": "Timeline end", "default": "14 weeks" },
    { "type": "color", "id": "accent_color", "label": "Glow color", "default": "#ff4d00" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#0d110d" },
    { "type": "color", "id": "text_color", "label": "t:settings.text", "default": "#ffffff" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Build pricing", "category": "Conspire" }]
}
{% endschema %}
