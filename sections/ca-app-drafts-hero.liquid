{%- comment -%}
  ca-app-drafts-hero.liquid — app landing hero for /pages/draft-order-invoices,
  ported from apps.conspireagency.com/drafts. Dark page-title block: eyebrow,
  "New" pill links, the page H1, lede, three CTAs (install / docs / tour),
  proof line, and the tour thumbnail linking to the video.
{%- endcomment -%}
<div
  class="ca-apphero spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    <div class="ca-grid ca-apphero__grid">
      <div class="ca-apphero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ca-eyebrow ca-apphero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- assign pills = section.blocks | where: 'type', 'pill' -%}
        {%- if pills.size > 0 -%}
          <ul class="ca-apphero__pills" role="list">
            {%- for block in pills -%}
              <li {{ block.shopify_attributes }}>
                <a class="ca-apphero__pill" href="{{ block.settings.link | default: '#features' }}">
                  {%- if block.settings.badge != blank -%}<span class="ca-apphero__badge">{{ block.settings.badge }}</span>{%- endif -%}
                  {{ block.settings.label }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <h1 class="ca-statement ca-statement--display ca-apphero__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.lede != blank -%}
          <div class="ca-apphero__lede">{{ section.settings.lede }}</div>
        {%- endif -%}
        <div class="ca-apphero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="button size-style" href="{{ section.settings.primary_link }}" target="_blank" rel="noopener">{{ section.settings.primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="button-secondary size-style" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
          {%- if section.settings.tour_label != blank and section.settings.tour_link != blank -%}
            <a class="ca-apphero__tour-link" href="{{ section.settings.tour_link }}" target="_blank" rel="noopener"><span class="ca-apphero__play" aria-hidden="true"></span>{{ section.settings.tour_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.proof != blank -%}
          <p class="ca-apphero__proof">{{ section.settings.proof }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.tour_image != blank -%}
        <div class="ca-apphero__media">
          <a class="ca-apphero__thumb" href="{{ section.settings.tour_link }}" target="_blank" rel="noopener" aria-label="{{ section.settings.tour_label | default: 'Watch the tour' | escape }} (opens YouTube)">
            {{- section.settings.tour_image | image_url: width: 1280 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 760, 1280', sizes: '(min-width: 990px) 560px, 100vw', alt: section.settings.tour_alt -}}
            <span class="ca-apphero__thumb-label"><span class="ca-apphero__play" aria-hidden="true"></span>{{ section.settings.tour_label | default: 'Watch the tour' }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
  .ca-apphero { background-color: var(--color-background); }
  .ca-apphero__grid { row-gap: 48px; align-items: center; }
  .ca-apphero__copy { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .ca-apphero__media { grid-column: 1 / -1; }
  .ca-apphero__pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ca-apphero__pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px 6px 6px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 999px;
    font-size: 0.875rem; line-height: 1.2; letter-spacing: -0.01em;
    color: var(--ca-soft);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .ca-apphero__pill:hover { border-color: rgb(var(--color-foreground-rgb) / 0.6); color: rgb(var(--color-foreground-rgb)); }
  .ca-apphero__badge {
    display: inline-block; padding: 3px 8px; border-radius: 999px;
    background: rgb(var(--color-foreground-rgb)); color: rgb(var(--color-background-rgb));
    font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ca-apphero__title { max-width: 14ch; }
  .ca-apphero__lede { max-width: 46ch; font-size: var(--ca-fs-20, 1.25rem); line-height: 1.4; letter-spacing: -0.02em; color: var(--ca-soft); }
  .ca-apphero__lede > :first-child { margin-block-start: 0; }
  .ca-apphero__lede > :last-child { margin-block-end: 0; }
  .ca-apphero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .ca-apphero__tour-link { display: inline-flex; align-items: center; gap: 10px; color: var(--ca-soft); text-decoration: none; text-underline-offset: 4px; }
  .ca-apphero__tour-link:hover { text-decoration: underline; color: rgb(var(--color-foreground-rgb)); }
  .ca-apphero__play {
    display: inline-block; width: 0; height: 0;
    border-style: solid; border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent currentColor;
  }
  .ca-apphero__proof { margin: 0; font-size: 0.875rem; letter-spacing: 0.01em; color: var(--ca-muted); }
  .ca-apphero__thumb { position: relative; display: block; overflow: hidden; border-radius: 12px; border: 1px solid rgb(var(--color-foreground-rgb) / 0.12); }
  .ca-apphero__thumb img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .ca-apphero__thumb-label {
    position: absolute; inset-inline-start: 16px; inset-block-end: 16px;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 8px 14px; border-radius: 999px;
    background: rgb(0 0 0 / 0.65); color: #fff; font-size: 0.875rem; backdrop-filter: blur(6px);
  }
  @media (min-width: 990px) {
    .ca-apphero__copy { grid-column: 1 / span 7; }
    .ca-apphero__media { grid-column: 8 / span 5; }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "App hero (Drafts)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "B2B Draft Order Invoices" },
    { "type": "inline_richtext", "id": "heading", "label": "H1", "default": "Draft orders, paid. Invoices your customers can see and settle." },
    { "type": "richtext", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Install on Shopify" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Documentation" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "tour_label", "label": "Tour label", "default": "Watch the tour" },
    { "type": "url", "id": "tour_link", "label": "Tour link (YouTube)" },
    { "type": "image_picker", "id": "tour_image", "label": "Tour thumbnail" },
    { "type": "text", "id": "tour_alt", "label": "Thumbnail alt text", "default": "B2B Draft Order Invoices app tour video" },
    { "type": "text", "id": "proof", "label": "Proof line", "default": "From $5/month · Free trial · Built by a Shopify Premier Partner" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#0d110d" },
    { "type": "color", "id": "text_color", "label": "t:settings.text", "default": "#ffffff" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill link",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "New" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "App hero (Drafts)", "category": "Conspire" }]
}
{% endschema %}
