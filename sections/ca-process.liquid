{%- comment -%}
  ca-process.liquid — "The Conspire Build" (Conspire v2.0, Figma 396:136).

  Intro (eyebrow + multi-paragraph two-tone statement), then a carousel of
  process steps. The active step is wide with a large line of copy; the others
  sit beside it, narrow and muted. Arrows bottom-left, dots bottom-right.

  Steps are "step" blocks (label + text). <ca-process> (assets/ca-process.js)
  handles the active state; with no JS the row simply scrolls sideways.
{%- endcomment -%}

<script src="{{ 'ca-process.js' | asset_url }}" type="module" fetchpriority="low"></script>

<div
  class="ca-process spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- render 'ca-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      tag: section.settings.heading_tag,
      class: 'ca-process__intro'
    -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ca-process class="ca-process__carousel" tabindex="0" aria-roledescription="carousel" aria-label="{{ section.settings.eyebrow | default: 'Process' | escape }}">
      <div class="ca-process__viewport">
        <ol class="ca-process__track">
          {%- for block in section.blocks -%}
            <li class="ca-process__step{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <p class="ca-eyebrow ca-process__label">{{ block.settings.label }}</p>
              {%- endif -%}
              <p class="ca-process__text">{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>

      <div class="ca-inner ca-process__controls">
        <div class="ca-process__arrows">
          <button class="ca-process__arrow ca-process__arrow--prev" type="button" aria-label="Previous step">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M18.3666 12.0003H5.63871M12.0027 5.63633L5.63871 12.0003L12.0027 18.3643" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </button>
          <button class="ca-process__arrow ca-process__arrow--next" type="button" aria-label="Next step">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5.63677 11.9997H18.3647M12.0007 18.3637L18.3647 11.9997L12.0007 5.63574" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="ca-process__dots">
          {%- for block in section.blocks -%}
            <button class="ca-process__dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Step {{ forloop.index }}: {{ block.settings.label | escape }}"></button>
          {%- endfor -%}
        </div>
      </div>
    </ca-process>
  {%- endif -%}
</div>

{% stylesheet %}
  .ca-process {
    background-color: var(--color-background);
    overflow: hidden;
  }

  .ca-process__intro {
    margin-block-end: 80px;
  }

  .ca-process__carousel {
    --ca-process-gap: 20px;
    --ca-process-active: min(56vw, 780px);
    --ca-process-idle: min(29vw, 400px);
    display: block;
    outline-offset: 4px;
  }

  .ca-process__viewport {
    width: 100%;
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ca-process__carousel.is-enhanced .ca-process__viewport {
    overflow: visible;
  }

  .ca-process__track {
    display: flex;
    align-items: flex-start;
    gap: var(--ca-process-gap);
    min-height: 260px;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ca-process__step {
    flex: 0 0 var(--ca-process-idle);
    cursor: pointer;
    transition: flex-basis 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ca-process__step.is-active {
    flex-basis: var(--ca-process-active);
    cursor: default;
  }

  .ca-process__label {
    margin-block-end: 24px;
    padding-block-end: 24px;
    border-block-end: 1px solid var(--ca-hairline-strong);
    transition: border-color 0.3s ease;
  }

  .ca-process__step.is-active .ca-process__label {
    border-block-end-color: rgb(var(--color-foreground-rgb));
  }

  .ca-process__text {
    margin: 0;
    font-size: var(--ca-fs-24);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-rgb) / 0.3);
    transition: font-size 0.6s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
  }

  .ca-process__step.is-active .ca-process__text {
    font-size: var(--ca-fs-48);
    color: rgb(var(--color-foreground-rgb));
  }

  .ca-process__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 40px;
  }

  .ca-process__carousel:not(.is-enhanced) .ca-process__controls {
    display: none;
  }

  .ca-process__arrows {
    display: flex;
  }

  .ca-process__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .ca-process__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .ca-process__dots {
    display: flex;
    gap: 8px;
  }

  .ca-process__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / 0.2);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ca-process__dot.is-active {
    background-color: rgb(var(--color-foreground-rgb));
  }

  /* Narrow/touch: native swipeable scroller (class set by ca-process.js). */
  .ca-process__carousel.is-scroll .ca-process__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--page-margin, 24px);
  }

  .ca-process__carousel.is-scroll .ca-process__viewport::-webkit-scrollbar {
    display: none;
  }

  .ca-process__carousel.is-scroll .ca-process__track {
    transform: none !important;
    transition: none;
    width: max-content;
    /* room so the last step can snap to the start edge */
    padding-inline-end: calc(100vw - var(--ca-process-active) - 2 * var(--page-margin, 24px));
  }

  .ca-process__carousel.is-scroll .ca-process__step {
    flex: 0 0 var(--ca-process-active);
    min-width: var(--ca-process-active);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-process__track,
    .ca-process__step,
    .ca-process__text {
      transition: none;
    }
  }

  @media screen and (max-width: 989px) {
    .ca-process__intro {
      margin-block-end: 48px;
    }

    .ca-process__carousel {
      --ca-process-active: 78vw;
      --ca-process-idle: 52vw;
    }

    .ca-process__track {
      min-height: 220px;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-process__carousel {
      --ca-process-gap: 16px;
      --ca-process-active: 80vw;
      --ca-process-idle: 56vw;
    }

    .ca-process__step.is-active .ca-process__text {
      font-size: 1.75rem;
    }

    .ca-process__text {
      font-size: 1.125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Process steps",
  "tag": "section",
  "class": "ca-process-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Conspire Build" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Statement",
      "info": "Bold the words to emphasise. The rest is shown muted."
    },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [ { "value": "div", "label": "None (div)" }, { "value": "h2", "label": "H2" } ], "default": "div" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Art direction" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Your brand, translated into a store customers remember and trust" }
      ]
    }
  ],
  "presets": [
    { "name": "Process steps", "category": "Conspire", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
