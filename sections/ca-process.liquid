{%- comment -%}
  ca-process.liquid — "The Conspire Build" (Conspire v2.0, Figma 396:136).

  Intro (eyebrow + multi-paragraph two-tone statement). Step blocks are
  optional: when present, the step carousel (snippets/ca-process-carousel.liquid)
  renders under the intro. To place the carousel anywhere else on a page, leave
  this section without steps and add the "Process carousel" section
  (sections/ca-process-carousel.liquid), which also holds the carousel styles.
{%- endcomment -%}

<div
  class="ca-process spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  {%- liquid
    assign intro_class = 'ca-process__intro'
    if section.blocks.size == 0
      assign intro_class = 'ca-process__intro ca-process__intro--solo'
    endif
  -%}
  <div class="ca-inner">
    {%- render 'ca-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      tag: section.settings.heading_tag,
      class: intro_class
    -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- render 'ca-process-carousel', blocks: section.blocks, label: section.settings.eyebrow -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .ca-process {
    background-color: var(--color-background);
    overflow: hidden;
  }

  .ca-process__intro {
    margin-block-end: 80px;
  }

  /* No steps in this section: the carousel lives in its own section. */
  .ca-process__intro.ca-process__intro--solo {
    margin-block-end: 0;
  }

  @media screen and (max-width: 989px) {
    .ca-process__intro {
      margin-block-end: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Process steps",
  "tag": "section",
  "class": "ca-process-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Conspire Build" },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Statement",
      "info": "Bold the words to emphasise. The rest is shown muted."
    },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [ { "value": "div", "label": "None (div)" }, { "value": "h2", "label": "H2" } ], "default": "div" },
    { "type": "paragraph", "content": "Steps added here show as a carousel under the statement. To place the carousel elsewhere on the page, use the Process carousel section instead." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Art direction" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Your brand, translated into a store customers remember and trust" }
      ]
    }
  ],
  "presets": [
    { "name": "Process steps", "category": "Conspire", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
