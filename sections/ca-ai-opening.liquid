{%- comment -%}
  ca-ai-opening.liquid: the first screen of the AI page (templates/page.ai.json).

  It carries three things for the whole page:
    1. The fixed canvas that assets/ca-ai.js draws the particle field on. Every
       [data-ai-scene] element further down (see ca-ai-chapter) is a stop for it.
    2. The enter gate. Sound cannot start without a click, so the page opens on the
       breathing cloud with two buttons, "with sound" and "without". Until one is
       pressed the page does not scroll. The gate is added by script: with no
       script, under reduced motion, or on a return visit in the same session,
       the page simply opens. In the last two cases the "with sound" button is
       still offered on the first screen, by itself and without holding the page,
       because sound can never resume without a click.
    3. The sound and autoplay toggles, the scroll cue shown when a chapter has
       played out, the label layer the script positions over the canvas, and the
       chapter rail the script builds down the left edge on wide screens (one
       button per chapter).

  The canvas and every label are decorative and aria-hidden; the meaning is in the
  copy. The page is dark from here to the footer, so this section also gives the
  header its dark treatment for this template.

  Audio: assets/ca-ai-ambient.mp3 (the Breathe ambient track), or the URL in the
  "Audio file URL" setting when one is given. It is fetched only after
  "Enter with sound".
{%- endcomment -%}

{%- liquid
  assign audio_src = 'ca-ai-ambient.mp3' | asset_url
  if section.settings.audio_url != blank
    assign audio_src = section.settings.audio_url
  endif
-%}

{%- style -%}
  .ca-header { --ca-header-transparent-text: #f2f2f2; --ca-header-transparent-bg: #0d110d; }
{%- endstyle -%}

<script>
  /* Lock the page before first paint when the gate will show, so nothing jumps.
     If the module never arrives, let the visitor through. */
  (function () {
    var seen = false;
    try { seen = sessionStorage.getItem('ca-ai-entered') === '1'; } catch (e) {}
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var html = document.documentElement;
    if (location.hash || (window.Shopify && Shopify.designMode)) return;
    if (seen || reduced) {
      html.classList.add('ca-ai-returning');
      return;
    }
    html.classList.add('ca-ai-gated');
    setTimeout(function () {
      if (!window.__caAi) html.classList.remove('ca-ai-gated');
    }, 5000);
  })();
</script>
<script src="{{ 'ca-ai.js' | asset_url }}" type="module"></script>

<div
  class="ca-ai ca-invert ca-allow-transparent-header ca-under-header"
  data-ca-ai
  data-audio-src="{{ audio_src }}"
  data-example-label="{{ section.settings.example_label | escape }}"
  data-rail-label="{{ section.settings.rail_label | default: 'Chapters' | escape }}"
>
  <canvas class="ca-ai__canvas" data-ai-canvas aria-hidden="true"></canvas>

  <div class="ca-ai__labels" data-ai-labels aria-hidden="true"></div>

  <div class="ca-ai-hero" data-ai-scene="open">
    <div class="ca-inner ca-ai-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ca-eyebrow ca-ai-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="ca-ai-hero__heading">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="ca-ai-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="ca-ai-hero__gate">
        <button type="button" class="button size-style" data-ai-enter="sound">{{ section.settings.enter_sound_label }}</button>
        <button type="button" class="button-secondary size-style" data-ai-enter="silent">{{ section.settings.enter_silent_label }}</button>
      </div>
      <p class="ca-eyebrow ca-ai-hero__hint">{{ section.settings.scroll_label }}</p>
    </div>
  </div>

  <p class="ca-ai__cue" data-ai-cue aria-hidden="true">{{ section.settings.scroll_label }}</p>

  <div class="ca-ai__controls">
    <button
      type="button"
      class="ca-ai__control ca-ai__auto"
      data-ai-auto
      data-on="{{ section.settings.auto_on_label | escape }}"
      data-off="{{ section.settings.auto_off_label | escape }}"
      aria-pressed="true"
      hidden
    >
      <span class="ca-ai__auto-icon" aria-hidden="true"></span>
      <span data-ai-auto-label>{{ section.settings.auto_on_label }}</span>
    </button>
    <button
      type="button"
      class="ca-ai__control ca-ai__sound"
      data-ai-sound
      data-on="{{ section.settings.sound_on_label | escape }}"
      data-off="{{ section.settings.sound_off_label | escape }}"
      aria-pressed="false"
      hidden
    >
      <span class="ca-ai__sound-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      <span data-ai-sound-label>{{ section.settings.sound_off_label }}</span>
    </button>
  </div>
</div>

{% stylesheet %}
  /* The AI page is dark from the header to the footer. */
  body:has([data-ca-ai]) {
    background: #0d110d;
  }

  body:has([data-ca-ai]) #MainContent > .shopify-section:not(:first-child),
  body:has([data-ca-ai]) .page-wrapper > footer {
    position: relative;
    z-index: 1;
  }

  /* The header keeps its light-on-dark treatment once scrolled, on this page only. */
  body:has([data-ca-ai]) .ca-header--sticky[data-stuck]:not([data-mega-open]) {
    --color-background: #0d110d;
    --color-foreground: #f2f2f2;
    --color-foreground-rgb: 242 242 242;
    /* Solid, not blurred: a backdrop filter here would turn the header into the
       containing block of its fixed drawer and widen the page on phones. */
    background-color: #0d110d;
    color: #f2f2f2;
  }

  body:has([data-ca-ai]) .ca-header--sticky[data-stuck]:not([data-mega-open]):has(.ca-header__logo-img--inverse) .ca-header__logo-img--original {
    display: none;
  }

  body:has([data-ca-ai]) .ca-header--sticky[data-stuck]:not([data-mega-open]) .ca-header__logo-img--inverse {
    display: block;
  }

  body:has([data-ca-ai]) .ca-header--sticky[data-stuck]:not([data-mega-open]) .ca-header__badge {
    --ca-badge-fg: #f2f2f2;
    --ca-badge-bg: #0d110d;
  }

  html.ca-ai-gated,
  html.ca-ai-gated .page-wrapper {
    overflow: hidden;
  }

  .ca-ai {
    --color-background: #0d110d;
    --color-foreground: #f2f2f2;
    --color-foreground-rgb: 242 242 242;
    --ca-ai-accent: #ff4d00;
    color: var(--color-foreground);
  }

  .ca-ai__canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100vw;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .ca-ai-live .ca-ai__canvas {
    opacity: 1;
  }

  .ca-ai__labels {
    position: fixed;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  /* ---- First screen ---- */
  .ca-ai-hero {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: calc(var(--ca-header-height, 117px) + 24px) clamp(40px, 7vh, 72px);
  }

  .ca-ai-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Both are the site's eyebrow (.ca-eyebrow), a size down. */
  .ca-ai-hero__eyebrow,
  .ca-ai-hero__hint {
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
  }

  .ca-ai-hero__eyebrow {
    max-width: 44ch;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .ca-ai-hero__heading {
    margin: 18px 0 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(2.5rem, 5.4vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .ca-ai-hero__text {
    max-width: 46ch;
    margin: 18px 0 0;
    font-size: var(--ca-fs-18, 1.125rem);
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    text-wrap: pretty;
  }

  .ca-ai-hero__gate {
    display: none;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-block-start: 30px;
  }

  .ca-ai-gated .ca-ai-hero__gate,
  .ca-ai-live.ca-ai-returning .ca-ai-hero__gate {
    display: flex;
  }

  /* A return visit: the page is open, so only the offer of sound remains. */
  .ca-ai-returning .ca-ai-hero__gate [data-ai-enter="silent"] {
    display: none;
  }

  .ca-ai-returning .ca-ai-hero__hint {
    margin-block-start: 26px;
  }

  .ca-ai-hero__hint {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: 34px;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .ca-ai-hero__hint::after {
    content: "";
    width: 1px;
    height: 34px;
    background: linear-gradient(rgb(var(--color-foreground-rgb) / 0.7), rgb(var(--color-foreground-rgb) / 0));
  }

  .ca-ai-gated .ca-ai-hero__hint {
    display: none;
  }

  /* ---- Autoplay and sound toggles ---- */
  .ca-ai__controls {
    position: fixed;
    inset: auto 20px 20px auto;
    z-index: 5;
    display: flex;
    gap: 8px;
  }

  .ca-ai-gated .ca-ai__controls {
    display: none;
  }

  .ca-ai__control {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border: 1px solid rgb(242 242 242 / 0.22);
    border-radius: 999px;
    background: rgb(13 17 13 / 0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: rgb(242 242 242 / 0.86);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    cursor: pointer;
  }

  .ca-ai__control[hidden] {
    display: none;
  }

  .ca-ai__control:hover {
    border-color: rgb(242 242 242 / 0.5);
  }

  .ca-ai__control:focus-visible {
    outline: 2px solid #f2f2f2;
    outline-offset: 3px;
  }

  /* Two bars while it plays on its own, a triangle once it is paused. */
  .ca-ai__auto-icon {
    box-sizing: border-box;
    width: 8px;
    height: 10px;
    border-inline: 2px solid var(--ca-ai-accent, #ff4d00);
  }

  .ca-ai__auto[aria-pressed="false"] .ca-ai__auto-icon {
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
    border-inline: 8px solid currentColor;
    border-inline-end-width: 0;
  }

  /* ---- The cue under a chapter's last act ---- */
  .ca-ai__cue {
    position: fixed;
    inset: auto auto 22px 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 0;
    translate: -50% 8px;
    font-family: var(--font-h6--family);
    font-weight: var(--font-h6--weight);
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(242 242 242 / 0.7);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease, translate 0.5s ease;
  }

  .ca-ai__cue::after {
    content: "";
    width: 1px;
    height: 26px;
    background: linear-gradient(rgb(242 242 242 / 0.7), rgb(242 242 242 / 0));
    animation: ca-ai-cue 1.8s ease-in-out infinite;
  }

  .ca-ai__cue.is-shown {
    opacity: 1;
    translate: -50% 0;
  }

  @keyframes ca-ai-cue {
    0% { transform: scaleY(0); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: top; }
    56% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  .ca-ai__sound-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .ca-ai__sound-bars i {
    width: 2px;
    height: 4px;
    background: currentColor;
  }

  .ca-ai__sound[aria-pressed="true"] .ca-ai__sound-bars i {
    background: var(--ca-ai-accent, #ff4d00);
    animation: ca-ai-bars 1.1s ease-in-out infinite;
  }

  .ca-ai__sound[aria-pressed="true"] .ca-ai__sound-bars i:nth-child(2) {
    animation-delay: 0.18s;
  }

  .ca-ai__sound[aria-pressed="true"] .ca-ai__sound-bars i:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes ca-ai-bars {
    0%, 100% { height: 4px; }
    50% { height: 12px; }
  }

  /* ---- Labels over the canvas ---- */
  .ca-ai-chip {
    position: absolute;
    inset: 0 auto auto 0;
    padding: 5px 10px;
    border: 1px solid rgb(242 242 242 / 0.24);
    border-radius: 999px;
    background: rgb(13 17 13 / 0.62);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: rgb(242 242 242 / 0.9);
    font-size: 0.8125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
  }

  .ca-ai-chip--ok {
    border-color: rgb(118 230 143 / 0.6);
    color: #a8f0b6;
  }

  .ca-ai-chip--alert {
    border-color: rgb(255 96 72 / 0.7);
    color: #ffb1a4;
  }

  .ca-ai-chip--quiet {
    border-color: transparent;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    color: rgb(242 242 242 / 0.5);
    font-family: var(--font-h6--family);
    font-weight: var(--font-h6--weight);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---- The wire from a readout to the drawing (wide screens) ---- */
  .ca-ai-wire {
    position: fixed;
    inset: 0;
    z-index: 2;
    width: 100vw;
    height: 100vh;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    /* Pale, not orange: it has to read across every drawing, the orange lattice included. */
    color: #f2f2f2;
  }

  .ca-ai-wire[data-tone="alert"] {
    color: #ff8f7d;
  }

  .ca-ai-wire[data-tone="ok"] {
    color: #a8f0b6;
  }

  .ca-ai-wire path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-opacity: 0.6;
    stroke-dasharray: 1 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .ca-ai-wire circle {
    fill: currentColor;
  }

  .ca-ai-wire .ca-ai-wire__ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  /* ---- Chapter rail (wide screens) ----
     One bar per chapter; the current one fills as it plays. Each is a button
     that goes to its chapter, and names it on hover or focus. */
  .ca-ai-rail {
    position: fixed;
    inset: 50% auto auto max(calc(var(--page-margin, 40px) - 13px), calc((100vw - var(--page-width, 1440px)) / 2 + var(--page-margin, 40px) - 13px));
    z-index: 3;
    display: none;
    translate: 0 -50%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0s linear 0.5s;
  }

  .ca-ai-rail.is-shown {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s ease;
  }

  .ca-ai-rail ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-ai-rail button {
    position: relative;
    display: block;
    width: 28px;
    height: 68px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .ca-ai-rail button:focus-visible {
    outline: 2px solid #f2f2f2;
    outline-offset: 0;
    border-radius: 6px;
  }

  .ca-ai-rail__track {
    position: absolute;
    inset: 5px auto 5px 13px;
    width: 2px;
    overflow: hidden;
    border-radius: 1px;
    background: rgb(242 242 242 / 0.18);
    transition: background-color 0.25s ease, scale 0.25s ease;
  }

  .ca-ai-rail button:hover .ca-ai-rail__track,
  .ca-ai-rail button:focus-visible .ca-ai-rail__track {
    background: rgb(242 242 242 / 0.42);
    scale: 1.5 1;
  }

  .ca-ai-rail__track::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ca-ai-accent, #ff4d00);
    transform: scaleY(var(--f, 0));
    transform-origin: top;
  }

  .ca-ai-rail li.is-done .ca-ai-rail__track::after {
    background: rgb(242 242 242 / 0.6);
  }

  .ca-ai-rail__name {
    position: absolute;
    inset: 50% auto auto 32px;
    translate: -6px -50%;
    padding: 7px 13px;
    border: 1px solid rgb(242 242 242 / 0.24);
    border-radius: 999px;
    background: rgb(13 17 13 / 0.94);
    color: #f2f2f2;
    font-size: 0.8125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, translate 0.25s ease;
  }

  .ca-ai-rail button:hover .ca-ai-rail__name,
  .ca-ai-rail button:focus-visible .ca-ai-rail__name {
    opacity: 1;
    translate: 0 -50%;
  }

  @media screen and (min-width: 990px) {
    .ca-ai-live .ca-ai-rail {
      display: block;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-ai-hero {
      padding-block-end: 34px;
    }

    .ca-ai-hero__gate {
      flex-direction: column;
      align-self: stretch;
    }

    .ca-ai__controls {
      inset: auto 12px 12px auto;
      gap: 6px;
    }

    .ca-ai__control {
      gap: 8px;
      padding: 8px 11px;
      font-size: 0.75rem;
    }

    .ca-ai__cue {
      inset: auto auto 18px 16px;
      flex-direction: row;
      translate: 0 8px;
    }

    .ca-ai__cue.is-shown {
      translate: 0 0;
    }

    .ca-ai__cue::after {
      width: 22px;
      height: 1px;
      animation: none;
    }

    .ca-ai-chip {
      padding: 4px 8px;
      font-size: 0.6875rem;
    }

    .ca-ai-chip--quiet {
      font-size: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ca-ai__canvas {
      transition: none;
    }

    .ca-ai__sound[aria-pressed="true"] .ca-ai__sound-bars i {
      animation: none;
      height: 10px;
    }

    .ca-ai__cue::after {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AI page opening",
  "tag": "section",
  "class": "ca-ai-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AI business intelligence and consulting for eCommerce brands" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "A brain for your business." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "header", "content": "Enter gate" },
    { "type": "text", "id": "enter_sound_label", "label": "With sound button", "default": "Enter with sound" },
    { "type": "text", "id": "enter_silent_label", "label": "Without sound button", "default": "Enter without sound" },
    { "type": "text", "id": "scroll_label", "label": "Scroll hint", "default": "Scroll" },
    { "type": "header", "content": "Autoplay" },
    {
      "type": "paragraph",
      "content": "Each act plays through by itself and moves on to the next act of its chapter. This toggle lets a visitor stop that."
    },
    { "type": "text", "id": "auto_on_label", "label": "Toggle label while it plays", "default": "Autoplay on" },
    { "type": "text", "id": "auto_off_label", "label": "Toggle label when stopped", "default": "Autoplay off" },
    { "type": "header", "content": "Sound" },
    { "type": "text", "id": "sound_on_label", "label": "Toggle label when playing", "default": "Sound on" },
    { "type": "text", "id": "sound_off_label", "label": "Toggle label when silent", "default": "Sound off" },
    {
      "type": "text",
      "id": "audio_url",
      "label": "Audio file URL",
      "info": "Optional. Replaces the theme's own ambient track."
    },
    { "type": "header", "content": "Brain example question" },
    { "type": "text", "id": "example_label", "label": "Label above the question", "default": "Example" },
    { "type": "header", "content": "Chapter rail" },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Name for screen readers",
      "info": "The bars down the left edge on wide screens. Each goes to its chapter.",
      "default": "Chapters"
    }
  ],
  "presets": [{ "name": "AI page opening", "category": "Conspire" }]
}
{% endschema %}
