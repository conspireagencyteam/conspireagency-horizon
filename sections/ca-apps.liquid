{%- comment -%}
  ca-apps.liquid — Conspire Agency "Our Shopify Apps" (Conspire v2.0, Figma 390-793).

  Head: h2 statement (indented first line, 920px column) + optional intro copy;
  right aside = Contact pill (top) and uppercase eyebrow (bottom).
  List: hairline rows, 40px block padding. Each row = app name (h3, 36px, links
  to the app page) + uppercase tagline | 480px description | 42px App Store pill.
  Optional per-app preview image floats beside the name on hover (desktop only),
  matching the Figma hover annotation.

  Apps are `app` blocks so names, copy and link targets can be repointed when
  the app pages move onto this site.
{%- endcomment -%}

{%- liquid
  assign store_label_top = section.settings.store_label_top | default: 'Find it on the'
  assign store_label_bottom = section.settings.store_label_bottom | default: 'Shopify App Store'
  assign contact_label = section.settings.contact_label | default: 'Contact Us'
  assign contact_link = section.settings.contact_link
-%}

<div class="ca-apps spacing-style color-custom-{{ section.id }}" style="{% render 'spacing-style', settings: section.settings %}">
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank or contact_link != blank -%}
      <div class="ca-apps__head">
        <div class="ca-apps__lede">
          {%- if section.settings.heading != blank -%}
            <h2 class="ca-apps__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="ca-apps__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if contact_link != blank or section.settings.eyebrow != blank -%}
          <div class="ca-apps__aside">
            {%- if contact_link != blank -%}
              <a class="ca-apps__contact" href="{{ contact_link }}">
                <span class="ca-apps__contact-label">{{ contact_label }}</span>
                <span class="ca-apps__contact-chip" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="20" height="20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 15L15 5M15 15V5H5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
            {%- if section.settings.eyebrow != blank -%}
              <p class="ca-eyebrow ca-apps__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ca-apps__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign app_link = block.settings.link
            assign store_url = block.settings.store_url
            assign preview = block.settings.preview
          -%}
          <li class="ca-app" {{ block.shopify_attributes }}>
            <div class="ca-app__id">
              <h3 class="ca-app__name">
                {%- if app_link != blank -%}
                  <a class="ca-app__name-link" href="{{ app_link }}">{{ block.settings.name }}</a>
                {%- else -%}
                  {{ block.settings.name }}
                {%- endif -%}
              </h3>
              {%- if block.settings.tagline != blank -%}
                <p class="ca-app__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              {%- if preview != blank -%}
                <span class="ca-app__preview" aria-hidden="true">
                  {{- preview | image_url: width: 760 | image_tag: loading: 'lazy', widths: '380, 760', sizes: '348px', alt: '' -}}
                </span>
              {%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}
              <div class="ca-app__body">{{ block.settings.description }}</div>
            {%- endif -%}
            {%- if store_url != blank -%}
              <div class="ca-app__cta">
                <a class="ca-app__store" href="{{ store_url }}" target="_blank" rel="noopener" aria-label="{{ block.settings.name }}: {{ store_label_top }} {{ store_label_bottom }}">
                  <span class="ca-app__store-icon" aria-hidden="true">
                    {%- render 'ca-icon', name: 'shopify', size: 24 -%}
                  </span>
                  <span class="ca-app__store-label">
                    <span class="ca-app__store-top">{{ store_label_top }}</span>
                    <span class="ca-app__store-bottom">{{ store_label_bottom }}</span>
                  </span>
                </a>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="ca-apps__empty">Add <strong>App</strong> blocks to this section to populate the list.</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-apps {
    background-color: var(--color-background);
  }

  .ca-apps__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-block-end: 120px;
  }

  .ca-apps__lede {
    max-width: 920px;
  }

  .ca-apps__heading {
    margin: 0;
    text-indent: 7vw;
  }

  .ca-apps__intro {
    margin-block-start: 24px;
    max-width: 640px;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .ca-apps__intro > :first-child { margin-block-start: 0; }
  .ca-apps__intro > :last-child { margin-block-end: 0; }

  .ca-apps__aside {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    align-self: stretch;
    gap: 24px;
  }

  .ca-apps__contact {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 5px 5px 5px 14px;
    border: 1px solid var(--color-foreground);
    border-radius: 1000px;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .ca-apps__contact-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 100px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    flex: 0 0 auto;
  }

  .ca-apps__contact:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .ca-apps__contact:hover .ca-apps__contact-chip {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .ca-apps__eyebrow {
    margin: 0;
    padding-block-start: 6px;
    text-align: right;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .ca-apps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-end: 1px solid var(--ca-hairline);
  }

  .ca-app {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 395px) minmax(0, 480px) auto;
    justify-content: space-between;
    gap: 24px 40px;
    align-items: start;
    padding-block: 40px;
    border-block-start: 1px solid var(--ca-hairline);
  }

  .ca-app__id {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ca-app__name {
    margin: 0;
    font-size: var(--font-h3--size);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-transform: capitalize;
  }

  .ca-app__name-link {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.04em;
  }

  .ca-app__name-link:hover,
  .ca-app__name-link:focus-visible {
    text-decoration: underline;
  }

  .ca-app__tagline {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-variant-numeric: lining-nums proportional-nums;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .ca-app__preview {
    display: none;
  }

  @media (hover: hover) and (min-width: 990px) {
    .ca-app__preview {
      display: block;
      position: absolute;
      inset-inline-start: calc(100% - 48px);
      inset-block-start: 50%;
      z-index: 2;
      width: 348px;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 3px 6px 6px rgb(0 0 0 / 0.15);
      opacity: 0;
      transform: translateY(-40%) scale(0.98);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .ca-app__preview img {
      display: block;
      width: 100%;
      height: auto;
    }

    .ca-app__id:has(.ca-app__name-link:hover) .ca-app__preview,
    .ca-app__id:has(.ca-app__name-link:focus-visible) .ca-app__preview {
      opacity: 1;
      transform: translateY(-40%) scale(1);
    }
  }

  .ca-app__body {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .ca-app__body > :first-child { margin-block-start: 0; }
  .ca-app__body > :last-child { margin-block-end: 0; }

  .ca-app__cta {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .ca-app__store {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding-inline: 14px 18px;
    border-radius: 100px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .ca-app__store:hover {
    opacity: 0.85;
  }

  .ca-app__store-icon {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .ca-app__store-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1;
  }

  .ca-app__store-top {
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ca-app__store-bottom {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ca-apps__empty {
    padding-block: 40px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text, 0.6));
  }

  @media screen and (max-width: 989px) {
    .ca-app {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .ca-app__cta {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-apps__head {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      margin-block-end: 56px;
    }

    .ca-apps__heading {
      text-indent: 0;
    }

    .ca-apps__intro {
      font-size: 1.125rem;
    }

    .ca-apps__aside {
      order: -1;
      align-self: auto;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .ca-apps__eyebrow {
      padding-block-start: 0;
      text-align: left;
    }

    .ca-app {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-block: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Apps",
  "tag": "section",
  "class": "ca-apps-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Shopify Apps"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our apps power hundreds of Shopify stores and reach millions of customers every month."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>They're built specifically for established, high-revenue business owners, with features tailored to the way they actually run their stores.</p>"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact button link"
    },
    {
      "type": "header",
      "content": "App Store button"
    },
    {
      "type": "text",
      "id": "store_label_top",
      "label": "Top line",
      "default": "Find it on the"
    },
    {
      "type": "text",
      "id": "store_label_bottom",
      "label": "Bottom line",
      "default": "Shopify App Store"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "app",
      "name": "App",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "App name"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "B2B for your Shopify store"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "App page link",
          "info": "Where the app name links to."
        },
        {
          "type": "url",
          "id": "store_url",
          "label": "Shopify App Store link"
        },
        {
          "type": "image_picker",
          "id": "preview",
          "label": "Hover preview (optional)",
          "info": "Shown beside the app name on hover, desktop only."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apps",
      "category": "Conspire",
      "settings": {
        "eyebrow": "Our Shopify Apps",
        "heading": "Our apps power hundreds of Shopify stores and reach millions of customers every month.",
        "intro": "<p>They're built specifically for established, high-revenue business owners, with features tailored to the way they actually run their stores.</p>",
        "contact_label": "Contact Us",
        "store_label_top": "Find it on the",
        "store_label_bottom": "Shopify App Store"
      },
      "blocks": [
        { "type": "app", "settings": { "name": "Bonde", "tagline": "Shopify Growth Super App", "link": "https://getbonde.com" } },
        { "type": "app", "settings": { "name": "Onboarding & Wholesale", "tagline": "B2B for your Shopify store", "link": "https://apps.conspireagency.com/wholesale" } },
        { "type": "app", "settings": { "name": "Wishlist Project Planner", "tagline": "B2B for your Shopify store", "link": "https://apps.conspireagency.com/wishlist" } },
        { "type": "app", "settings": { "name": "Draft Order Invoices", "tagline": "B2B for your Shopify store", "link": "https://apps.conspireagency.com/drafts" } }
      ]
    }
  ]
}
{% endschema %}
