{%- comment -%}
  ca-split-feature.liquid — statement, supporting paragraph and a pair of images
  (Conspire v2.0, Figma 458:216 "The Conspire Advantage").

  Eyebrow left; two-tone statement and a secondary paragraph on the right; below
  them a portrait image in the left third and a landscape image in the right two
  thirds. Either image can be left out.
{%- endcomment -%}

<div
  class="ca-split spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    <div class="ca-intro ca-split__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ca-eyebrow ca-intro__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <div class="ca-intro__main ca-split__main">
        {%- if section.settings.heading != blank -%}
          <h2 class="ca-statement">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ca-split__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button size-style ca-split__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}>
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.image_small != blank or section.settings.image_large != blank -%}
      <div class="ca-split__media">
        {%- if section.settings.image_small != blank -%}
          <div class="ca-split__small">
            {{ section.settings.image_small | image_url: width: 900 | image_tag: class: 'ca-split__img', loading: 'lazy', widths: '450, 900', sizes: '(min-width: 750px) 32vw, 100vw' }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_large != blank -%}
          <div class="ca-split__large">
            {{ section.settings.image_large | image_url: width: 1840 | image_tag: class: 'ca-split__img', loading: 'lazy', widths: '700, 920, 1400, 1840', sizes: '(min-width: 750px) 64vw, 100vw' }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-split {
    background-color: var(--color-background);
  }

  .ca-split__main {
    align-items: flex-start;
    gap: 32px;
  }

  .ca-split__text {
    font-size: var(--ca-fs-32);
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--ca-soft);
  }

  .ca-split__text p {
    margin: 0;
  }

  .ca-split__text p + p {
    margin-block-start: 0.8em;
  }

  .ca-split__button {
    align-self: flex-end;
  }

  .ca-split__media {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 24px;
    align-items: start;
    margin-block-start: 80px;
  }

  .ca-split__small {
    grid-column: 1 / span 4;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .ca-split__large {
    grid-column: 5 / -1;
    aspect-ratio: 920 / 518;
    overflow: hidden;
  }

  .ca-split__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .ca-split__media {
      margin-block-start: 48px;
    }
  }

  @media screen and (max-width: 749px) {
    .ca-split__small,
    .ca-split__large {
      grid-column: 1 / -1;
    }

    .ca-split__small {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Split feature",
  "tag": "section",
  "class": "ca-split-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Conspire advantage" },
    { "type": "inline_richtext", "id": "heading", "label": "Statement", "info": "Bold the words to emphasise. The rest is shown muted." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image_small", "label": "Portrait image (left)" },
    { "type": "image_picker", "id": "image_large", "label": "Landscape image (right)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#0d110d" },
    { "type": "color", "id": "text_color", "label": "t:settings.text", "default": "#ffffff" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Split feature", "category": "Conspire" }]
}
{% endschema %}
