{%- comment -%}
  ca-app-hero.liquid — shared hero for the B2B app pages, ported from the
  apps subsite (goat-apps-site: app/{wholesale,wishlist,drafts}/page.tsx and
  the hub in app/page.tsx).

  Layouts:
    app        rating pill above the H1, lede, Install / Documentation pills,
               proof line; the app tour on the right opens a modal <dialog>
               whose YouTube iframe only exists while the dialog is open
               (VideoTourButton.tsx), so closing it also stops playback.
    statement  the hub: display statement with the eyebrow as a right-hand
               kicker and the lede in the right column; "card" blocks draw the
               drifting photo strip behind it (HeroCards.tsx, hero-drift).
    cta        compact closing call to action (same copy slots, no tour).

  Full-bleed: the background is on the section wrapper; the content sits on
  the theme page grid (.ca-inner). Reveal + drift animations are CSS only and
  switch off under prefers-reduced-motion.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign layout = s.layout | default: 'app'
  assign tag = s.heading_tag | default: 'h1'
  assign heading = s.heading
  if heading == blank
    assign heading = page.title
  endif
  assign heading_inline = heading | replace: '<p>', '' | replace: '</p>', ' ' | strip
  assign transparent = s.allow_transparent_header
  assign rating_value = s.rating_value | strip
  assign rating_round = rating_value | round
  assign cards = section.blocks | where: 'type', 'card'
  assign pills = section.blocks | where: 'type', 'pill'
  assign has_tour = false
  if layout == 'app' and s.youtube_id != blank
    assign has_tour = true
  endif
  assign tour_title = s.tour_title | default: heading_inline
  assign poster = 'https://i.ytimg.com/vi/' | append: s.youtube_id | append: '/maxresdefault.jpg'
  assign tour_alt = s.tour_image.alt | default: tour_title
-%}

{%- if transparent and s.text_color != blank -%}
  {%- style -%}
    .ca-header { --ca-header-transparent-text: {{ s.text_color }}; }
    .ca-header { --ca-header-transparent-bg: {{ s.background_color | default: '#ffffff' }}; }
  {%- endstyle -%}
{%- endif -%}

<div
  class="ca-ahero ca-ahero--{{ layout }} spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: s.background_color %}{% if transparent %} ca-allow-transparent-header ca-under-header{% endif %}{% if cards.size > 0 %} ca-ahero--cards{% endif %}"
  style="{% render 'spacing-style', settings: s %}"
>
  {%- render 'contrast-override',
    background_color: s.background_color,
    text_color: s.text_color,
    section_id: section.id
  -%}

  {%- if cards.size > 0 -%}
    {%- comment -%} Strip rendered twice so translateX(-50%) is one seamless loop. {%- endcomment -%}
    <div class="ca-ahero__cards" aria-hidden="true">
      <div class="ca-ahero__strip">
        {%- for i in (1..2) -%}
          <div class="ca-ahero__strip-half">
            {%- for block in cards -%}
              <figure class="ca-ahero__card{% if block.settings.tall %} ca-ahero__card--tall{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 480', sizes: '212px', alt: '' }}
                {%- endif -%}
              </figure>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="ca-ahero__fade ca-ahero__fade--side"></div>
      <div class="ca-ahero__fade ca-ahero__fade--top"></div>
    </div>
  {%- endif -%}

  <div class="ca-inner ca-ahero__inner">
    {%- if layout == 'statement' -%}
      <div class="ca-ahero__top">
        <{{ tag }} class="ca-ahero__title ca-ahero__title--display ca-ahero__in" style="--i: 0">{{ heading_inline }}</{{ tag }}>
        {%- if s.eyebrow != blank -%}
          <p class="ca-eyebrow ca-ahero__kicker ca-ahero__in" style="--i: 1">{{ s.eyebrow }}</p>
        {%- endif -%}
      </div>
      {%- if s.lede != blank -%}
        <div class="ca-ahero__bottom">
          <div class="ca-ahero__lede rte ca-ahero__in" style="--i: 2">{{ s.lede }}</div>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="ca-ahero__copy">
        {%- if s.eyebrow != blank -%}
          <p class="ca-eyebrow ca-ahero__eyebrow ca-ahero__in" style="--i: 0">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- if rating_value != blank and s.store_url != blank -%}
          <a class="ca-ahero__rating ca-ahero__in" style="--i: 0" href="{{ s.store_url }}#adp-reviews" target="_blank" rel="noopener">
            <span class="ca-ahero__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg class="ca-ahero__star{% if i <= rating_round %} is-on{% endif %}" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
              {%- endfor -%}
            </span>
            <span><strong>{{ rating_value }}</strong> on the Shopify App Store{% if s.rating_count > 0 %}<span class="visually-hidden"> ({{ s.rating_count }} review{% if s.rating_count != 1 %}s{% endif %})</span>{% endif %}</span>
          </a>
        {%- endif -%}

        <{{ tag }} class="ca-ahero__title ca-ahero__in" style="--i: 1">{{ heading_inline }}</{{ tag }}>

        {%- if s.lede != blank -%}
          <div class="ca-ahero__lede rte ca-ahero__in" style="--i: 2">{{ s.lede }}</div>
        {%- endif -%}

        {%- if s.store_url != blank or s.docs_url != blank -%}
          <div class="ca-ahero__actions ca-ahero__in" style="--i: 3">
            {%- if s.store_label != blank and s.store_url != blank -%}
              <a class="button size-style" href="{{ s.store_url }}" target="_blank" rel="noopener">{{ s.store_label }}</a>
            {%- endif -%}
            {%- if s.docs_label != blank and s.docs_url != blank -%}
              <a class="button-secondary size-style" href="{{ s.docs_url }}" target="_blank" rel="noopener">{{ s.docs_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.proof != blank -%}
          <p class="ca-ahero__proof ca-ahero__in" style="--i: 4">{{ s.proof }}</p>
        {%- endif -%}

        {%- if pills.size > 0 -%}
          <ul class="ca-ahero__pills ca-ahero__in" style="--i: 5" role="list">
            {%- for block in pills -%}
              <li {{ block.shopify_attributes }}>
                <a class="ca-ahero__pill" href="{{ block.settings.link | default: '#' }}">
                  {%- if block.settings.badge != blank -%}<span class="ca-ahero__badge">{{ block.settings.badge }}</span>{%- endif -%}
                  {{ block.settings.label }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if has_tour -%}
        <ca-tour-dialog class="ca-ahero__media ca-ahero__in" style="--i: 2" data-video-id="{{ s.youtube_id | escape }}" data-title="{{ tour_title | escape }}">
          <button type="button" class="ca-ahero__poster" aria-haspopup="dialog" aria-label="Watch the tour{% if s.tour_duration != blank %} ({{ s.tour_duration }}){% endif %}: {{ tour_title | escape }}" data-tour-open>
            {%- if s.tour_image != blank -%}
              {{ s.tour_image | image_url: width: 1280 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '640, 960, 1280', sizes: '(min-width: 990px) 52vw, 100vw', alt: tour_alt }}
            {%- else -%}
              <img src="{{ poster }}" width="1280" height="720" alt="{{ tour_title | escape }}" loading="eager" fetchpriority="high">
            {%- endif -%}
            <span class="ca-ahero__play" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3.5v17l14-8.5z"/></svg></span>
          </button>
          <p class="ca-ahero__caption">
            <button type="button" class="ca-ahero__caption-btn" data-tour-open>Watch the tour{% if s.tour_duration != blank %} <span>· {{ s.tour_duration }}</span>{% endif %}</button>
          </p>
          <dialog class="ca-ahero__dialog" aria-label="{{ tour_title | escape }}">
            <div class="ca-ahero__dialog-box">
              <button type="button" class="ca-ahero__close" aria-label="Close video" data-tour-close>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
              <div class="ca-ahero__frame" data-tour-frame></div>
            </div>
          </dialog>
        </ca-tour-dialog>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-ahero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-background);
    color: rgb(var(--color-foreground-rgb));
  }
  .ca-ahero__inner {
    position: relative;
    display: grid;
    gap: 48px;
    align-items: center;
    text-align: center;
  }
  .ca-ahero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }
  .ca-ahero__eyebrow { margin-block-end: 20px; }
  .ca-ahero__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-end: 24px;
    padding: 8px 16px;
    border: 1px solid var(--ca-hairline-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.2;
    color: var(--ca-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .ca-ahero__rating:hover { text-decoration: underline; }
  .ca-ahero__rating strong { color: rgb(var(--color-foreground-rgb)); font-weight: 600; }
  .ca-ahero__stars { display: flex; gap: 2px; color: rgb(var(--color-foreground-rgb)); }
  .ca-ahero__star.is-on { fill: currentColor; stroke-width: 0; }
  .ca-ahero__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .ca-ahero__title--display { font-size: 3rem; max-width: 56rem; }
  .ca-ahero__lede {
    margin-block-start: 24px;
    font-size: var(--ca-fs-18);
    line-height: 1.6;
    color: var(--ca-soft);
  }
  .ca-ahero__lede > :first-child { margin-block-start: 0; }
  .ca-ahero__lede > :last-child { margin-block-end: 0; }
  .ca-ahero__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-block-start: 32px;
  }
  .ca-ahero__proof {
    margin: 24px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ca-muted);
  }
  .ca-ahero__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .ca-ahero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 6px;
    border: 1px solid var(--ca-hairline-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--ca-soft);
    text-decoration: none;
  }
  .ca-ahero__pill:hover { border-color: rgb(var(--color-foreground-rgb)); color: rgb(var(--color-foreground-rgb)); }
  .ca-ahero__badge {
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb));
    color: var(--color-background);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Tour poster + caption (YouTube.tsx on the subsite) */
  .ca-ahero__media { display: block; min-width: 0; }
  .ca-ahero__poster {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--ca-hairline);
    border-radius: 12px;
    background: #000;
    cursor: pointer;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
  .ca-ahero__poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  .ca-ahero__poster:hover img { opacity: 1; }
  .ca-ahero__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-background);
    color: rgb(var(--color-foreground-rgb));
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35), 0 0 0 4px rgb(255 255 255 / 0.4);
    transition: transform 0.2s;
  }
  .ca-ahero__play svg { margin-inline-start: 3px; }
  .ca-ahero__poster:hover .ca-ahero__play { transform: scale(1.05); }
  .ca-ahero__caption { margin: 8px 0 0; font-size: 0.875rem; color: var(--ca-muted); }
  .ca-ahero__caption-btn {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .ca-ahero__caption-btn:hover { color: rgb(var(--color-foreground-rgb)); }

  /* Modal */
  .ca-ahero__dialog {
    width: min(64rem, calc(100vw - 2rem));
    max-width: none;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: #fff;
  }
  .ca-ahero__dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
  }
  .ca-ahero__dialog-box { position: relative; }
  .ca-ahero__close {
    position: absolute;
    top: -48px;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: pointer;
  }
  .ca-ahero__close:hover { background: rgb(255 255 255 / 0.2); }
  .ca-ahero__frame {
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.5);
  }
  .ca-ahero__frame iframe { display: block; width: 100%; height: 100%; border: 0; }

  /* Statement (hub) layout */
  .ca-ahero--statement .ca-ahero__inner { text-align: start; gap: 40px; }
  .ca-ahero__top, .ca-ahero__bottom { display: grid; gap: 24px; }
  .ca-ahero__kicker { margin: 0; }
  .ca-ahero--statement .ca-ahero__lede { max-width: 42rem; margin: 0; }

  /* Drifting photo cards (HeroCards.tsx) */
  .ca-ahero__cards { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .ca-ahero__strip {
    position: absolute;
    inset-inline: 0;
    bottom: 32px;
    display: flex;
    width: max-content;
    animation: ca-hero-drift 90s linear infinite;
  }
  .ca-ahero__strip-half { display: flex; flex: none; align-items: flex-end; gap: 20px; padding-inline-end: 20px; }
  .ca-ahero__card {
    flex: none;
    width: 212px;
    height: 212px;
    margin: 0 0 40px;
    overflow: hidden;
    border-radius: 16px;
  }
  .ca-ahero__card--tall { height: 300px; margin-block-end: 0; }
  .ca-ahero__card img { width: 100%; height: 100%; object-fit: cover; }
  .ca-ahero__fade { position: absolute; inset: 0; }
  .ca-ahero__fade--side {
    background: linear-gradient(90deg, rgb(var(--color-background-rgb, 13 17 13) / 0.7), rgb(var(--color-background-rgb, 13 17 13) / 0.25) 35%, transparent);
  }
  .ca-ahero__fade--top { height: 160px; background: linear-gradient(var(--color-background), transparent); }
  .ca-ahero--cards .ca-ahero__cards::before { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / 0.55); z-index: 1; }
  @keyframes ca-hero-drift { to { transform: translateX(-50%); } }

  /* Staggered reveal */
  .ca-ahero__in {
    animation: ca-hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  @keyframes ca-hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  /* CTA variant */
  .ca-ahero--cta .ca-ahero__inner { max-width: 56rem; }
  .ca-ahero--cta .ca-ahero__title { font-size: 2.25rem; }

  @media screen and (min-width: 640px) {
    .ca-ahero__title { font-size: 3.5rem; }
    .ca-ahero__title--display { font-size: 4.5rem; }
    .ca-ahero--cta .ca-ahero__title { font-size: 3rem; }
    .ca-ahero__actions { flex-direction: row; }
  }
  @media screen and (min-width: 990px) {
    .ca-ahero--app .ca-ahero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      text-align: start;
    }
    .ca-ahero--app .ca-ahero__copy { align-items: flex-start; }
    .ca-ahero--app .ca-ahero__actions, .ca-ahero--app .ca-ahero__pills { justify-content: flex-start; }
    .ca-ahero__top { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .ca-ahero__kicker { padding-block-start: 12px; text-align: end; }
    .ca-ahero__bottom { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ca-ahero--statement .ca-ahero__lede { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ca-ahero__in { animation: none; }
    .ca-ahero__strip { animation: none; }
    .ca-ahero__poster img, .ca-ahero__play { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('ca-tour-dialog')) {
    customElements.define(
      'ca-tour-dialog',
      class extends HTMLElement {
        connectedCallback() {
          this.dialog = this.querySelector('dialog');
          this.frame = this.querySelector('[data-tour-frame]');
          if (!this.dialog || !this.frame) return;
          this.querySelectorAll('[data-tour-open]').forEach((b) => b.addEventListener('click', (e) => this.open(e.currentTarget)));
          this.querySelectorAll('[data-tour-close]').forEach((b) => b.addEventListener('click', () => this.close()));
          this.dialog.addEventListener('click', (e) => { if (e.target === this.dialog) this.close(); });
          this.dialog.addEventListener('cancel', (e) => { e.preventDefault(); this.close(); });
          this.dialog.addEventListener('close', () => this.unmount());
        }
        open(trigger) {
          this.trigger = trigger;
          const id = this.dataset.videoId;
          const iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0';
          iframe.title = this.dataset.title || 'Video';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          this.frame.replaceChildren(iframe);
          this.dialog.showModal();
        }
        close() {
          if (this.dialog.open) this.dialog.close();
          this.unmount();
        }
        unmount() {
          // Removing the iframe is what stops playback; focus goes back to the trigger.
          this.frame.replaceChildren();
          if (this.trigger && this.trigger.isConnected && document.activeElement !== this.trigger) {
            this.trigger.focus();
            this.trigger = null;
          }
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "CA App hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "app", "label": "App page (copy + tour)" },
        { "value": "statement", "label": "Statement (hub)" },
        { "value": "cta", "label": "Compact CTA" }
      ],
      "default": "app"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Statement layout: shown as the right-hand kicker." },
    { "type": "richtext", "id": "heading", "label": "Heading", "info": "Left empty, shows the page title." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "proof", "label": "Proof line" },
    { "type": "header", "content": "App Store rating" },
    { "type": "text", "id": "rating_value", "label": "Rating", "info": "e.g. 5.0 (leave empty to hide)" },
    { "type": "number", "id": "rating_count", "label": "Review count" },
    { "type": "header", "content": "Calls to action" },
    { "type": "text", "id": "store_label", "label": "App Store label", "default": "Install on Shopify" },
    { "type": "url", "id": "store_url", "label": "App Store URL" },
    { "type": "text", "id": "docs_label", "label": "Documentation label", "default": "Documentation" },
    { "type": "url", "id": "docs_url", "label": "Documentation URL" },
    { "type": "header", "content": "App tour" },
    { "type": "text", "id": "youtube_id", "label": "YouTube video id" },
    { "type": "text", "id": "tour_duration", "label": "Duration label", "info": "e.g. 1:32" },
    { "type": "text", "id": "tour_title", "label": "Video title", "info": "Accessible name of the player; falls back to the heading." },
    { "type": "image_picker", "id": "tour_image", "label": "Tour thumbnail", "info": "Falls back to the YouTube poster." },
    { "type": "header", "content": "Colors" },
