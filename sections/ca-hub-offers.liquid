{%- comment -%}
  ca-hub-offers.liquid: "How we work with you" on the vertical hub pages. A modified copy
  of the homepage's ca-feature-highlights (Conspire v2.0, Figma 97-85): an intro row
  (eyebrow and statement), then two feature cards with the homepage videos, in the order
  the house brief sells them (Fractional Shopify Teams first, then the Conspire Build).

  The words on each card come from an `offer` metaobject, so a price changes in one place:
    name        the card title
    eyebrow     the small line over it
    blurb       the paragraph (multi-line text)
    price_line  the price sentence, shown as its own line under the paragraph
    link_label  the button
    link        the offer page
    video       optional; the block's own video and poster are the fallback
  Each "offer" block names the entry by handle (fractional-shopify-teams,
  the-conspire-build) and carries the media settings. A block whose handle resolves to
  nothing renders only in the theme editor, with a hint.

  Media and playback are the feature-highlights pattern: <ca-feature-media> (defined in
  ca-feature-highlights.liquid, and here as well so either section works alone) plays the
  video while the card is at least half in view and never under reduced motion.
{%- endcomment -%}

{%- liquid
  assign offer_tag = 'h2'
  if section.settings.heading != blank
    assign offer_tag = 'h3'
  endif
-%}

<div
  class="ca-offers ca-feature spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- render 'ca-intro',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      start: 6,
      class: 'ca-offers__intro'
    -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ca-feature__grid ca-offers__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign handle = block.settings.handle | strip
            assign offer = blank
            if handle != blank
              assign offer = metaobjects.offer[handle]
            endif
            assign name = offer.name.value
            assign link = offer.link.value | replace: 'https://www.conspireagency.com', '' | replace: 'https://conspireagency.com', ''
            assign video = offer.video.value
            if video.sources == blank
              assign video = block.settings.video
            endif
            assign ratio = block.settings.image_ratio | default: '11 / 10'
          -%}
          {%- if name != blank -%}
            <article class="ca-feature__card ca-offer" {{ block.shopify_attributes }}>
              {%- if video != blank or block.settings.image != blank -%}
                {%- if link != blank -%}
                  <a class="ca-offer__media-link" href="{{ link }}" aria-label="{{ name | escape }}" tabindex="-1">
                {%- endif -%}
                <ca-feature-media class="ca-feature__media{% if block.settings.media_flush %} ca-feature__media--flush{% endif %}" style="--ca-feature-ratio: {{ ratio }};{% if block.settings.media_background != blank %} --ca-feature-media-bg: {{ block.settings.media_background }};{% endif %}">
                  {%- if video != blank -%}
                    {%- render 'ca-preview-video',
                      video: video,
                      quality: 'hd',
                      class: 'ca-feature__img ca-feature__video',
                      preload: 'metadata',
                      poster: block.settings.poster,
                      poster_width: 1000
                    -%}
                  {%- else -%}
                    {% render 'image', image: block.settings.image, height: 1000, class: 'ca-feature__img', alt_text_fallback: name %}
                  {%- endif -%}
                  {%- if link != blank -%}<span class="ca-feature__btn" aria-hidden="true"></span>{%- endif -%}
                </ca-feature-media>
                {%- if link != blank -%}</a>{%- endif -%}
              {%- endif -%}
              <div class="ca-feature__text ca-offer__text">
                {%- if offer.eyebrow.value != blank -%}
                  <p class="ca-eyebrow ca-feature__card-eyebrow">{{ offer.eyebrow.value }}</p>
                {%- endif -%}
                <{{ offer_tag }} class="ca-feature__title ca-offer__title">{{ name }}</{{ offer_tag }}>
                {%- if offer.blurb.value != blank -%}
                  <div class="ca-feature__body ca-offer__blurb">{{ offer.blurb.value | newline_to_br }}</div>
                {%- endif -%}
                {%- if offer.price_line.value != blank -%}
                  <p class="ca-offer__price">{{ offer.price_line.value }}</p>
                {%- endif -%}
                {%- if link != blank and offer.link_label.value != blank -%}
                  <a class="{{ section.settings.style_class | default: 'button' }} size-style ca-offer__button" href="{{ link }}">{{ offer.link_label.value }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- elsif request.design_mode -%}
            <p class="ca-offers__empty" {{ block.shopify_attributes }}>No <strong>offer</strong> entry with the handle "{{ handle }}".</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="ca-offers__empty">Add <strong>Offer</strong> blocks to this section.</p>
    {%- endif -%}
    {%- if section.settings.footer_label != blank and section.settings.footer_link != blank -%}
      <p class="ca-offers__footer"><a class="ca-offers__footer-link" href="{{ section.settings.footer_link }}">{{ section.settings.footer_label }}</a></p>
    {%- endif -%}
  </div>
</div>

<script>
  // Same element as ca-feature-highlights.liquid, guarded so whichever section
  // renders first defines it: plays the card video while at least half in view.
  if (!customElements.get('ca-feature-media')) {
    customElements.define('ca-feature-media', class extends HTMLElement {
      connectedCallback() {
        const video = this.querySelector('video');
        if (!video || !('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
              if (video.readyState === 0 && !video.dataset.loaded) {
                video.dataset.loaded = '1';
                video.load();
              }
              const attempt = video.play();
              if (attempt && attempt.catch) attempt.catch(() => {});
            } else if (!video.paused) {
              video.pause();
            }
          });
        }, { threshold: [0, 0.5] });
        this.io.observe(this);
      }

      disconnectedCallback() {
        this.io?.disconnect();
      }
    });
  }
</script>

{% stylesheet %}
  /* The card chrome (.ca-feature__media, __btn, __text, __title, __body and the
     tokens) is ca-feature-highlights' stylesheet; Horizon bundles every section's CSS
     site-wide, so it applies here too. Below: only what differs. */
  .ca-offers__intro {
    margin-block-end: 64px;
  }

  .ca-offers__grid {
    align-items: start;
  }

  .ca-offer__media-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ca-offer__media-link:hover .ca-feature__btn,
  .ca-offer__media-link:focus-visible .ca-feature__btn {
    opacity: 1;
  }

  .ca-offer__text {
    align-items: flex-start;
  }

  .ca-offer__title {
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .ca-offer__price {
    margin: 0;
    color: var(--ca-muted);
  }

  .ca-offer__button {
    margin-block-start: 12px;
  }

  .ca-offers__footer {
    margin: 48px 0 0;
    font-size: var(--ca-fs-18);
    letter-spacing: -0.02em;
  }

  .ca-offers__footer-link {
    color: inherit;
    text-underline-offset: 0.15em;
  }

  .ca-offers__empty {
    padding-block: 40px;
    color: var(--ca-muted);
  }

  @media screen and (max-width: 749px) {
    .ca-offers__intro {
      margin-block-end: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vertical hub offers",
  "tag": "section",
  "class": "ca-offers-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Each card's words (name, eyebrow, blurb, price line, link) come from an Offer metaobject entry, named by handle on the block, so a price is changed once in Content > Metaobjects > Offer." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How we work with you" },
    { "type": "inline_richtext", "id": "heading", "label": "Statement", "info": "Bold the words to emphasise. The rest is shown muted." },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        { "value": "button", "label": "t:options.primary" },
        { "value": "button-secondary", "label": "t:options.secondary" }
      ],
      "default": "button"
    },
    { "type": "text", "id": "footer_label", "label": "Closing link label", "default": "Pricing" },
    { "type": "url", "id": "footer_link", "label": "Closing link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "handle", "label": "Offer entry handle", "info": "fractional-shopify-teams or the-conspire-build.", "default": "fractional-shopify-teams" },
        { "type": "header", "content": "Media (the offer entry's video wins when set)" },
        { "type": "video", "id": "video", "label": "Video", "info": "Plays muted and looped while the card is in view." },
        { "type": "image_picker", "id": "poster", "label": "Video poster" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Used when there is no video." },
        { "type": "color", "id": "media_background", "label": "Media background", "default": "#0d110d" },
        { "type": "checkbox", "id": "media_flush", "label": "Media edge to edge", "default": false },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Media aspect ratio",
          "options": [
            { "value": "11 / 10", "label": "Tall (11:10)" },
            { "value": "3 / 2", "label": "Landscape (3:2)" },
            { "value": "4 / 3", "label": "Landscape (4:3)" },
            { "value": "16 / 9", "label": "Wide (16:9)" }
          ],
          "default": "11 / 10"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Vertical hub offers",
      "category": "Conspire",
      "blocks": [
        { "type": "offer", "settings": { "handle": "fractional-shopify-teams" } },
        { "type": "offer", "settings": { "handle": "the-conspire-build" } }
      ]
    }
  ]
}
{% endschema %}
