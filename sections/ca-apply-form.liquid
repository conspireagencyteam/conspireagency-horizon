{%- comment -%}
  ca-apply-form.liquid — "Apply for this Position" (Conspire v2.0, Figma 474:1129).

  Shopify's native contact form, so applications arrive at the store's contact
  email. Field names match the previous theme's careers form, plus a hidden
  Position field carrying the post title. Sits in the same right-hand columns as
  the article body; the wrapper id (default "apply") is what the body's extra
  table-of-contents entry links to.
{%- endcomment -%}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'apply' | handleize
  assign form_id = 'ca-apply-' | append: section.id
  assign options = section.settings.experience_options | newline_to_br | split: '<br />'
-%}

<div
  id="{{ anchor }}"
  class="ca-apply spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner ca-apply__grid">
    <div class="ca-apply__main">
      {%- if section.settings.heading != blank -%}
        <h2 class="ca-apply__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'ca-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="ca-form__status" role="status" tabindex="-1" autofocus>{{ section.settings.success_text }}</p>
        {%- elsif form.errors -%}
          <div class="ca-form__status ca-form__status--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[position]" value="{{ article.title | default: page.title | escape }}">

        <div class="ca-field">
          <label class="ca-field__label" for="{{ form_id }}-name">Name</label>
          <input class="ca-field__input" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" placeholder="Your name" required>
        </div>
        <div class="ca-field">
          <label class="ca-field__label" for="{{ form_id }}-email">Email</label>
          <input class="ca-field__input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com" required>
        </div>
        <div class="ca-field">
          <label class="ca-field__label" for="{{ form_id }}-phone">Phone</label>
          <input class="ca-field__input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="Your phone number">
        </div>
        <div class="ca-field">
          <label class="ca-field__label" for="{{ form_id }}-experience">Years of Shopify Experience</label>
          <span class="ca-field__select">
          <select class="ca-field__input" id="{{ form_id }}-experience" name="contact[shopify_experience]" required>
            <option value="" disabled selected>Select</option>
            {%- for option in options -%}
              {%- assign option_text = option | strip -%}
              {%- if option_text != blank -%}
                <option value="{{ option_text | escape }}">{{ option_text }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
          </span>
        </div>
        <div class="ca-field">
          <label class="ca-field__label" for="{{ form_id }}-location">Your Location</label>
          <input class="ca-field__input" id="{{ form_id }}-location" type="text" name="contact[location]" autocomplete="address-level2" placeholder="City, State">
        </div>
        <div class="ca-field ca-field--full">
          <label class="ca-field__label" for="{{ form_id }}-body">Additional Details About Your Experience</label>
          <textarea class="ca-field__input" id="{{ form_id }}-body" name="contact[body]" rows="6" placeholder="Tell us about the Shopify work you are proudest of"></textarea>
        </div>

        <div class="ca-form__foot">
          {%- if section.settings.note != blank -%}
            <p class="ca-form__note">{{ section.settings.note }}</p>
          {%- else -%}
            <span></span>
          {%- endif -%}
          <button class="ca-button" type="submit">{{ section.settings.button_label }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ca-apply {
    background-color: var(--color-background);
    scroll-margin-block-start: 80px;
  }

  .ca-apply__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
  }

  .ca-apply__main {
    grid-column: 5 / -1;
  }

  .ca-apply__heading {
    margin: 0 0 40px;
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  @media screen and (max-width: 989px) {
    .ca-apply__main {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Application form",
  "tag": "section",
  "class": "ca-apply-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply for this Position" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "The article body's extra list entry links here, as #apply.", "default": "apply" },
    { "type": "textarea", "id": "experience_options", "label": "Experience options", "info": "One per line", "default": "Less than 1 year\n1-2 years\n3-5 years\n5-10 years\n10+ years" },
    { "type": "text", "id": "note", "label": "Note beside the button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit Application" },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thanks, your application is in. We read every one and will be in touch if there is a fit." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Application form", "category": "Conspire" }]
}
{% endschema %}
