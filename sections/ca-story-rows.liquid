{%- comment -%}
  ca-story-rows.liquid — numbered story rows (Conspire v2.0, Figma 458:188).

  One hairline row per "row" block: a muted number top-left, a large paragraph
  bottom-left, and a tall image filling the right half.
{%- endcomment -%}

<div
  class="ca-story spacing-style color-custom-{{ section.id }}{% render 'ca-invert', color: section.settings.background_color %}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- render 'contrast-override',
    background_color: section.settings.background_color,
    text_color: section.settings.text_color,
    section_id: section.id
  -%}
  <div class="ca-inner">
    {%- if section.settings.eyebrow != blank -%}
      <h2 class="ca-eyebrow ca-story__eyebrow">{{ section.settings.eyebrow }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ca-story__list">
        {%- for block in section.blocks -%}
          <li class="ca-story__row{% if block.settings.image == blank %} ca-story__row--text{% endif %}" {{ block.shopify_attributes }}>
            <div class="ca-story__copy">
              {%- if section.settings.show_numbers -%}
                <span class="ca-story__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              {%- endif -%}
              <div class="ca-story__text">{{ block.settings.text }}</div>
            </div>
            {%- if block.settings.image != blank -%}
              <div class="ca-story__media">
                {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'ca-story__img', loading: 'lazy', widths: '480, 700, 1000, 1400', sizes: '(min-width: 750px) 48vw, 100vw' }}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ca-story {
    background-color: var(--color-background);
  }

  .ca-story__eyebrow {
    margin: 0 0 24px;
  }

  .ca-story__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-end: 1px solid var(--ca-hairline-strong);
  }

  .ca-story__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    padding-block: 40px;
    border-block-start: 1px solid var(--ca-hairline-strong);
  }

  .ca-story__row--text {
    grid-template-columns: minmax(0, 1fr);
  }

  .ca-story__copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }

  .ca-story__number {
    font-size: var(--ca-fs-36);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .ca-story__text {
    font-size: var(--ca-fs-32);
    line-height: 1.3;
    letter-spacing: -0.03em;
    text-indent: var(--ca-indent);
    color: var(--ca-soft);
  }

  .ca-story__text p {
    margin: 0;
  }

  .ca-story__text p + p {
    margin-block-start: 0.8em;
  }

  .ca-story__media {
    aspect-ratio: 684 / 600;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .ca-story__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ca-story__row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
      padding-block: 32px;
    }

    .ca-story__copy {
      gap: 16px;
    }

    .ca-story__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story rows",
  "tag": "section",
  "class": "ca-story-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_numbers", "label": "Show numbers", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f2f2f2" },
    { "type": "color", "id": "text_color", "label": "t:settings.text" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell part of the story here.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    { "name": "Story rows", "category": "Conspire", "blocks": [{ "type": "row" }, { "type": "row" }] }
  ]
}
{% endschema %}
