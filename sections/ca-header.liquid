{%- comment -%}
  ca-header.liquid — Conspire Agency minimal header (Conspire v2.0 design).

  Nav (left, from a Shopify navigation menu) + "Let's Talk" button + logo (right,
  theme logo setting). A nav item whose title matches a `services_mega` or
  `work_mega` block's "Menu item title" opens that mega menu (hover or click,
  desktop only); the mobile drawer lists the same content as nested groups.
  Solid + sticky by default. Goes transparent over the first section when that
  section opts in via `.ca-allow-transparent-header` (see ca-brands-marquee), and
  reverts to solid once scrolled (data-stuck, set by assets/ca-header.js).

  Lives in the header section group (see sections/header-group.json).
{%- endcomment -%}

<script src="{{ 'ca-header.js' | asset_url }}" type="module" fetchpriority="high"></script>

{%- liquid
  assign menu = section.settings.menu
  assign logo_height = settings.logo_height | default: 36
  assign logo_height_mobile = settings.logo_height_mobile | default: 28
  assign work_cases = section.blocks | where: 'type', 'work_case'
-%}

<ca-header
  class="ca-header{% if section.settings.sticky %} ca-header--sticky{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %} --ca-logo-height: {{ logo_height }}px; --ca-logo-height-mobile: {{ logo_height_mobile }}px;"
>
  <div class="ca-header__inner">
    <div class="ca-header__left">
      <button
        class="ca-header__toggle"
        type="button"
        data-ca-header-toggle
        aria-expanded="false"
        aria-controls="ca-header-drawer"
        aria-label="{{ 'accessibility.menu' | t | default: 'Menu' }}"
      >
        <span class="ca-header__toggle-box" aria-hidden="true">
          <span class="ca-header__toggle-bar"></span>
          <span class="ca-header__toggle-bar"></span>
        </span>
      </button>

      <nav class="ca-header__nav" aria-label="{{ 'accessibility.menu' | t }}">
        <ul class="ca-header__menu" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign mega_block = blank
              assign link_handle = link.title | downcase | handle
              for block in section.blocks
                if block.type == 'services_mega' or block.type == 'work_mega'
                  assign block_handle = block.settings.menu_title | downcase | handle
                  if block_handle == link_handle
                    assign mega_block = block
                    break
                  endif
                endif
              endfor
            -%}
            {%- if mega_block != blank -%}
              <li class="ca-header__item ca-header__item--mega" data-ca-mega {{ mega_block.shopify_attributes }}>
                <a
                  class="ca-header__link ca-header__link--mega"
                  href="{{ link.url }}"
                  data-ca-mega-trigger
                  {% if link.current or link.child_active %}aria-current="page"{% endif %}
                >{{ link.title }}</a>
                <button
                  type="button"
                  class="ca-header__disclosure"
                  data-ca-mega-toggle
                  aria-expanded="false"
                  aria-controls="ca-mega-{{ mega_block.id }}"
                  aria-label="{{ link.title }} menu"
                >
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="ca-header__mega ca-mega" id="ca-mega-{{ mega_block.id }}" data-ca-mega-panel-root inert>
                  <div class="ca-mega__inner">
                    {%- if mega_block.type == 'services_mega' -%}
                      {%- render 'ca-mega-services', block: mega_block -%}
                    {%- else -%}
                      {%- render 'ca-mega-work', block: mega_block, section: section -%}
                    {%- endif -%}
                  </div>
                </div>
              </li>
            {%- else -%}
              <li class="ca-header__item">
                <a
                  href="{{ link.url }}"
                  class="ca-header__link"
                  {% if link.current %}aria-current="page"{% endif %}
                >{{ link.title }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.cta_label != blank -%}
            <li class="ca-header__item ca-header__item--cta">
              <a class="button size-style ca-header__cta" href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_label }}</a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="ca-header__logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = 'accessibility.home_logo_alt' | t: store_name: shop.name -%}
        <img
          class="ca-header__logo-img ca-header__logo-img--original"
          src="{{ settings.logo | image_url: height: logo_height }}"
          width="{{ logo_height | times: settings.logo.aspect_ratio | ceil }}"
          height="{{ logo_height }}"
          alt="{{ logo_alt }}"
          loading="eager"
        >
        {%- if settings.logo_inverse != blank -%}
          <img
            class="ca-header__logo-img ca-header__logo-img--inverse"
            src="{{ settings.logo_inverse | image_url: height: logo_height }}"
            width="{{ logo_height | times: settings.logo_inverse.aspect_ratio | ceil }}"
            height="{{ logo_height }}"
            alt="{{ logo_alt }}"
            loading="eager"
          >
        {%- endif -%}
      {%- else -%}
        <span class="ca-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </div>

  {%- if section.settings.badge_show -%}
    {%- comment -%}
      Shopify Premier Partner ribbon: hangs off the header's bottom-left, flush to
      the viewport edge, and rides along with the sticky header over the page.
    {%- endcomment -%}
    <a
      class="ca-header__badge"
      href="{{ section.settings.badge_link | default: 'https://www.shopify.com/partners/directory/partner/conspire-agency' }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Shopify Premier Partner (opens in a new tab)"
    >
      {%- render 'ca-badge-premier' -%}
    </a>
  {%- endif -%}

  <div class="ca-header__drawer" id="ca-header-drawer" data-ca-header-drawer inert>
    <nav aria-label="{{ 'accessibility.menu' | t }}">
      <ul class="ca-header__drawer-menu" role="list">
        {%- for link in menu.links -%}
          {%- liquid
            assign mega_block = blank
            assign link_handle = link.title | downcase | handle
            for block in section.blocks
              if block.type == 'services_mega' or block.type == 'work_mega'
                assign block_handle = block.settings.menu_title | downcase | handle
                if block_handle == link_handle
                  assign mega_block = block
                  break
                endif
              endif
            endfor
          -%}
          <li>
            {%- if mega_block != blank -%}
              <a href="{{ link.url }}" class="ca-header__drawer-link ca-header__drawer-group"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
              <ul class="ca-header__drawer-sub" role="list">
                {%- if mega_block.type == 'services_mega' -%}
                  <li><a href="{{ mega_block.settings.s2_url | default: '/products/shopify-fractional-teams' }}">{{ mega_block.settings.s2_title | default: 'Fractional Shopify Teams' }}</a></li>
                  <li><a href="{{ mega_block.settings.s1_url | default: '/products/shopify-websites' }}">{{ mega_block.settings.s1_title | default: 'Shopify Website Builds' }}</a></li>
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign label_key = 'i' | append: i | append: '_label'
                      assign url_key = 'i' | append: i | append: '_url'
                    -%}
                    {%- if mega_block.settings[label_key] != blank -%}
                      <li><a href="{{ mega_block.settings[url_key] | default: '/blogs/work' }}">{{ mega_block.settings[label_key] }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- for case in work_cases -%}
                    <li><a href="{{ case.settings.url | default: '/blogs/work' }}">{{ case.settings.title }}</a></li>
                  {%- endfor -%}
                  <li><a href="{{ mega_block.settings.view_all_url | default: '/blogs/work' }}">{{ mega_block.settings.view_all_text | default: 'View all work' }}</a></li>
                {%- endif -%}
              </ul>
            {%- else -%}
              <a href="{{ link.url }}" class="ca-header__drawer-link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if section.settings.cta_label != blank -%}
          <li class="ca-header__drawer-cta">
            <a class="button size-style" href="{{ section.settings.cta_link | default: '/pages/contact' }}">{{ section.settings.cta_label }}</a>
          </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
  <div class="ca-header__overlay" data-ca-header-overlay inert></div>
</ca-header>

{% stylesheet %}
  .ca-header {
    display: block;
    position: relative;
    z-index: var(--layer-header-menu, 12);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  /* Sticky — mirror Horizon: make the header group `display: contents` so the
     section wrapper's containing block becomes <body> (spans the page), then
     stick the SECTION WRAPPER (not the inner element, whose containing block is
     the short group → would unstick instantly). */
  #header-group:has(.ca-header--sticky) {
    display: contents;
  }

  .ca-header-section:has(> .ca-header--sticky) {
    position: sticky;
    top: 0;
    z-index: var(--layer-header-menu, 12);
  }

  /* Kill the scroll-anchoring feedback loop: when the sticky header shrinks on
     scroll, the content above the viewport gets shorter and the browser nudges
     scrollTop to compensate — which re-fires the scroll handler and flickers.
     Disabling anchoring on the scroll container stops that nudge. (Safari has no
     scroll anchoring, so this is a no-op there.) */
  .page-wrapper:has(.ca-header--sticky) {
    overflow-anchor: none;
  }

  .ca-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
    padding-block: 20px;
  }

  .ca-header__left {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* Nav */
  .ca-header__menu {
    display: flex;
    align-items: center;
    gap: 64px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-header__item {
    display: flex;
    align-items: center;
  }

  .ca-header__link {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight, 500);
    font-size: 1.25rem; /* 20px */
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: opacity var(--animation-speed, 0.12s) ease;
  }

  .ca-header__link:hover,
  .ca-header__item--mega[data-open] .ca-header__link--mega {
    opacity: 0.6;
  }

  /* Disclosure chevron beside a mega-menu link: opens the panel without
     leaving the page (keyboard, touch); hover does it for the mouse. */
  .ca-header__disclosure {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-inline-start: 2px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    opacity: 0.55;
    transition: opacity var(--animation-speed, 0.12s) ease, transform 0.2s ease;
  }

  .ca-header__disclosure:hover,
  .ca-header__disclosure[aria-expanded="true"] {
    opacity: 1;
  }

  .ca-header__disclosure[aria-expanded="true"] {
    transform: rotate(180deg);
  }

  .ca-header__disclosure:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* "Let's Talk": the standard arrow-chip button, trimmed to sit in the nav row */
  .ca-header__item--cta {
    margin-inline-start: -16px;
  }

  .ca-header__cta {
    --ca-btn-chip-size: 1.75rem;
    --ca-btn-icon-size: 1.125rem;
    --ca-btn-gap: 0.75rem;
    font-size: 1rem;
    /* The header flips solid/transparent instantly; .button's colour
       transition would leave a white-on-white pill for a beat. */
    transition: none;
  }

  /* While a mega menu is open the header is always solid, even over a hero */
  .ca-header[data-mega-open] {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  /* ── Mega menu ─────────────────────────────────────────────────────── */
  .ca-mega {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 1;
    background-color: var(--color-background);
    color: var(--color-foreground);
    border-block-start: 1px solid var(--ca-hairline);
    box-shadow: 0 32px 48px -24px rgb(0 0 0 / 0.18);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.22s;
    pointer-events: none;
  }

  .ca-header__item--mega[data-open] .ca-mega {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
    pointer-events: auto;
  }

  .ca-mega__inner {
    max-width: var(--page-width, 1440px);
    margin-inline: auto;
    padding: 40px var(--page-margin, 24px) 48px;
  }

  .ca-mega__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
  }

  .ca-mega__col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  /* Services: 5 / 3 / 4 */
  .ca-mega__col--services { grid-column: 1 / span 5; padding-inline-end: 24px; }
  .ca-mega__col--specialties { grid-column: 6 / span 3; }
  .ca-mega__col--featured { grid-column: 9 / -1; }

  /* Work: 3 / 9 (media 6 + detail 3 inside the panel) */
  .ca-mega__col--cases { grid-column: 1 / span 3; }
  .ca-mega__col--detail { grid-column: 4 / -1; }

  .ca-mega__col--specialties,
  .ca-mega__col--featured,
  .ca-mega__col--detail {
    padding-inline-start: 24px;
    border-inline-start: 1px solid var(--ca-hairline);
  }

  .ca-mega__eyebrow {
    color: var(--ca-muted);
  }

  .ca-mega__title {
    display: block;
    font-family: var(--font-subheading--family);
    font-size: var(--ca-fs-24);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .ca-mega__desc {
    display: block;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ca-soft);
  }

  /* Primary services */
  .ca-mega__services {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--ca-hairline);
  }

  .ca-mega__service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: 24px;
    border-block-end: 1px solid var(--ca-hairline);
    color: inherit;
    text-decoration: none;
  }

  .ca-mega__service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ca-mega__arrow {
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .ca-mega__service:hover .ca-mega__arrow {
    transform: translate(2px, -2px);
  }

  .ca-mega__service:hover .ca-mega__title {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1px;
  }

  /* Hairline lists (specialties, case studies) */
  .ca-mega__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--ca-hairline);
  }

  .ca-mega__list-link {
    display: block;
    padding-block: 14px;
    border-block-end: 1px solid var(--ca-hairline);
    font-family: var(--font-subheading--family);
    font-size: var(--ca-fs-20);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: inherit;
    text-decoration: none;
    transition: padding-inline-start 0.2s ease, color 0.2s ease;
  }

  .ca-mega__list-link:hover,
  .ca-mega__list-link.is-active {
    padding-inline-start: 8px;
  }

  .ca-mega__list-link.is-active {
    color: var(--ca-soft);
  }

  /* Small uppercase link with arrow */
  .ca-mega__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight, 500);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .ca-mega__link .ca-icon {
    transition: transform 0.2s ease;
  }

  a:hover > .ca-mega__link .ca-icon,
  a:hover > .ca-mega__case-body > .ca-mega__link .ca-icon,
  a.ca-mega__link:hover .ca-icon {
    transform: translate(2px, -2px);
  }

  .ca-mega__view-all {
    margin-block-start: 8px;
  }

  /* Featured / case panels: stacked, one visible at a time */
  .ca-mega__stack,
  .ca-mega__col--detail {
    position: relative;
  }

  .ca-mega__feature,
  .ca-mega__case {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .ca-mega__feature:not(.is-active),
  .ca-mega__case:not(.is-active) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Fixed-ratio frame; media is absolutely positioned so a tall video can't
     grow the frame (grid items default to min-height: auto). */
  .ca-mega__media {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--ca-hairline);
  }

  .ca-mega__media > img,
  .ca-mega__media > video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ca-mega__feature-eyebrow {
    color: var(--ca-muted);
  }

  .ca-mega__feature-title {
    display: block;
    font-family: var(--font-subheading--family);
    font-size: var(--ca-fs-20);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .ca-mega__feature:hover .ca-mega__feature-title,
  .ca-mega__case:hover .ca-mega__title {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1px;
  }

  /* Work case panel: media left (6 cols), copy right (3 cols) */
  .ca-mega__case {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }

  .ca-mega__case-media {
    grid-column: 1 / span 6;
  }

  .ca-mega__case-body {
    grid-column: 7 / -1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ca-mega__pills {
    margin-block: 4px;
  }

  .ca-mega .ca-pill {
    min-height: 32px;
    padding: 5px 12px;
    font-size: 0.875rem;
  }

  @media screen and (max-width: 1199px) {
    .ca-header__menu {
      gap: 40px;
    }

    .ca-mega__col--services { grid-column: 1 / span 4; }
    .ca-mega__col--specialties { grid-column: 5 / span 3; }
    .ca-mega__col--featured { grid-column: 8 / -1; }
  }

  /* Logo */
  .ca-header__logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .ca-header__logo-img {
    display: block;
    height: auto;
    width: auto;
    max-height: var(--ca-logo-height, 36px);
    object-fit: contain;
    transition: max-height var(--animation-speed, 0.2s) ease;
  }

  /* Once stuck (scrolled — data-stuck set by ca-header.js), shrink the logo to
     the mobile logo height. */
  .ca-header[data-stuck] .ca-header__logo-img {
    max-height: var(--ca-logo-height-mobile, 28px);
  }

  .ca-header__logo-img--inverse {
    display: none;
  }

  .ca-header__logo-text {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--h5, 1.5rem);
    font-weight: 500;
  }

  /* Premier Partner ribbon — a foreground-coloured tab with a notched tail,
     pinned to the header's bottom-left and overlapping whatever is below.
     Colours follow the header: foreground tab / background mark, and the
     transparent-over-hero rule swaps them for the hero's pair. */
  .ca-header__badge {
    --ca-badge-fg: var(--color-foreground);
    --ca-badge-bg: var(--color-background);
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    z-index: 1;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 48px;
    padding: 0 34px 0 12px; /* right: 12px + 22px tail */
    background-color: var(--ca-badge-fg);
    color: var(--ca-badge-bg);
    clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 50%, 100% 100%, 0 100%);
    transition:
      opacity var(--animation-speed, 0.2s) ease,
      transform var(--animation-speed, 0.2s) ease;
  }

  .ca-header__badge:hover {
    color: var(--ca-badge-bg);
  }

  .ca-header__badge:focus-visible {
    outline: 2px solid var(--ca-badge-fg);
    outline-offset: 2px;
  }

  .ca-badge__svg {
    display: block;
    height: 28px;
    width: auto;
  }

  /* Tuck the ribbon away while a mega menu is open or the drawer is up */
  .ca-header[data-mega-open] .ca-header__badge,
  .ca-header[data-drawer-open] .ca-header__badge {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  /* Hamburger — mobile only */
  .ca-header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-inline-start: -10px;
    padding: 0;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }

  .ca-header__toggle-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 24px;
  }

  .ca-header__toggle-bar {
    height: 2px;
    width: 100%;
    background-color: currentcolor;
    transition: transform var(--animation-speed, 0.12s) ease, opacity var(--animation-speed, 0.12s) ease;
  }

  .ca-header[data-drawer-open] .ca-header__toggle-bar:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }

  .ca-header[data-drawer-open] .ca-header__toggle-bar:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Mobile drawer */
  .ca-header__drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(80vw, 360px);
    padding: 96px 32px 32px;
    background-color: var(--color-background);
    color: var(--color-foreground);
    z-index: var(--layer-menu-drawer, 18);
    transform: translateX(100%);
    transition: transform var(--drawer-animation-speed, 0.2s) var(--ease-out-quad, ease);
    overflow-y: auto;
    pointer-events: none;
  }

  .ca-header[data-drawer-open] .ca-header__drawer {
    transform: translateX(0);
    pointer-events: auto;
  }

  .ca-header__drawer-menu {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ca-header__drawer-link {
    margin: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight, 500);
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: inherit;
    text-decoration: none;
  }

  .ca-header__drawer-group {
    display: block;
    margin-block-end: 12px;
  }

  .ca-header__drawer-sub {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--ca-hairline);
  }

  .ca-header__drawer-sub a {
    display: block;
    padding-block: 10px;
    border-block-end: 1px solid var(--ca-hairline);
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    color: inherit;
    text-decoration: none;
  }

  .ca-header__drawer-cta {
    margin-block-start: 8px;
  }

  .ca-header__overlay {
    position: fixed;
    inset: 0;
    background-color: rgb(0 0 0 / 0.4);
    z-index: var(--layer-overlay, 16);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--drawer-animation-speed, 0.2s) ease;
  }

  .ca-header[data-drawer-open] .ca-header__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .ca-header__nav {
      display: none;
    }

    .ca-header__toggle {
      display: inline-flex;
    }

    .ca-header__inner {
      padding-block: 10px;
    }

    .ca-header__logo-img {
      max-height: var(--ca-logo-height-mobile, 28px);
    }

    /* The ribbon would sit on top of hero copy at the mobile margin */
    .ca-header__badge {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ca-header__drawer,
    .ca-header__overlay {
      display: none;
    }
  }

  /*
   * Transparent-over-hero: only when the FIRST section opts in
   * (renders .ca-allow-transparent-header) and the header hasn't stuck yet.
   * The transparent text color + logo swap come from that section
   * (--ca-header-transparent-text, set on .ca-header).
   */
  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) {
    background-color: transparent;
    color: var(--ca-header-transparent-text, var(--color-foreground));
  }

  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) .ca-header__logo-img--original {
    display: var(--ca-header-logo-original-display, block);
  }

  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]):has(.ca-header__logo-img--inverse) .ca-header__logo-img--original {
    display: none;
  }

  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) .ca-header__logo-img--inverse {
    display: block;
  }

  /* Over a hero the CTA inverts to the hero's text/background pair so the pill
     stays visible (a black pill on a near-black hero would vanish). */
  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) .ca-header__cta,
  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) .ca-header__cta:hover {
    --button-background-color: var(--ca-header-transparent-text, var(--color-foreground));
    --button-border-color: var(--ca-header-transparent-text, var(--color-foreground));
    --button-color: var(--ca-header-transparent-bg, var(--color-background));
  }

  body:has(#MainContent > .shopify-section:first-child .ca-allow-transparent-header) .ca-header--sticky:not([data-stuck]):not([data-mega-open]) .ca-header__badge {
    --ca-badge-fg: var(--ca-header-transparent-text, var(--color-foreground));
    --ca-badge-bg: var(--ca-header-transparent-bg, var(--color-background));
  }

  /* Solid state gets a hairline + subtle shadow once stuck */
  .ca-header--sticky[data-stuck] {
    box-shadow: 0 1px 0 rgb(var(--color-foreground-rgb) / 0.08);
  }
{% endstylesheet %}

