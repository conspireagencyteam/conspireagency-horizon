{
  "sections": {
    "opening": {
      "type": "ca-ai-opening",
      "settings": {
        "eyebrow": "AI business intelligence and consulting for eCommerce brands",
        "heading": "A brain for your business.",
        "text": "One memory for everything your team, your store, your code and your marketing platforms know.",
        "enter_sound_label": "Enter with sound",
        "enter_silent_label": "Enter without sound",
        "scroll_label": "Scroll",
        "sound_on_label": "Sound on",
        "sound_off_label": "Sound off",
        "audio_url": "",
        "example_label": "Example"
      }
    },
    "brain": {
      "type": "ca-ai-chapter",
      "blocks": {
        "act_1": {
          "type": "act",
          "settings": {
            "heading": "The answer is already inside your business, in places that never meet.",
            "text": "<p>Part of it is in a Slack thread, part in a release, part in an ad account, part in last week's call.</p>",
            "length": 260
          }
        },
        "act_2": {
          "type": "act",
          "settings": {
            "heading": "Connect everything, and the answer is in there somewhere.",
            "text": "<p>Every email, thread, call, task, release and store metric, in one memory. Now all of it has to be read, every time someone asks.</p>",
            "length": 280
          }
        },
        "act_3": {
          "type": "act",
          "settings": {
            "heading": "So the brain files by meaning, and goes straight to what matters.",
            "text": "<p>A question lands on the few records that answer it, and comes back as one answer with its sources.</p>",
            "length": 320
          }
        }
      },
      "block_order": [
        "act_1",
        "act_2",
        "act_3"
      ],
      "settings": {
        "variant": "brain",
        "number": "01",
        "chapter": "The business brain"
      }
    },
    "manager": {
      "type": "ca-ai-chapter",
      "blocks": {
        "act_1": {
          "type": "act",
          "settings": {
            "heading": "Every release, walked through the way a shopper would.",
            "text": "<p>On desktop and on a phone, after each release. A failure that is confirmed is rolled back.</p>",
            "length": 280
          }
        },
        "act_2": {
          "type": "act",
          "settings": {
            "heading": "It looks for the failures that look fine.",
            "text": "<p>A collection that quietly stops showing one product. A filter that returns the wrong ones. A checkout with no shipping rates. Each is checked again before anyone is told.</p>",
            "length": 280
          }
        },
        "act_3": {
          "type": "act",
          "settings": {
            "heading": "And it knows what never to touch.",
            "text": "<p>What was checked, what was caught and what became of it sit in one view.</p>",
            "length": 230,
            "never": "Pay for an order\nSubmit a real form\nSign in to your admin",
            "never_label": "Never"
          }
        }
      },
      "block_order": [
        "act_1",
        "act_2",
        "act_3"
      ],
      "settings": {
        "variant": "manager",
        "number": "02",
        "chapter": "The AI site manager"
      }
    },
    "healing": {
      "type": "ca-ai-chapter",
      "blocks": {
        "act_1": {
          "type": "act",
          "settings": {
            "heading": "When something breaks behind your store, it is found first.",
            "text": "<p>Errors are picked up from the systems your orders depend on, not from a customer writing in.</p>",
            "length": 240
          }
        },
        "act_2": {
          "type": "act",
          "settings": {
            "heading": "Diagnosed, fixed, reviewed and merged.",
            "text": "<p>A second reviewer reads every fix before it ships. People set the rules for what may merge on its own.</p>",
            "length": 280
          }
        },
        "act_3": {
          "type": "act",
          "settings": {
            "heading": "Then verified, the same way a release is.",
            "text": "<p>Security moves at the same pace. When a critical vulnerability was announced in October, our own systems were patched the next day.</p>",
            "length": 240
          }
        }
      },
      "block_order": [
        "act_1",
        "act_2",
        "act_3"
      ],
      "settings": {
        "variant": "healing",
        "number": "03",
        "chapter": "Self-healing software"
      }
    },
    "close": {
      "type": "ca-ai-chapter",
      "blocks": {
        "act_1": {
          "type": "act",
          "settings": {
            "heading": "Know what is happening across your business, and have it handled.",
            "text": "<p>We set this up around your store, your team and your tools, then run it with you.</p>",
            "length": 180,
            "button_label": "Book a call",
            "button_link": ""
          }
        }
      },
      "block_order": [
        "act_1"
      ],
      "settings": {
        "variant": "close",
        "number": "",
        "chapter": ""
      }
    },
