          }
        },
        "drafts": {
          "type": "app",
          "settings": {
            "name": "B2B Draft Order Invoices",
            "tagline": "When a pallet order needs a quote first and an invoice the customer can pay on terms.",
            "description": "<p>Quote requests from the product page, draft order invoices the customer views and pays from their account, PDF downloads and payment reminders, inside Shopify. Ours.</p>",
