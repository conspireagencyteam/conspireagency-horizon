        "wishlist": {
          "type": "app",
          "settings": {
            "name": "B2B Wishlist Project Planner",
            "tagline": "When a designer is specifying a whole house, room by room, and ordering it in stages.",
            "description": "<p>Projects and rooms on the product page, quantities by the box, shared lists, PDF quotes and draft orders, so a trade buyer plans the job in your Shopify store instead of a spreadsheet. Ours; it runs on Zia Tile and Replica Plants &amp; Decor.</p>",
            "page_link": "/pages/b2b-wishlist-project-planner",
            "page_label": "B2B Wishlist Project Planner",
            "store_link": "",
            "store_label": "",
            "docs_link": "https://apps.conspireagency.com/wishlist/docs",
