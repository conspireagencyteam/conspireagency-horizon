    "offers": {
      "type": "ca-hub-offers",
      "blocks": {
        "fractional": {
          "type": "offer",
          "settings": {
            "eyebrow": "Fractional Shopify Teams",
            "text": "<p>A senior team that becomes part of yours: strategy, design, development, CRO, compliance, SEO, monitoring and attribution, in your Slack and on your standups, with one accountable lead. Priced per month on a 12-month commitment. There is a reason some of our clients have been with us for almost a decade.</p>",
            "override_key": "hub_fractional",
            "button_label": "Fractional Shopify Teams",
            "button_link": "shopify://products/shopify-fractional-teams"
          }
        },
        "build": {
          "type": "offer",
          "settings": {
            "eyebrow": "The Conspire Build",
            "text": "<p>One scoped build, line by line: strategic onboarding, art direction, conversion-focused UX, full design, development, launch and handoff. Migration is part of the build when the brand is moving to Shopify. Six to twelve weeks. Most build clients stay on as a fractional team afterwards.</p>",
            "override_key": "hub_build",
            "button_label": "The Conspire Build",
            "button_link": "shopify://products/shopify-websites"
          }
        }
      },
      "block_order": [
        "fractional",
        "build"
      ],
      "settings": {
        "eyebrow": "How we work with you",
        "heading": "<strong>A senior team that becomes part of yours.</strong> Fractional first; the Conspire Build when the Shopify store has to be rebuilt or moved.",
