      "settings": {
        "eyebrow": "Book a strategy call",
        "heading": "",
        "button_label": "",
        "statement": "<p>The first call is an introduction: some light discovery and a feel for whether we are a fit on both sides. If we are, the next step is an audit and a roadmap for at least the next six months. Then you hand your store's entire task list to a senior team that integrates with yours. No training, no ramp.</p>",
        "column_start": "6",
        "answer_size": "regular",
        "open_first": true,
        "structured_data": false,
