{%- comment -%}
  ca-schema.liquid — site-wide JSON-LD, rendered once from ca-head.liquid.

  Emits, each as its own <script type="application/ld+json">:
    - Organization (ProfessionalService + LocalBusiness)   every page
    - WebSite (+ SearchAction)                              every page
    - ItemList of SiteNavigationElement (from header menu)  every page
    - WebPage + speakable                                   home only
    - CollectionPage                                        collections
    - CollectionPage + hasPart BlogPosting list             blog listings
    - Dispatch to ca-service-schema (products) and
      ca-article-schema / ca-case-study-schema (articles)

  All URLs are absolute on the canonical host. Never use request.origin
  (it is 127.0.0.1 under `shopify theme dev`).
{%- endcomment -%}

{%- liquid
  assign site = 'https://www.conspireagency.com'
  assign org_id = site | append: '/#organization'
  assign website_id = site | append: '/#website'
  assign og_image = site | append: '/cdn/shop/files/conspire-shopify-developers-site-image.png'
  assign search_term = '{search_term_string}'
  assign search_target = site | append: '/search?q=' | append: search_term

  comment
    image_url returns "//www.conspireagency.com/cdn/shop/..." on live and
    "/cdn/shop/..." under theme dev. Re-host every image on the canonical
    domain by keeping only the path from "/cdn/" onwards.
  endcomment
  assign cdn_prefix = site | append: '/cdn/'
  assign logo_url = og_image
  if settings.logo != blank
    assign logo_src = settings.logo | image_url: width: 600
    if logo_src contains '/cdn/'
      assign logo_url = logo_src | split: '/cdn/' | last | prepend: cdn_prefix
    endif
  endif

  assign nav_menu = linklists['2025-header-nav']
-%}

{%- comment -%} 1. Organization {%- endcomment -%}
