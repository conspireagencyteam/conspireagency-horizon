{%- comment -%}
  ca-hub-story.liquid: one client story for a vertical hub (see sections/ca-hub-stories).
  A copy column beside one to three real captures of the client's Shopify store.

  @param {string} name - client name, never broken across lines
  @param {string} [who] - one line: what the brand is and who it sells to
  @param {string} heading - the story's H3
  @param {string} [text] - HTML paragraphs, no bold
  @param {string} [outcome] - one line; the row is omitted when blank
  @param {string} [outcome_label]
  @param {string} [link_url]
  @param {string} [link_label]
  @param {image} [image_1] - the main capture
  @param {image} [image_2] - overlaps the main capture at the lower right corner (a capture's heading is usually top left)
  @param {image} [image_3] - overlaps the main capture at the upper left corner
  @param {string} [caption]
  @param {string} side - 'right' or 'left' (where the captures sit)
  @param {number} index - 1-based position
  @param {string} [attrs] - block.shopify_attributes
{%- endcomment -%}
{%- liquid
  assign shots = 0
  if image_1 != blank
    assign shots = shots | plus: 1
  endif
  if image_2 != blank
    assign shots = shots | plus: 1
  endif
  if image_3 != blank
    assign shots = shots | plus: 1
  endif
  assign default_alt = name | append: ' Shopify store'
  assign alt_1 = image_1.alt | default: default_alt
  assign alt_2 = image_2.alt | default: default_alt
  assign alt_3 = image_3.alt | default: default_alt
-%}
<article class="ca-hstory ca-hstory--{{ side }} ca-hstory--shots-{{ shots }}" {{ attrs }}>
  <div class="ca-hstory__copy">
    <p class="ca-eyebrow ca-hstory__client">
      <span class="ca-hstory__num" aria-hidden="true">{% if index < 10 %}0{% endif %}{{ index }}</span>
      <span class="ca-hstory__name">{{ name }}</span>
    </p>
    <h3 class="ca-hstory__heading">{{ heading }}</h3>
    {%- if who != blank -%}
      <p class="ca-hstory__who">{{ who }}</p>
    {%- endif -%}
    {%- if text != blank -%}
      <div class="ca-hstory__text ca-rte">{{ text }}</div>
    {%- endif -%}
    {%- if outcome != blank -%}
      <p class="ca-hstory__outcome">
        <span class="ca-eyebrow ca-hstory__outcome-label">{{ outcome_label | default: 'What changed' }}</span>
        <span class="ca-hstory__outcome-text">{{ outcome }}</span>
      </p>
    {%- endif -%}
    {%- if link_url != blank and link_label != blank -%}
      <p class="ca-hstory__link-row">
        <a class="ca-hstory__link" href="{{ link_url }}">{{ link_label }}</a>
      </p>
    {%- endif -%}
  </div>

  {%- if shots > 0 -%}
    <div class="ca-hstory__media">
      <div class="ca-hstory__stack">
        {%- if image_1 != blank -%}
          <figure class="ca-hstory__shot ca-hstory__shot--main">
            {{- image_1 | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 800, 1200, 1600', sizes: '(min-width: 990px) 44vw, 92vw', alt: alt_1 -}}
          </figure>
        {%- endif -%}
        {%- if image_2 != blank -%}
          <figure class="ca-hstory__shot ca-hstory__shot--over{% if image_2.aspect_ratio < 0.85 %} ca-hstory__shot--tall{% endif %}">
            {{- image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 480, 700, 900', sizes: '(min-width: 990px) 20vw, 42vw', alt: alt_2 -}}
          </figure>
        {%- endif -%}
        {%- if image_3 != blank -%}
          <figure class="ca-hstory__shot ca-hstory__shot--top{% if image_3.aspect_ratio < 0.85 %} ca-hstory__shot--tall{% endif %}">
            {{- image_3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 480, 700, 900', sizes: '(min-width: 990px) 18vw, 40vw', alt: alt_3 -}}
          </figure>
        {%- endif -%}
      </div>
      {%- if caption != blank -%}
        <p class="ca-hstory__caption">{{ caption }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
