{%- comment -%}
  ca-icon.liquid — named inline SVG icons for the Conspire (ca-*) layer.

  Usage:
    {% render 'ca-icon', name: 'shopify', size: 24, class: 'ca-app__store-svg' %}

  @param {string} name - icon name (shopify, arrow-up-right)
  @param {number} [size] - width/height in px (default 20)
  @param {string} [class] - extra classes
{%- endcomment -%}
{%- liquid
  assign icon = name | default: ''
  assign px = size | default: 20
-%}
{%- case icon -%}
