{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
{%- comment -%} Conspire Agency: removed empty theme-color meta {%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- comment -%} Conspire Agency: absolute https og:image at 1200px, no og:price (services store) {%- endcomment -%}
{%- if page_image -%}
  {%- liquid
    # image_url host varies (primary domain, myshopify, or bare /cdn/ under theme dev); pin it to the canonical host
    assign ca_og_image = page_image | image_url: width: 1200
    if ca_og_image contains '/cdn/'
      assign ca_og_image = ca_og_image | split: '/cdn/' | last | prepend: 'https://www.conspireagency.com/cdn/'
    else
      assign ca_og_image = ca_og_image | prepend: 'https:'
    endif
  -%}
  <meta
    property="og:image"
    content="{{ ca_og_image }}"
  >
  <meta
    property="og:image:secure_url"
    content="{{ ca_og_image }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
  <meta
    name="twitter:image"
    content="{{ ca_og_image }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- comment -%} Conspire Agency: one-line title, " | Conspire" separator, Page N only where the template paginates, search canonical without ?q= + noindex {%- endcomment -%}
{%- liquid
  assign ca_page = current_page
  assign ca_canonical = canonical_url
  if request.page_type == 'blog' and blog.handle == 'work'
    assign ca_page = 1
    assign ca_canonical = canonical_url | split: '?' | first
  elsif request.page_type == 'search'
    assign ca_canonical = canonical_url | split: '?' | first
  endif
  assign ca_title = page_title
  if current_tags
    assign ca_tags = current_tags | join: ', '
    assign ca_title = ca_title | append: ' – tagged "' | append: ca_tags | append: '"'
  endif
  if ca_page != 1
    assign ca_title = ca_title | append: ' – Page ' | append: ca_page
  endif
  unless page_title contains shop.name
    assign ca_title = ca_title | append: ' | ' | append: shop.name
  endunless
-%}
<title>{{ ca_title | strip }}</title>

<link
  rel="canonical"
  href="{{ ca_canonical }}"
>

{%- if request.page_type == 'search' -%}
  <meta
    name="robots"
    content="noindex,follow"
  >
{%- endif -%}

{%- unless request.page_type == 'search' or request.page_type == '404' -%}
  {%- assign ca_meta_description = page_description | default: shop.description -%}
  {%- if ca_meta_description != blank -%}
    <meta
      name="description"
      content="{{ ca_meta_description | escape }}"
    >
  {%- endif -%}
{%- endunless -%}
