{%- comment -%}
  ca-first-touch.liquid — remembers how a visitor first reached the site, so the
  contact form can say where a lead came from.

  On the first page view (and again after 30 days) it stores, in this browser
  only: the referring site's host (chatgpt.com, claude.ai, google.com...), the
  landing path and the utm_source / utm_medium / utm_campaign of that visit.
  ChatGPT adds utm_source=chatgpt.com to the links it shows, so an AI visit is
  recorded even when the app sends no referrer. Nothing is sent anywhere until
  the visitor submits a form that carries the hidden fields
  (data-ca-first-touch="referrer|landing|utm"), which this fills on submit.

  Rendered once from snippets/ca-head.liquid.
{%- endcomment -%}
<script>
  (function () {
    var KEY = "ca_first_touch";
    var MAX_AGE = 30 * 24 * 60 * 60 * 1000;

    function read() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY) || "null");
        if (v && v.t && Date.now() - v.t < MAX_AGE) return v;
      } catch (e) {}
      return null;
    }

    function referrerHost() {
      try {
        if (!document.referrer) return "";
        var host = new URL(document.referrer).hostname.replace(/^www\./, "");
        return host === window.location.hostname.replace(/^www\./, "") ? "" : host;
      } catch (e) {
        return "";
      }
    }

    var touch = read();
    if (!touch) {
      var params = new URLSearchParams(window.location.search);
      var utm = ["utm_source", "utm_medium", "utm_campaign"]
        .map(function (k) { return params.get(k) ? k.replace("utm_", "") + "=" + params.get(k).slice(0, 80) : ""; })
        .filter(Boolean)
        .join("; ");
      touch = { t: Date.now(), referrer: referrerHost() || "none", landing: window.location.pathname, utm: utm || "none" };
      try { localStorage.setItem(KEY, JSON.stringify(touch)); } catch (e) {}
    }

    document.addEventListener("submit", function (e) {
      var form = e.target;
      if (!form || !form.querySelectorAll) return;
      form.querySelectorAll("[data-ca-first-touch]").forEach(function (input) {
        var field = input.getAttribute("data-ca-first-touch");
        if (touch[field]) input.value = touch[field];
      });
    }, true);
  })();
</script>
