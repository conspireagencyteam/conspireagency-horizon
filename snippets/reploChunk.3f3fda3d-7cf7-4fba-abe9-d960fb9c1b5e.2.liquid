-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/b8b0e98e-f3f8-44b6-8036-e43cffd6f47d/73021e81-16a9-4612-8ce6-3626cdf03e57?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/b8b0e98e-f3f8-44b6-8036-e43cffd6f47d/73021e81-16a9-4612-8ce6-3626cdf03e57" class="r-1a88h4z" loading="eager"/></picture><div data-rid="b6bcd796-934b-4967-8e58-2a156cd6c91b" class="r-zh2q8o alchemy-rte" style="--replo-library-bbf7dacd-140d-4e82-bae9-7b6fcb92e864-styles-266e213d-0310-416b-aeb9-992e93f86dd3-attributes-textdecoration:undefined"><span style="width:100%"><p>Foundational Look + Feel For Your Website</p></span></div><div data-rid="29569bc1-6af2-4093-a3bb-9fde3aa0fc2e" class="r-1a0plmq alchemy-rte" style="--replo-library-bbf7dacd-140d-4e82-bae9-7b6fcb92e864-styles-8b456d31-9c45-4f18-a8ee-a92afd5fd3a9-attributes-textdecoration:undefined"><span style="width:100%"><p>We kick things off with 3 initial design directions plus 1 refinement pass.</p><p><br></p><p>Given the same branding and references it's possible to arrive on very different aesthetics. This process allows us to hone in on your preferences and sets the creative tone for your new site, before we start designing full pages.</p></span></div></div></div><div data-state="inactive" data-orientation="vertical" role="tabpanel" aria-labelledby="radix-:R6b2:-trigger-efd7881c-44b7-4b29-b680-edeb9f126c331" id="radix-:R6b2:-content-efd7881c-44b7-4b29-b680-edeb9f126c331" tabindex="0" style="display:none"><div data-rid="b4120a82-e810-4bae-b8a5-468293cc1c76" class="r-1lj383n"><picture data-rid="c9d5c240-897f-4ec2-98a1-7665a5414a20" class="r-1roarjm"><source srcSet="https://assets.replocdn.com/projects/b8b0e98e-f3f8-44b6-8036-e43cffd6f47d/069deca7-c6b6-4965-8bfd-5551b1601d9e?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/b8b0e98e-f3f8-44b6-8036-e43cffd6f47d/069deca7-c6b6-4965-8bfd-5551b1601d9e?wi